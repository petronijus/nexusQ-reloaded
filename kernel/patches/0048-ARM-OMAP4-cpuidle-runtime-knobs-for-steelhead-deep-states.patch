From 0000000000000000000000000000000000000048 Mon Sep 17 00:00:00 2001
From: Petr Parkan Janda <petronijus@bastla.com>
Date: Wed, 23 Sep 2026 09:30:00 +0200
Subject: [PATCH] ARM: OMAP4: cpuidle: stock's escape hatches for steelhead's deep states

The deep C-states are a must-have on this board -- stock ran C2/C3/C4 with
both cores online by default, so the silicon does them. Getting there needs
the entry path taken apart one step at a time, on a booted box.

Stock carried escape hatches for precisely this: skip_off (0xc0740f08),
keep_mpu_on (0xc0740ef8) and keep_core_on (0xc0740f00), all in .bss and all
inert by default. Reproduce them:

  /sys/module/cpuidle44xx/parameters/skip_cpu1_wait   bypass the rendezvous
  /sys/module/cpuidle44xx/parameters/keep_mpu_on      hold mpu_pwrdm ON
  /sys/module/cpuidle44xx/parameters/keep_core_on     hold core_pwrdm ON
  /sys/module/cpuidle44xx/parameters/skip_lowpower    skip omap4_enter_lowpower

A state itself is armed through its per-CPU sysfs `disable` file, since
CPUIDLE_FLAG_OFF (patch 0024) sets the USER disable bit. The first revision
of this patch assumed FLAG_OFF set the DRIVER bit and added a `deep_idle`
knob to clear it; that knob cleared a bit nothing had set, and is gone.

The first revision's keep_mpu_on only *skipped* programming mpu_pwrdm. That
is not "MPU stays ON" here: mainline's pwrdms_setup() arms mpu_pwrdm and
core_pwrdm for RET with logic OFF at boot (live on 6.18.48-r7:
PM_MPU_PWRSTCTRL 0x003c0601, PM_CORE_PWRSTCTRL 0x03ff0f01), so with both
CPUs OFF the MPU could drop into OSWR with no GIC/wakeupgen context saved.
Stock's pwrdms_setup (0xc0012d04) left both domains ON, which is why stock's
knobs could be written as "skip" and still mean "ON". So:

 - keep_mpu_on programs mpu_pwrdm ON on every CPU0 entry and marks the
   cluster context as not lost. It previously left mpuss_can_lose_context
   set for C3, which ran cpu_cluster_pm_exit() without a matching enter.
 - keep_core_on programs core_pwrdm ON when set and restores the previous
   next-state when cleared. The idle path never touches core_pwrdm, so it
   is applied from the parameter write, in process context.

Every knob defaults to its no-op value, so an untouched boot behaves exactly
as before: C1 only, C2 and C3 registered but disabled.

Signed-off-by: Petr Parkan Janda <petronijus@bastla.com>
---
diff --git a/arch/arm/mach-omap2/cpuidle44xx.c b/arch/arm/mach-omap2/cpuidle44xx.c
index 3b72c74..998fbf7 100644
--- a/arch/arm/mach-omap2/cpuidle44xx.c
+++ b/arch/arm/mach-omap2/cpuidle44xx.c
@@ -10,6 +10,8 @@
 #include <linux/sched.h>
 #include <linux/cpuidle.h>
 #include <linux/cpu_pm.h>
+#include <linux/kstrtox.h>
+#include <linux/moduleparam.h>
 #include <linux/export.h>
 #include <linux/of.h>
 #include <linux/tick.h>
@@ -63,6 +65,75 @@ static struct idle_statedata omap5_idle_data[] = {
 	},
 };
 
+/*
+ * steelhead deep-idle experiment scaffolding.
+ *
+ * Boot-time attempts at enabling C2/C3 on this HS 4460 hung the board before
+ * the display came up, so each one only ever answered "it did not boot". Stock
+ * 3.0.8 carried escape hatches for exactly this (skip_off @0xc0740f08,
+ * keep_mpu_on @0xc0740ef8, keep_core_on @0xc0740f00 -- all .bss, all inert by
+ * default). Reproduce them, so the entry path can be taken apart step by step
+ * on a booted box.
+ *
+ * Arming a state needs no knob here: CPUIDLE_FLAG_OFF (patch 0024) sets the
+ * USER disable bit, so the per-CPU sysfs `disable` file is the switch.
+ *
+ * keep_mpu_on / keep_core_on must PROGRAM the domain ON, not merely leave it
+ * alone: mainline's pwrdms_setup() (pm44xx.c) arms mpu_pwrdm and core_pwrdm for
+ * RET with logic OFF at boot (live on r7: PM_MPU_PWRSTCTRL 0x003c0601,
+ * PM_CORE_PWRSTCTRL 0x03ff0f01), so an untouched MPU drops into OSWR the moment
+ * both CPUs are OFF -- with no GIC/wakeupgen context saved. Stock's
+ * pwrdms_setup (0xc0012d04) left both ON, which is why its knobs could be
+ * "skip programming" and still mean "stays ON".
+ *
+ * Every knob defaults to its no-op value, so an untouched boot behaves exactly
+ * as before: C1 only, C2 and C3 registered but disabled.
+ */
+static bool skip_cpu1_wait;	/* skip the wait for CPU1 to reach OFF */
+static bool keep_mpu_on;	/* hold mpu_pwrdm ON  (stock: keep_mpu_on) */
+static bool skip_lowpower;	/* do not call omap4_enter_lowpower (stock: skip_off) */
+module_param(skip_cpu1_wait, bool, 0644);
+module_param(keep_mpu_on, bool, 0644);
+module_param(skip_lowpower, bool, 0644);
+
+static struct powerdomain *core_pd;
+static bool keep_core_on;	/* hold core_pwrdm ON (stock: keep_core_on) */
+static u8 core_saved_next_pwrst;
+
+/*
+ * The idle path never programs core_pwrdm, so apply the knob right here, in
+ * process context, and restore whatever next state it replaced when cleared.
+ */
+static int keep_core_on_set(const char *val, const struct kernel_param *kp)
+{
+	bool on;
+	int rc;
+
+	rc = kstrtobool(val, &on);
+	if (rc)
+		return rc;
+	if (!core_pd)
+		return -ENODEV;
+
+	if (on && !keep_core_on) {
+		core_saved_next_pwrst = pwrdm_read_next_pwrst(core_pd);
+		rc = omap_set_pwrdm_state(core_pd, PWRDM_POWER_ON);
+	} else if (!on && keep_core_on) {
+		rc = omap_set_pwrdm_state(core_pd, core_saved_next_pwrst);
+	}
+	if (rc)
+		return rc;
+
+	keep_core_on = on;
+	return 0;
+}
+
+static const struct kernel_param_ops keep_core_on_ops = {
+	.set = keep_core_on_set,
+	.get = param_get_bool,
+};
+module_param_cb(keep_core_on, &keep_core_on_ops, &keep_core_on, 0644);
+
 static struct powerdomain *mpu_pd, *cpu_pd[MAX_CPUS];
 static struct clockdomain *cpu_clkdm[MAX_CPUS];
 
@@ -131,7 +202,8 @@ static int omap_enter_idle_coupled(struct cpuidle_device *dev,
 	 * of triggeing all the possible low power modes once CPU1 is
 	 * out of coherency and in OFF mode.
 	 */
-	if (dev->cpu == 0 && cpumask_test_cpu(1, cpu_online_mask)) {
+	if (!skip_cpu1_wait && dev->cpu == 0 &&
+	    cpumask_test_cpu(1, cpu_online_mask)) {
 		int limit = 1000001;	/* stock 3.0.8: 0x000F4241 */
 
 		while (pwrdm_read_pwrst(cpu_pd[1]) != PWRDM_POWER_OFF) {
@@ -188,7 +260,15 @@ static int omap_enter_idle_coupled(struct cpuidle_device *dev,
 	if (error)
 		goto cpu_pm_out;
 
-	if (dev->cpu == 0) {
+	if (dev->cpu == 0 && keep_mpu_on) {
+		/*
+		 * Hold the MPU ON (see the scaffolding comment): CPU OFF only. The
+		 * cluster context is not saved on this path, so it must not be
+		 * treated as lost on exit either.
+		 */
+		omap_set_pwrdm_state(mpu_pd, PWRDM_POWER_ON);
+		mpuss_can_lose_context = 0;
+	} else if (dev->cpu == 0) {
 		pwrdm_set_logic_retst(mpu_pd, cx->mpu_logic_state);
 		omap_set_pwrdm_state(mpu_pd, cx->mpu_state);
 
@@ -208,7 +288,8 @@ static int omap_enter_idle_coupled(struct cpuidle_device *dev,
 		}
 	}
 
-	omap4_enter_lowpower(dev->cpu, cx->cpu_state, true);
+	if (!skip_lowpower)
+		omap4_enter_lowpower(dev->cpu, cx->cpu_state, true);
 	cpu_done[dev->cpu] = true;
 
 	/* Wakeup CPU1 only if it is not offlined */
@@ -385,5 +466,7 @@ int __init omap4_idle_init(void)
 			idle_driver->states[i].flags |= CPUIDLE_FLAG_OFF;
 	}
 
+	core_pd = pwrdm_lookup("core_pwrdm");
+
 	return cpuidle_register(idle_driver, cpu_online_mask);
 }
