From 0000000000000000000000000000000000000060 Mon Sep 17 00:00:00 2001
From: Petr Parkan Janda <petronijus@bastla.com>
Date: Wed, 30 Sep 2026 13:12:31 +0200
Subject: [PATCH] pidfs: backport PIDFD_INFO_SUPPORTED_MASK and the coredump
 signal/code

systemd 262's coredump manager (systemd-coredumpd) needs the kernel to
report, through PIDFD_GET_INFO, the signal a process dumped core on. It
asks via PIDFD_INFO_SUPPORTED_MASK whether PIDFD_INFO_COREDUMP and
PIDFD_INFO_COREDUMP_SIGNAL are supported; both arrived in v6.19 (commit
036375522be8 "pidfs: expose coredump signal"), after 6.18. On 6.18 the
check fails, systemd-coredumpd.service is skipped by its ExecCondition,
and every transaction that pulls sysinit.target logs "Dependency failed
for Kernel Core Pattern Register" for the unit bound to it -- about fifty
times per boot on the Nexus Q.

The coredump socket itself (core_pattern "@@...", COREDUMP_SOCK_REQ) is
already in 6.18; only the pidfd_info fields are missing. This backports
them with the struct pidfd_info layout systemd 262 is built against, the
current upstream one (VER3, 88 bytes):

- PIDFD_INFO_SUPPORTED_MASK (bit 5) and supported_mask, at offset 80;
- PIDFD_INFO_COREDUMP_SIGNAL (bit 6) and coredump_signal, in what was
  __spare1;
- PIDFD_INFO_COREDUMP_CODE (bit 7) and coredump_code, with the pad that
  aligns supported_mask.

pidfs_coredump() records si_signo and si_code before it publishes the
coredump mask with a release store; pidfd_info() reads the mask with an
acquire load and returns the signal and code only when a coredump took
place, as upstream does. A caller passing a smaller struct gets only
the fields it knows about (copy_struct_to_user), so older userspace is
unaffected.
---
 fs/pidfs.c                 | 33 +++++++++++++++++++++++++++++++--
 include/uapi/linux/pidfd.h | 14 ++++++++++++--
 2 files changed, 43 insertions(+), 4 deletions(-)

diff --git a/fs/pidfs.c b/fs/pidfs.c
index 34987fc..1490459 100644
--- a/fs/pidfs.c
+++ b/fs/pidfs.c
@@ -47,6 +47,8 @@ struct pidfs_exit_info {
 	__u64 cgroupid;
 	__s32 exit_code;
 	__u32 coredump_mask;
+	__u32 coredump_signal;
+	__u32 coredump_code;
 };
 
 struct pidfs_attr {
@@ -293,6 +295,16 @@ static __u32 pidfs_coredump_mask(unsigned long mm_flags)
 	return 0;
 }
 
+/* This must be updated whenever a new flag is added */
+#define PIDFD_INFO_SUPPORTED (PIDFD_INFO_PID | \
+			      PIDFD_INFO_CREDS | \
+			      PIDFD_INFO_CGROUPID | \
+			      PIDFD_INFO_EXIT | \
+			      PIDFD_INFO_COREDUMP | \
+			      PIDFD_INFO_SUPPORTED_MASK | \
+			      PIDFD_INFO_COREDUMP_SIGNAL | \
+			      PIDFD_INFO_COREDUMP_CODE)
+
 static long pidfd_info(struct file *file, unsigned int cmd, unsigned long arg)
 {
 	struct pidfd_info __user *uinfo = (struct pidfd_info __user *)arg;
@@ -306,7 +318,7 @@ static long pidfd_info(struct file *file, unsigned int cmd, unsigned long arg)
 	const struct cred *c;
 	__u64 mask;
 
-	BUILD_BUG_ON(sizeof(struct pidfd_info) != PIDFD_INFO_SIZE_VER1);
+	BUILD_BUG_ON(sizeof(struct pidfd_info) != PIDFD_INFO_SIZE_VER3);
 
 	if (!uinfo)
 		return -EINVAL;
@@ -338,7 +350,13 @@ static long pidfd_info(struct file *file, unsigned int cmd, unsigned long arg)
 
 	if (mask & PIDFD_INFO_COREDUMP) {
 		kinfo.mask |= PIDFD_INFO_COREDUMP;
-		kinfo.coredump_mask = READ_ONCE(attr->__pei.coredump_mask);
+		/* Pairs with the release in pidfs_coredump(). */
+		kinfo.coredump_mask = smp_load_acquire(&attr->__pei.coredump_mask);
+		if (kinfo.coredump_mask & PIDFD_COREDUMPED) {
+			kinfo.mask |= PIDFD_INFO_COREDUMP_SIGNAL | PIDFD_INFO_COREDUMP_CODE;
+			kinfo.coredump_signal = attr->__pei.coredump_signal;
+			kinfo.coredump_code = attr->__pei.coredump_code;
+		}
 	}
 
 	task = get_pid_task(pid, PIDTYPE_PID);
@@ -411,6 +429,13 @@ static long pidfd_info(struct file *file, unsigned int cmd, unsigned long arg)
 		return -ESRCH;
 
 copy_out:
+	if (mask & PIDFD_INFO_SUPPORTED_MASK) {
+		kinfo.mask |= PIDFD_INFO_SUPPORTED_MASK;
+		kinfo.supported_mask = PIDFD_INFO_SUPPORTED;
+	}
+
+	/* Are there bits in the return mask not present in PIDFD_INFO_SUPPORTED? */
+	WARN_ON_ONCE(~PIDFD_INFO_SUPPORTED & kinfo.mask);
 	/*
 	 * If userspace and the kernel have the same struct size it can just
 	 * be copied. If userspace provides an older struct, only the bits that
@@ -670,6 +695,10 @@ void pidfs_coredump(const struct coredump_params *cprm)
 	coredump_mask |= PIDFD_COREDUMPED;
 	/* If coredumping is set to skip we should never end up here. */
 	VFS_WARN_ON_ONCE(coredump_mask & PIDFD_COREDUMP_SKIP);
+	/* Expose the signal number and code that caused the coredump. */
+	exit_info->coredump_signal = cprm->siginfo->si_signo;
+	exit_info->coredump_code = cprm->siginfo->si_code;
+	/* Publish them with the mask: pidfd_info() reads them after it. */
 	smp_store_release(&exit_info->coredump_mask, coredump_mask);
 }
 #endif
diff --git a/include/uapi/linux/pidfd.h b/include/uapi/linux/pidfd.h
index 6ccbabd..db3e956 100644
--- a/include/uapi/linux/pidfd.h
+++ b/include/uapi/linux/pidfd.h
@@ -26,9 +26,14 @@
 #define PIDFD_INFO_CGROUPID		(1UL << 2) /* Always returned if available, even if not requested */
 #define PIDFD_INFO_EXIT			(1UL << 3) /* Only returned if requested. */
 #define PIDFD_INFO_COREDUMP		(1UL << 4) /* Only returned if requested. */
+#define PIDFD_INFO_SUPPORTED_MASK	(1UL << 5) /* Want/got supported mask flags */
+#define PIDFD_INFO_COREDUMP_SIGNAL	(1UL << 6) /* Always returned if PIDFD_INFO_COREDUMP is requested. */
+#define PIDFD_INFO_COREDUMP_CODE	(1UL << 7) /* Always returned if PIDFD_INFO_COREDUMP is requested. */
 
 #define PIDFD_INFO_SIZE_VER0		64 /* sizeof first published struct */
 #define PIDFD_INFO_SIZE_VER1		72 /* sizeof second published struct */
+#define PIDFD_INFO_SIZE_VER2		80 /* sizeof third published struct */
+#define PIDFD_INFO_SIZE_VER3		88 /* sizeof fourth published struct */
 
 /*
  * Values for @coredump_mask in pidfd_info.
@@ -92,8 +97,13 @@ struct pidfd_info {
 	__u32 fsuid;
 	__u32 fsgid;
 	__s32 exit_code;
-	__u32 coredump_mask;
-	__u32 __spare1;
+	struct /* coredump info */ {
+		__u32 coredump_mask;
+		__u32 coredump_signal;
+		__u32 coredump_code;
+		__u32 coredump_pad; /* align supported_mask to 8 bytes */
+	};
+	__u64 supported_mask;	/* Mask flags that this kernel supports */
 };
 
 #define PIDFS_IOCTL_MAGIC 0xFF
