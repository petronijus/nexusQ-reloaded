 #include "sysconfig-am6.h"
 #elif (AM_VERSION == 5)
 #include "sysconfig-dra7.h"
+#elif (AM_VERSION == 4) && defined(SGX540) && (SGX_CORE_REV == 120)
+#include "sysconfig-omap4.h"
 #elif (AM_VERSION == 4)
 #include "sysconfig-am4.h"
 #elif (AM_VERSION == 3)
