From 9315b5ee535bbcd0d9b77f8539a1285d4b7703c8 Mon Sep 17 00:00:00 2001
From: Petr Parkan Janda <petronijus@bastla.com>
Date: Sun, 11 Oct 2026 13:45:37 +0000
Subject: [PATCH 68/73] drm: pvrsgx: 1.17: OMAP4 SGX540 sysconfig at stock
 timing

AM_VERSION=4 made OMAP4 include the AM437x header: 200 MHz core,
50 Hz hardware recovery, 2 ms active-power latency. The core clock
calibrates the microkernel timer, so at the 307.2 MHz the DT gives the
fck the 1 ms PDS tick ran at 0.65 ms. Add sysconfig-omap4.h for
SGX540 rev 1.2.0 with the values of TI's OMAP44xx KM and the stock
kernel: 307.2 MHz, 100 Hz recovery, 1000 Hz PDS timer, 100 ms APM
latency.

Build it with PVR_NO_OMAP_TIMER, as the stock kernel and TI's OMAP44xx
KM do: with the AM437x header SysInitialise() ioremapped 0x4804a03c, the
AM437x GP7 timer, on OMAP4 and exported it to userspace as the SoC
timer. DEBUG/TIMING builds that want a GP timer stop with an #error
until the OMAP4 addresses are checked.
---
 .../pvrsgx/1.17.4948957/eurasia_km/Makefile   |  7 ++
 .../services4/system/omap/sysconfig-omap4.h   | 86 +++++++++++++++++++
 .../services4/system/omap/sysconfig.h         |  2 +
 3 files changed, 95 insertions(+)
 create mode 100644 drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/services4/system/omap/sysconfig-omap4.h

diff --git a/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/Makefile b/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/Makefile
index 7bf91251e..a0a810ed7 100644
--- a/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/Makefile
+++ b/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/Makefile
@@ -57,6 +57,13 @@ ccflags-y += \
 	-I$(src)/services4/3rdparty/bufferclass_example \
 	-I$(srctree)/include/linux
 
+# OMAP4430/4460 SGX540-120: no SoC timer, like the stock kernel and TI's
+# OMAP44xx KM (PVR_NO_OMAP_TIMER := 1). Otherwise SysInitialise() maps the
+# AM437x GP7 timer address on OMAP4 and hands it to userspace.
+ifeq ($(SOC)_$(SGX)_$(SGX_REV),omap4_sgx540_120)
+ccflags-y += -DPVR_NO_OMAP_TIMER
+endif
+
 # choose SoC integration variant to choose the right source subtree
 
 ccflags-y += \
diff --git a/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/services4/system/omap/sysconfig-omap4.h b/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/services4/system/omap/sysconfig-omap4.h
new file mode 100644
index 000000000..dc1a9e6b3
--- /dev/null
+++ b/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/services4/system/omap/sysconfig-omap4.h
@@ -0,0 +1,86 @@
