+#if !defined(__SOCCONFIG_OMAP4_H__)
+#define __SOCCONFIG_OMAP4_H__
+
+/*
+ * OMAP4430/4460 with SGX540 rev 1.2.0. The AM437x header this SoC used to
+ * share declares a 200 MHz core and 50 Hz recovery; these are the values of
+ * TI's OMAP44xx KM and of the stock Android kernel for this SoC.
+ */
+
+#if defined(__linux__)
+#if !defined(PVR_LDM_DEVICE_TREE)
+#define SYS_OMAP_SGX_REGS_SYS_PHYS_BASE	0x56000000
+#define SYS_OMAP_SGX_REGS_SIZE		0x1000000
+#define SYS_OMAP_SGX_IRQ		53	/* GIC SPI 21 + 32 */
+#endif	/* !defined(PVR_LDM_DEVICE_TREE) */
+
+#define VS_PRODUCT_NAME	"OMAP4"
+
+/*
+ * The core clock calibrates the microkernel timer
+ * (ui32uKernelTimerClock = CoreClockSpeed / uKernelFreq), so it must match
+ * the rate the DT gives the GPU fck: dpll_per_m7x2_ck at 307.2 MHz.
+ */
+#define SYS_SGX_CLOCK_SPEED		307200000
+#define SYS_SGX_PDS_TIMER_FREQ		(1000)	/* 1 ms */
+#define SYS_SGX_HWRECOVERY_TIMEOUT_FREQ	(100)	/* 10 ms */
+
+#if !defined(SYS_SGX_ACTIVE_POWER_LATENCY_MS)
+#define SYS_SGX_ACTIVE_POWER_LATENCY_MS	(100)
+#endif
+
+/*
+ * The GP timer is only used by DEBUG and TIMING builds; its OMAP4 addresses
+ * have not been checked, so such a build stops here instead of using the
+ * AM437x ones.
+ */
+#if (defined(DEBUG) || defined(TIMING)) && !defined(PVR_NO_OMAP_TIMER)
+#error "SYS_OMAP_GPTIMER_* addresses are not defined for OMAP4"
+#endif
+
+#define DEVICE_SGX_INTERRUPT		(1<<0)
+
+#endif	/* defined(__linux__) */
+#endif	/* __SOCCONFIG_OMAP4_H__ */
diff --git a/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/services4/system/omap/sysconfig.h b/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/services4/system/omap/sysconfig.h
index d53046b1d..3588160b7 100644
--- a/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/services4/system/omap/sysconfig.h
+++ b/drivers/gpu/drm/pvrsgx/1.17.4948957/eurasia_km/services4/system/omap/sysconfig.h
