+/* The core clock the DDK derives its timers from; 0 = its built-in rate. */
+unsigned long pvr_sgx_timing_clock_rate(void)
+{
+	struct pvr *ddata = pvr_sgx_ddata();
+
+	return ddata ? pvr_dvfs_timing_rate(&ddata->dvfs) : 0;
