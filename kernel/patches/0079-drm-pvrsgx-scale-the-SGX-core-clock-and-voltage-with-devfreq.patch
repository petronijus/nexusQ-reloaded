 	pm_runtime_put_autosuspend(&gpsPVRLDMDev->dev);
 #if defined(SYS_OMAP_HAS_DVFS_FRAMEWORK)
@@ -705,6 +716,8 @@ IMG_VOID SysSGXIdleEntered(IMG_VOID)
