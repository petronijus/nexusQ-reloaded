 5 files changed, 410 insertions(+), 7 deletions(-)
 create mode 100644 drivers/gpu/drm/pvrsgx/pvr-dvfs.c
 create mode 100644 drivers/gpu/drm/pvrsgx/pvr-dvfs.h

