# Maintainer: Petr Parkan Janda <petronijus@bastla.com>
# Based on Alpine's main/alsa-utils (Leonardo Arena, Natanael Copa), at aports
# 3308d2766277 (2026-07-05, "main/alsa-utils: upgrade to 1.2.16").
#
# alsa-utils, rebuilt with three patches — a straight override of Alpine's package.
#
# WHY: nexusq-uac2-in (the USB audio input bridge) logs "Scheduler getparam
# failed." at every alsaloop start. alsaloop asks for real-time scheduling with
# sched_getparam()/sched_setscheduler(), which POSIX defines per process and
# musl implements as ENOSYS stubs, so the request has never worked on this image
# and the warning is noise in every boot's journal. nexusq-uac2-in gives
# alsaloop its priority itself (`chrt -f 10` under an RLIMIT_RTTIME), which is
# the one that must stay in force.
#
# The patch (0001, written to go upstream) makes the request per thread through
# pthread_getschedparam()/pthread_setschedparam(), which musl implements, and
# keeps an inherited SCHED_FIFO/SCHED_RR policy instead of raising it. That
# second half matters as much as the first: with a WORKING request and no such
# rule, alsaloop would lift itself from our FIFO 10 to Round Robin 99, above the
# IRQ threads and PulseAudio. tests/test_alsaloop_sched.py tests the patched
# function on the host.
#
# 0002 (also written to go upstream) stops alsaloop busy-polling when its
# capture stalls without stopping, which is what the UAC2 gadget does when the
# USB host stops sending: the aloop playback fd stays ready (POLLOUT, then
# POLLERR in XRUN), the pass finds nothing to copy, and poll() returns at once
# again -- one full core under nexusq-uac2-in's SCHED_FIFO until the supervisor
# parks it, "sched: RT throttling activated" in the journal (2026-11-01). After
# such a pass alsaloop now waits on the capture alone, and leaves the playback
# untouched until there is data for it.
#
# 0003 (upstreamable too) fixes the underrun recovery that runs when data comes
# back: xrun_sync() refilled the playback with less than the target latency --
# down to one period, so it underran again at once -- and leaked the frames it
# wrote from the shared buffer's capture count, until the buffer looked full,
# nothing more was read and the loop busy-polled the capture instead. That is
# the "XRUN persists while input flows" restart nexusq-uac2-in carries.
#
# tests/test_alsaloop_stall.py applies all three to the vendored upstream
# alsaloop sources (tests/fixtures/alsa-utils-$pkgver) and runs the patched
# poll loop against a capture that streams, stalls for 10 s and comes back.
#
# Everything else is Alpine's build, flag for flag and patch for patch (their
# four patches are vendored unchanged; the sums below are theirs), except the
# -openrc subpackage with its initd/confd, dropped: this image boots systemd.
#
# ⚠️ THIS IS A VERSION-PINNED OVERRIDE, like pmos/speexdsp and
# pmos/shairport-sync. apk picks the highest version across repos, so pkgrel is
# far above Alpine's (theirs: 1.2.16-r0). That only holds while pkgver matches:
# **if Alpine moves to a newer pkgver, their package wins again and the warning
# comes back.** Re-base this aport (and re-vendor Alpine's patches) on any
# upstream pkgver bump; docker-build.sh's rootfs SHIP CHECK reports which build
# actually got installed.
pkgname=alsa-utils
pkgver=1.2.16
# Alpine ships -r0. Kept far above it on purpose; see the warning above.
pkgrel=101
pkgdesc="Advanced Linux Sound Architecture (ALSA) utilities (Nexus Q build: alsaloop keeps its RT policy, sleeps on a stalled capture)"
url="https://alsa-project.org/"
arch="all"
options="!check"  # No test suite, applets use ncurses / don't have --version
license="GPL-2.0-or-later"
makedepends="
	alsa-lib-dev
	autoconf
	automake
	fftw-dev
	gettext-dev
	libtool
	ncurses-dev
	pciutils-dev
	xmlto
	"
depends="dialog alsa-ucm-conf"
subpackages="$pkgname-dbg alsaconf::noarch $pkgname-doc $pkgname-systemd $pkgname-udev"
source="https://alsa-project.org/files/pub/utils/alsa-utils-$pkgver.tar.bz2
	alsaconf.patch
	musl-locale.patch
	musl-types.patch

	329.patch
	0001-alsaloop-set-the-scheduler-per-thread-keep-an-inherited-RT-policy.patch
	0002-alsaloop-do-not-busy-poll-playback-while-capture-is-stalled.patch
	0003-alsaloop-refill-an-underrun-playback-to-the-target-latency.patch
	"

prepare() {
	default_prepare
	autoreconf -vfi
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--disable-nls \
		--with-alsactl-lock-dir=/run/lock \
		--with-udev-rules-dir=/usr/lib/udev/rules.d \
		--with-systemdsystemunitdir=/usr/lib/systemd/system
	make

	# Gate: alsaloop must set the scheduler through the pthread API. The patch
	# failing to apply already stops default_prepare; this catches a re-base
	# that applies but leaves the process-wide calls in place. Only code lines:
	# the patch's own comment names the calls it replaces.
	if grep -nE '^[[:space:]]*[^[:space:]*/].*\bsched_(getparam|setscheduler)\(' alsaloop/alsaloop.c; then
		echo "alsa-utils: alsaloop still uses the process-wide scheduler calls" >&2
		return 1
	fi
	grep -q 'pthread_getschedparam(pthread_self()' alsaloop/alsaloop.c || {
		echo "alsa-utils: alsaloop does not read its thread's scheduling policy" >&2
		return 1
	}
	# Gate: the poll timeout of 0002 must reach poll(), or a stalled capture
	# sleeps forever instead of being re-read.
	grep -q 'pcmjob_poll_timeout(thread->loopbacks\[i\])' alsaloop/alsaloop.c || {
		echo "alsa-utils: alsaloop's poll() does not take the stalled-capture timeout" >&2
		return 1
	}
}

package() {
	make DESTDIR="$pkgdir" install
}

alsaconf() {
	depends="$pkgname=$pkgver-r$pkgrel bash"

	amove usr/sbin/alsaconf
}

