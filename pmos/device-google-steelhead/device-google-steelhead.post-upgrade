#!/bin/sh
# Two jobs, independent of each other:
#   1. (r110) keep systemd-oomd disabled on boxes already in the field;
#   2. restore the access files .pre-upgrade stashed, if the new package did not
#      ship them. See device-google-steelhead.pre-upgrade for why that pair exists.
#
# Runs AFTER apk has unpacked the new version and removed the files that left the
# package's file list — which, from r91 on, is exactly these three.
#
# Deliberately conservative:
#   * only restores a file that is now MISSING or EMPTY. A newer package that
#     legitimately ships one wins; we never clobber what apk just installed.
#   * keeps the stash on any failure, so a half-finished migration can be
#     retried by hand instead of having silently eaten the only copy.
set -e

# --- r110: systemd-oomd off on boxes already in the field -------------------
# A fresh image never enables it (.post-install + 20-nexusq-oomd-off.preset);
# a box that took an earlier image has it enabled AND running, and neither the
# preset (read only by a preset pass) nor .post-install (never run on upgrade)
# reaches it. On a live system `daemon-reload` first, so PID 1 sees the /etc
# drop-ins that switch off systemd's ManagedOOM defaults (they are what pulled
# oomd back in through every user session — see the APKBUILD), then
# `disable --now` removes the three enable links and stops it; outside a booted
# systemd (a chroot, an image build) the same links are removed by hand, which
# is what disable does.
# Idempotent, so it simply re-asserts the state on every later upgrade. Never
# fatal: an upgrade must not fail over an optional daemon.
if [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null 2>&1 || true
	systemctl disable --now systemd-oomd.service systemd-oomd.socket \
		>/dev/null 2>&1 || echo "nexusq: could not disable systemd-oomd" >&2
else
	rm -f /etc/systemd/system/multi-user.target.wants/systemd-oomd.service \
	      /etc/systemd/system/sockets.target.wants/systemd-oomd.socket \
	      /etc/systemd/system/dbus-org.freedesktop.oom1.service
fi

# --- r113+: the first-boot unit's enable link is now the package's ---------
# Units in the field got sysinit.target.wants/nexusq-resize-rootfs.service from
# the apk trigger's preset (an absolute link), before the package shipped its
# own (relative). apk will not overwrite a config file that differs, so it left
# the package's as `.apk-new` -- which systemd then reads as a Wants= drop-in
# with an invalid name and complains about on every boot (seen on the cottage Q,
# r114). Both links name the same unit; take the package's.
_w=/etc/systemd/system/sysinit.target.wants/nexusq-resize-rootfs.service
if [ -L "$_w.apk-new" ]; then
	mv -f "$_w.apk-new" "$_w"
fi

STASH=/var/lib/nexusq/access-migration
[ -d "$STASH" ] || exit 0

restored=0
failed=0

for f in /root/.ssh/authorized_keys \
         /etc/skel/.ssh/authorized_keys \
         /etc/NetworkManager/system-connections/wifi.nmconnection; do
	src="$STASH$f"
	[ -s "$src" ] || continue
	[ -s "$f" ] && continue          # the package brought its own — leave it
	dir=$(dirname "$f")
	# .ssh must be 0700 or sshd ignores it; system-connections is 0755 root.
	case "$dir" in
		*/.ssh) mkdir -p "$dir" && chmod 700 "$dir" ;;
		*)      mkdir -p "$dir" ;;
	esac
	if cp -p "$src" "$f"; then
		# cp -p preserves the mode, but be explicit: NetworkManager silently
		# IGNORES a profile that is not 0600, and a silently ignored profile
		# is a box that boots with no WiFi and no clue why.
		chmod 600 "$f"
		chown root:root "$f" 2>/dev/null || true
		restored=$((restored + 1))
	else
		echo "nexusq: ERROR could not restore $f from $src" >&2
		failed=$((failed + 1))
	fi
done

if [ "$failed" -eq 0 ]; then
	rm -rf "$STASH"
	rmdir /var/lib/nexusq 2>/dev/null || true
	[ "$restored" -gt 0 ] && echo "nexusq: restored $restored baked access file(s);" \
		"they are now unowned by apk and no longer shipped in any package" >&2
else
	echo "nexusq: $failed file(s) NOT restored — stash kept at $STASH," \
	     "restore by hand before rebooting" >&2
fi

exit 0
