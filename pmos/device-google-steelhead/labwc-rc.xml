<?xml version="1.0"?>
<!--
  labwc config for the Nexus Q (steelhead) LXQt-Wayland session.

  The front-panel volume ring is now handled by NEXUSQD directly: it reads the
  "steelhead-avr-keys" evdev node and both shows the LED volume overlay AND
  applies the real PulseAudio volume via /usr/bin/nq-vol. nexusqd is always
  running, so the ring works with the desktop OFF (the normal appliance state,
  now that the default target is multi-user — see the default.target symlink in
  the APKBUILD; the desktop is on-demand via the app's setDesktop).

  The audio keybinds that used to live here are therefore GONE: with nexusqd
  applying the volume, a labwc keybind would DOUBLE every step whenever the
  on-demand desktop happens to be up. <default /> keeps labwc's built-in window
  keybindings.
-->
<labwc_config>
  <keyboard>
    <default />
  </keyboard>
</labwc_config>
