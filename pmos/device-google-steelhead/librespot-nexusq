#!/bin/sh
# librespot as a PulseAudio INPUT (Spotify Connect) for the Nexus Q.
#
# Runs as the `user` (uid 10000) systemd USER unit so it shares that session's
# PulseAudio: --backend alsa --device pulse -> the ALSA `pulse` plugin -> PA.
# This makes Spotify just one INPUT into the PA hub; the OUTPUT (TAS5713 / SPDIF
# / HDMI) is selected via PA's default sink (companion app). No `type multi`
# fan-out — a single, movable PA sink-input. (The multi-input design also lets
# Tidal / Bluetooth-A2DP / casting join later as further PA clients.)
#
# librespot 0.8.0 here is built with ONLY the libmdns zeroconf backend
# (`--zeroconf-backend avahi` errors: "Valid values: libmdns"). libmdns
# advertises on EVERY interface, so it announced the usb0 gadget IP
# (172.16.42.1) — unreachable from a WiFi phone. Pin libmdns to the live wlan0
# IPv4 with --zeroconf-interface, resolved at start (DHCP, not hardcoded); wait
# for wlan0 to get an address first. (avahi is additionally constrained to
# wlan0 via allow-interfaces= in the post-install.)
set -e

# Wait for wlan0's IPv4 (DHCP completes only after association). The ceiling is
# generous on purpose: BCM4330 cold-boot association routinely takes longer than
# 30 s, and the old 30 s wait made the first start give up -> systemd Restart ->
# a boot-time restart storm (5x "wlan0 has no IPv4" on v1.9.0-rc4). A longer wait
# catches the association on the FIRST process, so there is nothing to restart.
# The user unit's After=network-online.target does not help here: at the USER
# manager level that target is not wired to real connectivity, so this poll IS
# the gate. exit 1 stays for a genuinely dead radio.
# shellcheck disable=SC2034  # i only counts the polls
for i in $(seq 1 180); do
	WIP=$(ip -4 -o addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
	[ -n "$WIP" ] && break
	sleep 1
done
[ -n "$WIP" ] || { echo "librespot-nexusq: wlan0 has no IPv4 after 180s" >&2; exit 1; }

# Device name: read from the same identity file the nexusq-control bridge uses
# (/etc/nexusq/device.json, written by nexusq-setupd's setName), so Spotify
# Connect shows whatever name the user set. Falls back to "Nexus Q" when the
# file is absent/corrupt/unset (fresh install, before first setup) — never let
# a missing identity file block librespot from starting.
NQ_NAME="$(python3 - <<'EOF' 2>/dev/null || echo "Nexus Q"
import json
print(json.load(open("/etc/nexusq/device.json"))["name"])
EOF
)"
[ -n "$NQ_NAME" ] || NQ_NAME="Nexus Q"

# Audio-file cache cap (2026-09-26). Without one the cache only ever grew: 2.0 GB
# on the cottage Q, written to the eMMC as it played. The cap is 5 GiB — but never
# more than the rootfs slot can spare: since every unit has two ~6.6 GB slots
# (device r112), 5 GiB of cache next to a ~2.5 GB system would fill a slot, so the
# cap shrinks to leave CACHE_RESERVE_MIB free for upgrades and kernel OTA
# staging. Recomputed at every start from what is free NOW (plus what the cache
# already holds, since it may keep that); librespot evicts the oldest files down
# to the cap when it starts.
CACHE_DIR="${CACHE_DIRECTORY:-/var/cache/librespot}"
CACHE_MAX_MIB=5120
CACHE_RESERVE_MIB=1536
CACHE_MIN_MIB=128

# TESTABLE:cache_limit_mib
# cache_limit_mib <free KiB on the cache fs> <KiB the cache holds now>: prints
# the cap in MiB — CACHE_MAX_MIB, or less so that CACHE_RESERVE_MIB stays free,
# but never below CACHE_MIN_MIB (a cache that cannot hold one track is useless).
cache_limit_mib() {
	_room=$(( ($1 + $2) / 1024 - ${CACHE_RESERVE_MIB:-1536} ))
	_cap=${CACHE_MAX_MIB:-5120}
	[ "$_room" -lt "$_cap" ] && _cap=$_room
	[ "$_cap" -lt "${CACHE_MIN_MIB:-128}" ] && _cap=${CACHE_MIN_MIB:-128}
	echo "$_cap"
}

mkdir -p "$CACHE_DIR" 2>/dev/null || true
_free_kib=$(df -Pk "$CACHE_DIR" 2>/dev/null | awk 'NR==2 {print $4}')
_used_kib=$(du -sk "$CACHE_DIR" 2>/dev/null | cut -f1)
CACHE_LIMIT="$(cache_limit_mib "${_free_kib:-0}" "${_used_kib:-0}")M"
echo "librespot-nexusq: audio cache cap $CACHE_LIMIT (free ${_free_kib:-?} KiB, cache ${_used_kib:-?} KiB)" >&2

# One volume (2026-09-27, docs/2026-09-27-one-volume.md): librespot drives the
# PulseAudio default sink through the nexusq_vol ALSA control instead of
# attenuating samples itself before PulseAudio. So the Spotify slider, the app,
# the dome knob and Home Assistant all move the same volume, and Spotify at N %
# is the app's N % (--volume-ctrl cubic over the control's dB scale, which is
# PulseAudio's own; the range comes from the control).
#
# --initial-volume is the sink's CURRENT volume, and it has to be given: without
# it librespot 0.8.0 sets the mixer to 50 % at every start (its help says "the
# current volume", its code uses the 50 % default). A boot, or the restart the
# diagnostics mode does, would move the Q's volume. PulseAudio must answer
# first -- for that read, and for the control, which librespot opens at start.
. /usr/lib/nexusq/nq-pulse.sh
wait_for_pulse || { echo "librespot-nexusq: PulseAudio is not answering after 30 s" >&2; exit 1; }
# An unreadable volume is a failed start, never a guess: any number given here
# is SET, and a guess of 100 would be the loudest mistake available. Above
# 100 % (PulseAudio allows it) is capped; the control stops at 0 dB.
VOL="$(pulse_volume_percent)" || { echo "librespot-nexusq: cannot read the sink volume" >&2; exit 1; }
[ "$VOL" -le 100 ] || VOL=100
echo "librespot-nexusq: mixer nexusq_vol, starting at the sink's ${VOL}%" >&2

# Diagnostics mode (switched on from the app, off again by itself; PROTOCOL §16):
# debug logging for every librespot crate -- enough to see a Connect session's
# dealer websocket and re-authentication, which is what the mode was built for.
# NEXUSQ_DIAG=1 goes into librespot's environment so nexusq-control can tell
# which mode this process runs in. RUST_LOG replaces librespot's own default
# filter ("libmdns=info,librespot=info"), so libmdns is named again.
if nq-diag active 2>/dev/null; then
	export NEXUSQ_DIAG=1 RUST_LOG="libmdns=info,librespot=debug"
	echo "librespot-nexusq: diagnostics mode -- debug logging ($(nq-diag status))" >&2
fi

# --ap-port 443: VLAN20 blocks Spotify's default access-point port 4070; without
#   this, discovery succeeds but playback stalls right after the credential handoff.
# --zeroconf-port 37879: matches the 60_spotify.nft firewall drop-in.
# --disable-credential-cache: stay in discovery mode (device always advertises for
#   Spotify Connect) rather than auto-logging into one cached account.
# --cache $CACHE_DIRECTORY: audio-file cache in the user-owned systemd CacheDirectory
#   (falls back to /var/cache/librespot when run by hand outside systemd), capped
#   by --cache-size-limit as computed above.
# --onevent nexusq-onevent: now-playing + volume hook for the companion bridge.
exec /usr/bin/librespot \
	--name "$NQ_NAME" \
	--backend alsa --device pulse \
	--bitrate 320 --format S16 \
	--mixer alsa --alsa-mixer-device nexusq_vol --alsa-mixer-control Master \
	--volume-ctrl cubic --initial-volume "$VOL" \
	--ap-port 443 \
	--zeroconf-port 37879 --zeroconf-interface "$WIP" \
	--cache "$CACHE_DIR" --cache-size-limit "$CACHE_LIMIT" --disable-credential-cache \
	--onevent /usr/bin/nexusq-onevent
