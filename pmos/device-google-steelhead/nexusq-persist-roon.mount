# Nexus Q persist store: RoonBridge's identity and zone settings (r108).
# Bind-mounted from the store over its rootfs path, so there is ONE copy and
# nothing to synchronise; a flash rewrites the rootfs underneath and this mount
# puts the unit's own state back on top. Skipped (ConditionPathIsMountPoint)
# when the store did not mount -- the rootfs copy is then in use, as before r108.
# Installed as opt-glibc\x2drt-home-roon-.RoonBridge.mount (systemd-escape -p).
# The Roon sandbox (bwrap --bind /opt/glibc-rt /) binds recursively, so this
# mount is what RoonBridge sees as $HOME/.RoonBridge inside it.
[Unit]
Description=Nexus Q persist: RoonBridge identity and zone settings
DefaultDependencies=no
Requires=nexusq-persist-apply.service
After=nexusq-persist-apply.service
Before=local-fs.target umount.target
Conflicts=umount.target
ConditionPathIsMountPoint=/var/lib/nexusq/persist

[Mount]
What=/var/lib/nexusq/persist/roon
Where=/opt/glibc-rt/home/roon/.RoonBridge
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
