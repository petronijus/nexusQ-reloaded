#!/bin/sh
# nexusq-uac2-in — the "USB Audio" input service body. Brings the UAC2 gadget
# capture back into PulseAudio through a STABLE-CLOCK snd-aloop hop (the same
# pattern Roon uses), so USB audio mixes with Spotify/AirPlay/Roon, shares the one
# unified PA volume, follows output switching, and drives the LED visualizer:
#
#   host plays over USB -> UAC2Gadget capture (async, pcm0c)
#     -> alsaloop --sync=simple   (async -> stable, bounded buffers)
#     -> hw:Loopback,0,0          (snd-aloop playback side; timer-clocked)
#     -> PA module-alsa-source usb_in   (device=hw:Loopback,1,0)
#     -> PA module-loopback -> default sink (TAS5713, mixes with everything)
#
# WHY the aloop hop (do NOT "simplify" it away): PA's module-alsa-source must not
# read the async UAC2 gadget directly — that endpoint misreports its latency as an
# ever-growing value (~uptime), which drove module-loopback's resampler to the +1%
# rail and the delay ran away to MINUTES (the r65 removal; docs 2026-08-08).
# snd-aloop is virtual and timer-clocked, so PA reads a well-behaved PCM with sane
# latency; alsaloop --sync=simple absorbs the async->stable conversion with bounded
# buffers up front (proven on the r68 direct path). Result: no runaway, low CPU,
# and — unlike the exclusive r68 direct-to-amp bridge — the PA sink is NEVER
# suspended, so mixing + the unified volume + the LED visualizer all keep working.
#
# The aloop card (Loopback, index 0) is PULSE_IGNORE'd so PA won't auto-grab it; we
# load the source on it EXPLICITLY, exactly like Roon does on RoonLoop. Its old
# asound.conf tee is retired (see asound.conf) so the substream is ours.
#
# LONG-RUNNING (not oneshot): on SIGTERM (systemctl stop / the app's disable --now)
# the trap unloads the two PA modules and kills alsaloop. Toggled from the app as
# the "usbaudio" service; OFF by default. The UAC2 gadget capture card is owned by
# nexusq-usb-gadget.service and is always present.
set -u

CARD="${NQ_UAC2_CARD:-UAC2Gadget}"       # gadget capture card (async endpoint)
ASOUND="${NQ_UAC2_ASOUND:-/proc/asound}" # where the PCM status files are (tests point it elsewhere)
ALOOP="${NQ_UAC2_ALOOP:-Loopback}"       # snd-aloop card (spare, PULSE_IGNORE'd)
SUB="${NQ_UAC2_ALOOP_SUB:-0}"            # aloop substream pair to use
SRC="${NQ_UAC2_SOURCE:-usb_in}"          # PA source name
TLAT="${NQ_UAC2_TLATENCY:-80000}"        # alsaloop -t target loop latency (us)
LOOPLAT="${NQ_UAC2_LOOPLAT:-120}"        # module-loopback latency_msec (lip-sync cushion)
LOOPMAX="${NQ_UAC2_LOOPMAX:-200}"        # module-loopback max_latency_msec (the ceiling)
# alsaloop sync mode, TUNABLE because the right answer is not yet measured.
#
# `simple` copies samples and corrects nothing, so the USB host's clock and the
# aloop's timer drift apart until the loop runs dry -- an XRUN `simple` cannot
# recover from (see the wedge handling below). They are NOT, as this comment used
# to claim, what grows module-loopback's cushion: on 2026-09-12 every latency step
# in a session was watched against the aloop playback trigger_time and none of
# them coincided with an alsaloop restart. The climb is PulseAudio's own
# alsa-source waking up late (see fixed_latency_range and $RT below). The drift
# still costs a glitch every few minutes, which is what the A/B is for.
#
# Two candidate corrections exist on this hardware, both without pulling in
# libsamplerate (the objection to `samplerate`):
#   captshift  - the UAC2 gadget exposes `Capture Pitch 1000000`, i.e. the USB
#                async feedback channel: ask the HOST to adjust.
#   playshift  - snd-aloop exposes `PCM Rate Shift 100000` (80000..120000) per
#                subdevice: adjust the virtual card we own instead.
#
# Neither is the default yet, because neither has been SEEN working. Probed on
# 2026-09-06: alsaloop prints "Opened PCM element Capture Pitch ..." under every
# mode including `simple`, so the banner proves nothing, and an aloop->aloop rig
# left `PCM Rate Shift` at 100000 throughout -- correctly, since both ends of
# that rig share one timer and there was no drift to correct. Deciding between
# them needs the real pair (async gadget -> timer-clocked loop) with audio
# actually flowing, i.e. the USB host playing. Until that A/B is run, ship what
# was already proven in the field.
#
# To run the A/B:  systemctl --user set-environment NQ_UAC2_SYNC=captshift
#                  systemctl --user restart nexusq-uac2-in
#                  then watch `amixer -c UAC2Gadget cget numid=1` (captshift) or
#                  `amixer -c Loopback cget numid=1` (playshift) move off its
#                  centre while the host streams, and whether the loopback's
#                  Buffer Latency stops climbing across a long session.
SYNC="${NQ_UAC2_SYNC:-simple}"

# Real-time scheduling for alsaloop -- through util-linux `chrt`, not alsaloop's
# own request. alsaloop asks for SCHED_RR itself at start-up, and on this image
# that request has ALWAYS failed: "Scheduler getparam failed." in every start is
# musl's sched_getparam()/sched_setscheduler(), which are deliberate ENOSYS
# stubs, so the bridge has run as an ordinary task since day one. chrt goes
# through sched_setattr(2) directly and works (verified 2026-09-12 inside
# user@10000, whose LimitRTPRIO=50 drop-in already exists for Roon's RAAT).
#
# The RLIMIT_RTTIME in front of it is a backstop, and a narrower one than this
# comment used to claim. With soft == hard, as here and as PulseAudio sets its
# own (rlimit-rttime, 200000:200000 on the unit), the kernel sends SIGKILL at
# the limit -- no SIGXCPU first (kernel/time/posix-cpu-timers.c checks the hard
# limit before the soft one) -- and the supervisor below sees an exit like any
# other. But the count is of RT CPU *since the task last slept*: every wakeup
# resets it (kernel/sched/rt.c, ENQUEUE_WAKEUP). It kills a loop that never
# blocks, not one that sleeps for a moment between passes -- and alsaloop's
# stalled-capture spin does exactly that, by its source (a 10 us nanosleep every
# 21st pass once avail_min is at its cap), so
# on 2026-11-01 it burned 14.7 s of CPU in one minute under this limit and only
# the RT throttle ("sched: RT throttling activated") and the park logic below
# stopped it. The spin itself is fixed in alsaloop (pmos/alsa-utils 0002/0003);
# keep the limit for a loop that does not sleep at all. Never wrap without it.
#
# The probe runs the wrapper once against `true`: on a system where RT is not
# permitted (no rlimit, no util-linux) it logs and falls back to a plain launch
# rather than making every alsaloop start fail.
RTPRIO="${NQ_UAC2_RTPRIO:-10}"           # SCHED_FIFO priority; RAAT's own threads sit higher
RTTIME="${NQ_UAC2_RTTIME_US:-200000}"    # RLIMIT_RTTIME soft=hard (us of RT CPU without sleeping, then SIGKILL)
RT="prlimit --rttime=$RTTIME:$RTTIME chrt -f $RTPRIO"
if ! $RT true 2>/dev/null; then
	echo "nexusq-uac2-in: WARNING real-time scheduling unavailable ($RT true failed)" \
	     "-- alsaloop runs as an ordinary task; expect PA source latency steps" >&2
	RT=""
fi

pa() { pactl "$@" 2>/dev/null; }         # returns pactl stdout (module index on load)

ALPID=""; MOD_SRC=""; MOD_LB=""; SILPID=""; MOD_CLI=""; MONPID=""

# The Capture Rate monitor is a subshell running `alsactl monitor | while read`;
# both halves are its children, so they go first (busybox pkill -P, present on
# the image -- checked on the Prague unit 2026-11-01). Defined up here because
# the stop trap can fire during the start-up waits.
stop_monitor() {
	[ -n "$MONPID" ] || return 0
	pkill -P "$MONPID" 2>/dev/null
	kill "$MONPID" 2>/dev/null
	wait "$MONPID" 2>/dev/null
	MONPID=""
}

# On stop: tear the PA hop down cleanly (loopback first, then its source) and stop
# alsaloop. No suspend-sink to undo — we never suspended. KillMode=mixed keeps
# these pactl children alive past the shell's SIGTERM.
stop_all() {
	# The silence watcher goes FIRST: on SIGTERM it resumes the source it may
	# have suspended, and it must get that chance while the source still exists.
	if [ -n "$SILPID" ]; then
		kill "$SILPID" 2>/dev/null
		i=0
		while [ "$i" -lt 20 ] && kill -0 "$SILPID" 2>/dev/null; do
			i=$((i + 1)); sleep 0.1
		done
	fi
	[ -n "$MOD_LB" ]  && pa unload-module "$MOD_LB"  >/dev/null 2>&1
	[ -n "$MOD_SRC" ] && pa unload-module "$MOD_SRC" >/dev/null 2>&1
	[ -n "$MOD_CLI" ] && pa unload-module "$MOD_CLI" >/dev/null 2>&1
	[ -n "$ALPID" ]   && kill "$ALPID" 2>/dev/null
	stop_monitor
	exit 0
}
trap stop_all TERM INT
# The Capture Rate monitor (below) reports a change of the host's stream with
# SIGUSR1; the main loop acts on the flag. Set before anything can send it --
# USR1's default action would end the service.
RATE_EVENT=0
trap 'RATE_EVENT=1' USR1

# The gadget capture card appears a few seconds into boot; wait briefly for it.
i=0
while [ "$i" -lt 20 ]; do
	grep -q "$CARD" "$ASOUND/cards" 2>/dev/null && break
	i=$((i + 1)); sleep 1
done
if ! grep -q "$CARD" "$ASOUND/cards" 2>/dev/null; then
	echo "nexusq-uac2-in: UAC2 gadget card '$CARD' not present" >&2
	exit 1
fi

# PA is Wants=/After=pulseaudio.service but may still be coming up; wait for it so
# the load-module calls below actually land.
i=0
while [ "$i" -lt 20 ]; do
	pa info >/dev/null 2>&1 && break
	i=$((i + 1)); sleep 1
done

# Defensive: drop any stale usb_in source + its loopback left by a crash, so we
# never stack a second hop on the same substream.
for m in $(pa list short modules | grep -e "source_name=$SRC" -e "source=$SRC" | cut -f1); do
	pa unload-module "$m" >/dev/null 2>&1
done

# Start the async->stable bridge: UAC2 gadget capture -> snd-aloop playback side.
start_alsaloop() {
	$RT alsaloop -C "hw:$CARD" -P "hw:$ALOOP,0,$SUB" -r 48000 -c 2 -f S16_LE \
		--sync="$SYNC" -t "$TLAT" &
	ALPID=$!
}
start_alsaloop
sleep 1   # let alsaloop open the playback side before PA opens the capture side

# PA reads the stable capture side and loops it into the default sink (mixes with
# everything, follows output switching). Load the source FIRST so it pins the pair
# at s16le/48k, then the loopback.
#
# fixed_latency_range=yes is what stops the lip-sync delay from growing INSIDE a
# session, and it is the half r95's ceiling could not reach. PulseAudio's
# timer-scheduled alsa-source raises its own minimum latency by 10 ms every time
# its thread wakes up later than the buffer allowed (increase_watermark ->
# "Source minimum latency increased to N ms" from module-loopback), and PA's own
# source says the reverse "never happens". module-loopback then recomputes its
# target as (min_sink + min_source) * 1.1 + 1.5 ms, which walks straight past
# `latency_msec` and is NOT what `max_latency_msec` bounds (that caps only the
# loopback's own underrun counter -- read module-loopback.c, both paths). Seen
# live 2026-09-12: 16 -> 26 -> 36 -> 46 -> 56 -> 66 ms in 30 minutes of one
# session, target 120 -> ~184 ms, no alsaloop restart at any step; the same
# staircase is in the journal from 09-02/03 (120 -> 145). With the range fixed,
# PA still adapts its wake-up watermark internally (it wakes earlier after a
# miss), it just no longer reports a bigger minimum -- a late wake-up costs a
# dropout instead of a permanent 10 ms. Regression test:
# tests/test_loopback_latency_bounded.sh
#
# And the thread that reads it must be REAL-TIME, which PulseAudio cannot arrange
# for itself on this image (see nq-pa-rt). With the range fixed but the thread
# still an ordinary task, every late wake-up became a dropout instead of a
# latency step: ~12 "Overrun!" a minute, measured 2026-09-12 before nq-pa-rt was
# applied, 0 the minute after. The two lines below are one fix, not two.
PA_RTPRIO="${NQ_PA_RTPRIO:-5}"           # SCHED_RR for PA's alsa-source thread (PA's own default)
start_source() {
	MOD_SRC=$(pa load-module module-alsa-source device="hw:$ALOOP,1,$SUB" \
		source_name="$SRC" source_properties=device.description=USBAudio \
		rate=48000 channels=2 format=s16le fixed_latency_range=yes)
	nq-pa-rt alsa-source-Loo "$PA_RTPRIO" || true
}
# source_dont_move=true PINS the capture side to `$SRC`. Without it PulseAudio
# silently re-points this loopback at a DIFFERENT source and USB audio goes
# nowhere while every check above still passes. Diagnosed 2026-09-01 from a live
# failure: `roon-nexusq` loads its own module-alsa-source (`roon_in`), and
# `module-switch-on-connect` — loaded by PA's stock config — makes each newly
# appeared source the default AND MOVES existing source-outputs onto it. So
# starting Roon dragged this loopback off `usb_in` onto `roon_in`; the amp then
# played Roon's (silent) loop while the USB host streamed into a source nobody
# read. It is mirror-symmetric: without the same flag on Roon's loopback, USB
# audio starting would steal Roon the same way.
#
# ensure_modules() below CANNOT catch this: the module stays loaded, only its
# binding changes, so `mod_alive` is true and nothing is logged — which is why
# this went unnoticed for a whole listening session. Pinning is also strictly
# cheaper than detecting it, since noticing a move would cost a second `pactl`
# fork per tick (~70 ms of CPU each on this SoC — see the power note below).
#
# Only the SOURCE is pinned. The sink-input stays movable on purpose: the whole
# point of looping into the default sink is that USB audio follows the output
# the app selects. Regression test: tests/test_loopback_source_pinned.sh
start_loopback() {
	MOD_LB=$(pa load-module module-loopback source="$SRC" \
		source_dont_move=true latency_msec="$LOOPLAT" \
		max_latency_msec="$LOOPMAX")
	fix_loopback_volume
}

# module-loopback raises its own buffer whenever it underruns and NEVER lowers it
# again. Over a service uptime measured in days that only accumulates: on
# 2026-09-06 the Prague Q sat at 243 ms against a configured 120 (Roon: 347
# against 250) after 5 days up with zero restarts, heard as a constant lip-sync
# offset with nothing in the log for the last 200 ms of it. `max_latency_msec`
# above is the ceiling; this is the other half -- a cushion earned by an old
# listening session is of no use to a new one, so unparking rebuilds the hop at
# $LOOPLAT. Free to do here: the host is not streaming yet.
reset_loopback() {
	[ -n "$MOD_LB" ] && pa unload-module "$MOD_LB" >/dev/null 2>&1
	MOD_LB=""
	start_loopback
}
# module-loopback's sink-input can come up MUTED / attenuated: module-stream-restore
# restores a saved volume/mute for the "Loopback from USBAudio" stream, and a stale
# 0%/muted entry makes USB audio silent while everything else (amp, source) looks
# fine. Force the stream to unity, unmuted — USB audio is a full-level passthrough;
# loudness belongs to the sink (ring) + the source, not this internal hop. Retry a
# few ticks because the sink-input appears just after the module loads. Runs after
# EVERY loopback load, including a re-load by the supervisor below.
fix_loopback_volume() {
	[ -n "$MOD_LB" ] || return 0
	j=0
	while [ "$j" -lt 10 ]; do
		si=$(pactl list sink-inputs 2>/dev/null | awk -v m="$MOD_LB" '
			/^Sink Input #/{id=substr($3,2)}
			/Owner Module:/{if ($3==m) {print id; exit}}')
		[ -n "$si" ] && break
		j=$((j + 1)); sleep 1
	done
	if [ -n "$si" ]; then
		pa set-sink-input-mute "$si" 0
		pa set-sink-input-volume "$si" 100%
	fi
}

# Is a module index still loaded, according to a module list captured by the
# caller? Takes the list as $2 so ONE `pactl` covers both checks — see
# ensure_modules for why that matters.
mod_alive() {
	[ -n "$1" ] || return 1
	printf '%s\n' "$2" | cut -f1 | grep -qx "$1"
}

# Our two PA modules can vanish underneath us WITHOUT this service being touched.
# Measured 2026-08-27: unloading ANY other module-alsa-source — turning Roon off
# does exactly that — takes our module-loopback with it, reproducibly, and then
# USB audio is silent while the unit still reads `active`, alsaloop still runs and
# the source module is still there. Nothing logs it. So the service supervises the
# modules it owns, exactly as it supervises alsaloop and the watcher; the source
# goes first because the loopback is meaningless without it.
# ⚠️ COSTS REAL POWER — do not make this check more eager. Forking `pactl` costs
# ~70 ms of CPU on this SoC (measured independently twice: once profiling the
# silence watcher's wake path, once here). The first version of this ran TWO
# `pactl` calls every 3 s, which is 0.67 forks/s and measured **+4.6 % of a core
# at idle** — the service's cgroup went from ~1.3 % to 5.98 %, the governor
# bounced 350<->700 at 0.43/s, and a whole overnight window came out at 1.29x the
# 350 MHz floor instead of 1.04x. Per-process sampling did not show it, because
# the forks are shorter than the sample interval; only the cgroup total did.
#
# So: ONE `pactl` for both checks, and only every MOD_CHECK_TICKS-th pass. At
# 5 ticks x 3 s that is one fork per 15 s (~0.23 % of a core) and bounds the
# window in which USB audio could be silent after another source's alsa-source is
# unloaded — which was previously permanent, so 15 s is a fine trade.
MOD_CHECK_TICKS=${NQ_UAC2_MOD_CHECK_TICKS:-5}
mod_tick=0
ensure_modules() {
	mod_tick=$((mod_tick + 1))
	[ "$mod_tick" -ge "$MOD_CHECK_TICKS" ] || return 0
	mod_tick=0
	_mods=$(pa list short modules 2>/dev/null)
	[ -n "$_mods" ] || return 0        # PA down/restarting: nothing to conclude
	if ! mod_alive "$MOD_SRC" "$_mods"; then
		echo "nexusq-uac2-in: PA source module vanished, reloading" >&2
		start_source
		MOD_LB=""            # a loopback pointing at the old source is useless
	elif ! mod_alive "$MOD_LB" "$_mods"; then
		echo "nexusq-uac2-in: PA loopback module vanished, reloading" >&2
		start_loopback
	fi
}

start_source
start_loopback


# Idle power: with nothing playing, the host still streams and PulseAudio still
# resamples, which measured 28.83 % of one core (PA alone 27.17 %) and kept the amp
# powered. nq-uac2-silence watches for digital silence and suspends the PA SOURCE
# — never the sink — bringing that to 0.42 % with a 0 ms return. See that script
# for why the sink must not be touched. Started last: it needs `usb_in` to exist.
# The watcher resumes the source through PA's CLI socket rather than by forking
# `pactl` (70 ms on this CPU, right inside the window where audio is lost). The
# socket only exists while this module is loaded, so it is ours to load and to
# unload; the watcher falls back to pactl if it is missing.
MOD_CLI=$(pa load-module module-cli-protocol-unix)

start_silence() {
	nq-uac2-silence &
	SILPID=$!
}
start_silence

# alsaloop can WEDGE WITHOUT DYING, so process liveness is not enough — `kill -0`
# sees a perfectly healthy process the whole time it is burning a core.
#
# The failure that cost us this (2026-08-29, the Prague unit, 28 h): a UAC2 host
# stops sending but LEAVES THE STREAM OPEN. The gadget capture substream then sits
# in `state: RUNNING` with `hw_ptr` frozen at 0 forever — it looks live and
# delivers nothing. alsaloop has nothing to read, so the aloop playback side
# underruns into XRUN, and `--sync=simple` never recovers from that. alsaloop
# neither exits nor blocks: it SPINS. Measured 19-25 % of a core instantaneous,
# 13 h 33 min of CPU over 1 d 15 h wall, holding the MPU at 1200 MHz / 1380 mV and
# the die at 78 °C mean / 90.6 °C peak. Stopping the hop dropped it to 350 MHz and
# 66 °C within seconds.
#
# So the health of this bridge is "is INPUT arriving", which is `hw_ptr` on the
# gadget capture side. XRUN alone is the wrong trigger: restarting alsaloop into a
# host that is not sending just re-wedges it every few seconds.
#
#   input advancing + XRUN persists  -> a genuinely stuck loop, restart alsaloop
#   input frozen                     -> the host is gone; PARK alsaloop entirely
#
# Parked, we cannot watch `hw_ptr` any more — with nothing holding the substream it
# reads `closed`. The first version of this concluded the gadget exposes no "host is
# streaming" flag (its configfs attributes are indeed all static) and duty-cycled a
# probe: briefly run alsaloop every PARK_RETRY_S and keep it only if input moved.
#
# It does expose one. u_audio registers a read-only ALSA control on the gadget card,
# `iface=PCM,name='Capture Rate'`, which reports the sample rate the HOST has
# selected and reads 0 while the host is not streaming. Measured 2026-08-30 across
# two probe cycles on the Prague unit: it stayed 0 throughout, INCLUDING while the
# probe held the PCM open — so it tracks the host's alt-setting, not our open, which
# is exactly the signal the park state needs and cannot be faked by our own activity.
#
# That matters because the probe was not cheap. Measured over 300 s, 1 Hz, detached:
# it ran 9.0 % of wall time, and inside those windows the MPU sat at 1200 MHz 77.3 %
# of the time against 0.1 % while parked. 99 % of ALL time above 350 MHz was the
# probe looking for a host that was not there — 350 MHz residency 93.7 % parked vs
# 85.4 % overall, relative dynamic power 1.13x -> 1.54x, die +5.7 C, paid around the
# clock for as long as the TV box is powered on and not playing.
#
# So the park state now READS the flag instead of spawning anything -- once per
# change event since 2026-11-01 (the monitor below), by polling where those are
# not to be had -- and a host that closes its stream parks the bridge on the
# event at once, not 12 s later from hw_ptr. The hw_ptr check stays for the host
# that stops sending with its stream left open, which raises no event. The
# duty-cycled probe remains as a fallback for a kernel without the control, because
# a silent fallback to "never unpark" would lose USB audio altogether — it is
# announced once, loudly, so it cannot masquerade as the cheap path.
GADGET_STATUS="$ASOUND/$CARD/pcm0c/sub$SUB/status"
ALOOP_STATUS="$ASOUND/$ALOOP/pcm0p/sub$SUB/status"
XRUN_TICKS=0
XRUN_CONFIRM="${NQ_UAC2_XRUN_CONFIRM:-3}"
IDLE_TICKS=0
IDLE_CONFIRM="${NQ_UAC2_IDLE_CONFIRM:-4}"      # ~12 s of no input before parking
PARK_RETRY_S="${NQ_UAC2_PARK_RETRY_S:-30}"
PARK_POLL_TICKS="${NQ_UAC2_PARK_POLL_TICKS:-4}"  # poll the rate flag every Nth 3 s tick
PROBE_S="${NQ_UAC2_PROBE_S:-2}"
PARKED=0
PARK_WAIT=0
PARK_POLL=0
PARK_RATE=0        # host sample rate observed when we parked (see the park branch)
LAST_HW=""

hw_ptr() { sed -n 's/^hw_ptr *: *//p' "$GADGET_STATUS" 2>/dev/null; }

# Resolve `Capture Rate` by NAME once — numid is an allocation order, not an API,
# and hardcoding 4 would silently read a different control if the gadget ever
# registers another one first. Empty RATE_NUMID means "no such control": the park
# state falls back to the old probe.
RATE_NUMID="$(amixer -c "$CARD" controls 2>/dev/null \
    | sed -n "s/^numid=\([0-9]*\),iface=PCM,name='Capture Rate'$/\1/p" | head -1)"
if [ -n "$RATE_NUMID" ]; then
    echo "nexusq-uac2-in: host-streaming flag is control numid=$RATE_NUMID" \
         "('Capture Rate' on $CARD) — parking follows its change events" \
         "instead of probing" >&2
else
    echo "nexusq-uac2-in: WARNING no 'Capture Rate' control on $CARD — falling back" \
         "to the alsaloop probe every ${PARK_RETRY_S}s, which costs about 8 pp of" \
         "350 MHz residency while the host is idle" >&2
fi

# 0 (or empty) = the host is not streaming. The READ is one ioctl — but reaching
# it costs a fork, and on this SoC a fork is never free.
#
# ⚠️ MEASURED, do not make this more eager. `amixer cget` costs 19.5 ms of CPU at
# 1200 MHz (100 invocations, 1.95 s CPU) — about 67 ms at 350 MHz, where this
# service actually lives, which makes it MORE expensive than the `pactl` call the
# comment above warns about (51 ms by the same measurement). Polled every 3 s tick
# it would burn ~2.2 % of a core forever, and each ~67 ms burst is itself a run
# well past the 16 ms that makes `conservative` ramp — trading a 1200 MHz probe
# for a permanent 700 MHz nudge is not a win.
#
# So the flag is not polled while its change events can be had (see the monitor
# below): it is read once per event. Only without them -- no alsactl, the monitor
# found unreliable -- does the park state fall back to asking every
# PARK_POLL_TICKS-th tick: 12 s by default, ~0.55 % of a core.
capture_rate() {
    [ -n "$RATE_NUMID" ] || return 1
    amixer -c "$CARD" cget "numid=$RATE_NUMID" 2>/dev/null \
        | sed -n 's/^  : values=//p' | head -1
}

# TESTABLE:park_action — kept pure (arguments in, one word out, no side effects)
# so the decision table can be tested off-device; the tests extract exactly this
# block. $1 = rate observed when we parked, $2 = rate now.
#
#   park_rate 0     -> the host had CLOSED the stream. Any rate means it is back.
#   park_rate != 0  -> we parked mid-stream, i.e. the host claimed to be sending
#                      and was not: the wedge. The flag cannot distinguish wedged
#                      from playing at the same rate, so only a transition through
#                      0 is trustworthy and everything else must be MEASURED.
#
# Getting this wrong is not a small bug: treating "non-zero" as "wake up" while
# parked from a wedge unparks, finds input still frozen, re-parks 12 s later and
# repeats forever — a flap that costs more than the probe it replaced.
park_action() {
	if [ "$1" = 0 ]; then
		[ "$2" = 0 ] && echo stay || echo unpark
	else
		[ "$2" = 0 ] && echo closed || echo probe
	fi
}

# TESTABLE:rate_event_action — pure, like park_action. What a change event on
# `Capture Rate` means: the HOST changed its stream, because the gadget raises it
# only for that -- u_audio's set_active() on the alt-setting change that opens or
# closes the stream (u_audio_start/stop_capture, both from set_alt; also on a
# disconnect) and u_audio_set_capture_srate() on a rate change. Nothing we do
# raises it: the control is read-only, and our own controls (Capture Pitch,
# the volume) have names of their own that the monitor filters out.
# $1 = PARKED, $2 = rate when we parked, $3 = rate now.
#
#   bridging, rate 0     -> park:   the host closed the stream. Park NOW rather
#                                   than 12 s later from hw_ptr -- those 12 s are
#                                   the window alsaloop used to spin in.
#   bridging, rate != 0  -> none:   opened, or a new rate; hw_ptr supervises it.
#   parked,   rate != 0  -> unpark: the host (re)opened its stream. Unlike the
#                                   polled flag this is a transition, so it holds
#                                   in the wedge too -- an event needs a host
#                                   action, so it cannot flap on its own.
#   parked (wedge), rate 0 -> closed: the host let go; wait for it to open.
#   parked (closed), rate 0 -> none:  opened and closed again before we looked.
rate_event_action() {
	if [ "$1" = 0 ]; then
		[ "$3" = 0 ] && echo park || echo none
	elif [ "$3" != 0 ]; then
		echo unpark
	else
		[ "$2" = 0 ] && echo none || echo closed
	fi
}

# One long-lived `alsactl monitor` on the gadget card: it sleeps in epoll and the
# kernel wakes it with the control notification, so following the host costs
# nothing while nothing happens -- which replaces the 12 s amixer poll of the
# park state and lets the bridge park the moment the host closes its stream.
# Each "Capture Rate" line becomes a SIGUSR1 to this shell (the main loop's
# `wait` returns on it); the flag is then read once, outside the monitor, so a
# burst of events costs one read per wake, not one per line. Line format
# (alsactl/monitor.c): node hw:UAC2Gadget, #4 (3,0,0,Capture Rate,0) VALUE
#
# The events come from u_audio, not from anything this service can observe
# directly, so they are checked against what IS observed: if input was flowing
# and the host closed its stream (hw_ptr froze, the flag reads 0) without an
# event, the monitor is not to be trusted -- the park path below says so loudly
# and goes back to polling, rather than leaving USB audio parked for good.
# NQ_UAC2_RATE_EVENTS=0 forces the poll.
RATE_EVENTS="${NQ_UAC2_RATE_EVENTS:-1}"
start_monitor() {
	[ -n "$RATE_NUMID" ] && [ "$RATE_EVENTS" = 1 ] || return 1
	if ! command -v alsactl >/dev/null 2>&1; then
		echo "nexusq-uac2-in: WARNING no alsactl — polling the rate flag every" \
		     "$((PARK_POLL_TICKS * 3))s while parked" >&2
		RATE_EVENTS=0
		return 1
	fi
	_self=$$
	(
		alsactl monitor "hw:$CARD" 2>/dev/null | while IFS= read -r _l; do
			case "$_l" in
			*",Capture Rate,"*) kill -USR1 "$_self" 2>/dev/null ;;
			esac
		done
	) &
	MONPID=$!
}
monitor_alive() { [ -n "$MONPID" ] && kill -0 "$MONPID" 2>/dev/null; }
MON_TICKS=0        # ticks the current monitor has lived
MON_FAST=0         # monitors in a row that died within 20 ticks
BACKSTOP_TICKS="${NQ_UAC2_BACKSTOP_TICKS:-20}"  # parked on events: read the flag anyway every Nth tick (60 s)
INPUT_SEEN=0       # input moved since alsaloop last started (the event check above)

# Wait until a killed alsaloop is really gone, so that the next one does not
# find the PCMs still open (EBUSY). A `wait` alone is not enough: the monitor's
# SIGUSR1 cuts it short (the trap runs, `wait` returns >128, the child lives).
reap_alsaloop() {
	while kill -0 "$ALPID" 2>/dev/null; do
		wait "$ALPID" 2>/dev/null
	done
}

# Stop alsaloop and enter the park state; $1 = the host's rate at that moment.
park_alsaloop() {
	if [ -n "$ALPID" ]; then
		kill "$ALPID" 2>/dev/null
		reap_alsaloop
	fi
	ALPID=""
	PARKED=1; PARK_WAIT=0; PARK_POLL=0; IDLE_TICKS=0; XRUN_TICKS=0
	PARK_RATE="$1"
}
unpark_alsaloop() {
	start_alsaloop
	reset_loopback
	PARKED=0; IDLE_TICKS=0; XRUN_TICKS=0; LAST_HW=""; INPUT_SEEN=0
}

on_rate_event() {
	_r=$(capture_rate); _r=${_r:-0}
	case "$(rate_event_action "$PARKED" "$PARK_RATE" "$_r")" in
	park)
		echo "nexusq-uac2-in: host closed the stream (Capture Rate -> 0)" \
		     "— parking alsaloop now, woken by the next change" >&2
		park_alsaloop 0 ;;
	unpark)
		echo "nexusq-uac2-in: host started streaming at ${_r} Hz" \
		     "— USB audio live again" >&2
		unpark_alsaloop ;;
	closed)
		echo "nexusq-uac2-in: host closed the stream (was $PARK_RATE Hz)" \
		     "— waiting for it to open again" >&2
		PARK_RATE=0 ;;
	esac
}

# After the monitor was down, read the flag once -- but that read is a plain
# poll, not an event: no transition is implied, so parked it means what it means
# to the poll (park_action), and the wedge stays parked on an unchanged rate
# instead of unparking and re-parking 12 s later after every monitor death.
catch_up_rate() {
	if [ "$PARKED" = 0 ]; then
		on_rate_event
		return
	fi
	_r=$(capture_rate); _r=${_r:-0}
	case "$(park_action "$PARK_RATE" "$_r")" in
	unpark)
		echo "nexusq-uac2-in: host started streaming at ${_r} Hz" \
		     "while the monitor was down — USB audio live again" >&2
		unpark_alsaloop ;;
	closed)
		echo "nexusq-uac2-in: host closed the stream (was $PARK_RATE Hz)" \
		     "while the monitor was down — waiting for it to open again" >&2
		PARK_RATE=0 ;;
	esac   # stay / probe: the park state carries on as it was
}

start_monitor

# Supervise both children: if alsaloop drops on its own (host stop/start, xrun)
# restart just it — the PA modules stay loaded and the aloop capture underruns
# harmlessly in the gap — and likewise re-spawn the watcher if it ever dies, which
# would otherwise silently cost the idle power this service exists to save. A real
# stop runs the trap above instead; the `wait` on a sleep is interruptible, so
# SIGTERM still fires the trap promptly.
while : ; do
	if [ "$RATE_EVENT" = 0 ]; then
		sleep 3 &
		_sl=$!
		# A SIGUSR1 from the monitor ends the wait early; the sleep is ours to end.
		wait "$_sl" || kill "$_sl" 2>/dev/null
	fi
	if [ "$RATE_EVENT" = 1 ]; then
		RATE_EVENT=0
		on_rate_event
		continue
	fi
	# The monitor is supervised like the other children. Whatever changed while
	# it was down went unseen, so a restart reads the flag once to catch up. One
	# that keeps dying young (cannot open the card, say) is given up after three
	# tries in a row rather than re-forked every tick: the poll takes over.
	if [ "$RATE_EVENTS" = 1 ] && [ -n "$MONPID" ]; then
		if monitor_alive; then
			MON_TICKS=$((MON_TICKS + 1))
		else
			MONPID=""
			if [ "$MON_TICKS" -lt 20 ]; then MON_FAST=$((MON_FAST + 1)); else MON_FAST=0; fi
			if [ "$MON_FAST" -ge 3 ]; then
				echo "nexusq-uac2-in: WARNING the Capture Rate monitor keeps dying —" \
				     "polling the flag every $((PARK_POLL_TICKS * 3))s while parked" >&2
				RATE_EVENTS=0
			else
				echo "nexusq-uac2-in: Capture Rate monitor died, restarting it" >&2
				MON_TICKS=0
				start_monitor
			fi
			catch_up_rate
		fi
	fi
	if [ "$PARKED" = 0 ] && [ -n "$ALPID" ] && ! kill -0 "$ALPID" 2>/dev/null; then
		ALPID=""
		start_alsaloop
		LAST_HW=""
	fi

	if [ "$PARKED" = 1 ]; then
		# Ask the gadget whether the HOST is streaming — reading a flag instead
		# of starting a bridge to see whether one would have anything to carry.
		# Unparking also gets FASTER than the old 30 s retry: up to 30 s of a
		# track used to be missed, now at most PARK_POLL_TICKS x 3 s = 12 s.
		#
		# Which answer means "wake up" depends on WHY we parked, and conflating
		# the two would turn the 28 h wedge into a flapping loop: parked with the
		# host still claiming 48000 Hz, a bare "rate is non-zero -> unpark" would
		# unpark, find input still frozen, re-park 12 s later, and repeat forever.
		if [ -n "$RATE_NUMID" ]; then
			# Parked on a closed stream, the monitor's event is what wakes us.
			# (The wedge still polls: see park_action.) A slow read every
			# BACKSTOP_TICKS ticks backs it up: the self-check at the hw_ptr
			# park only covers a session in which input flowed, and a unit
			# that starts with the host idle parks without one -- if the event
			# never came on that unit, USB audio would never return. One
			# amixer fork a minute (~0.1 % of a core) is the price of that.
			if [ "$PARK_RATE" = 0 ] && monitor_alive; then
				PARK_POLL=$((PARK_POLL + 1))
				if [ "$PARK_POLL" -ge "$BACKSTOP_TICKS" ]; then
					PARK_POLL=0
					_r=$(capture_rate); _r=${_r:-0}
					if [ "$_r" != 0 ] && [ "$RATE_EVENT" = 0 ]; then
						echo "nexusq-uac2-in: WARNING the host is streaming at ${_r} Hz" \
						     "and no Capture Rate event said so — not trusting the" \
						     "monitor, polling the flag every $((PARK_POLL_TICKS * 3))s" \
						     "instead; USB audio live again" >&2
						RATE_EVENTS=0
						stop_monitor
						unpark_alsaloop
					fi
				fi
				ensure_modules
				continue
			fi
			# Thinned to one fork per PARK_POLL_TICKS ticks — see capture_rate.
			PARK_POLL=$((PARK_POLL + 1))
			if [ "$PARK_POLL" -lt "$PARK_POLL_TICKS" ]; then
				ensure_modules
				continue
			fi
			PARK_POLL=0
			_r=$(capture_rate); _r=${_r:-0}
			case "$(park_action "$PARK_RATE" "$_r")" in
			stay)
				ensure_modules
				continue ;;
			unpark)
				echo "nexusq-uac2-in: host started streaming at ${_r} Hz" \
				     "— USB audio live again" >&2
				unpark_alsaloop
				ensure_modules
				continue ;;
			closed)
				# The wedge resolved itself: the host let go of the stream, so
				# the cheap flag is trustworthy again from here on.
				echo "nexusq-uac2-in: host closed the stream (was $PARK_RATE Hz)" \
				     "— polling the flag instead of probing" >&2
				PARK_RATE=0
				ensure_modules
				continue ;;
			esac
			# probe: fall through and MEASURE, because asking cannot answer.
		fi

		# Ambiguous or no control: duty-cycled probe, as before.
		PARK_WAIT=$((PARK_WAIT + 3))
		if [ "$PARK_WAIT" -ge "$PARK_RETRY_S" ]; then
			PARK_WAIT=0
			start_alsaloop
			sleep "$PROBE_S"
			_a=$(hw_ptr); sleep 1; _b=$(hw_ptr)
			if [ -n "$_a" ] && [ -n "$_b" ] && [ "$_a" != "$_b" ]; then
				echo "nexusq-uac2-in: input resumed (hw_ptr $_a -> $_b)" \
				     "— USB audio live again" >&2
				reset_loopback
				PARKED=0; IDLE_TICKS=0; XRUN_TICKS=0; LAST_HW="$_b"; INPUT_SEEN=1
			else
				kill "$ALPID" 2>/dev/null
				reap_alsaloop
				ALPID=""
			fi
		fi
		ensure_modules
		continue
	fi

	# Health of the bridge = is INPUT arriving on the gadget capture side.
	#
	# "Moving" needs TWO non-empty readings that differ. An empty LAST_HW (first
	# tick, or just after a restart) must NOT read as movement: that false
	# positive let the XRUN branch below fire first and reset this tracking, so
	# the idle counter never reached its threshold and the supervisor flapped
	# alsaloop every 9 s instead of parking it. Absence of evidence counts
	# toward idle — the safe direction, since parking is cheap and reversible.
	NOW_HW=$(hw_ptr)
	INPUT_MOVING=0
	[ -n "$NOW_HW" ] && [ -n "$LAST_HW" ] && [ "$NOW_HW" != "$LAST_HW" ] \
		&& INPUT_MOVING=1 && INPUT_SEEN=1
	if [ -n "$ALPID" ] && kill -0 "$ALPID" 2>/dev/null && [ "$INPUT_MOVING" = 0 ]; then
		IDLE_TICKS=$((IDLE_TICKS + 1))
		if [ "$IDLE_TICKS" -ge "$IDLE_CONFIRM" ]; then
			# Why we parked, in the gadget's own terms: 0 = the host closed
			# the stream (its next event, or the cheap flag poll, wakes us),
			# non-zero = it still claims to stream but sends nothing (the
			# wedge — needs probing). Read AFTER alsaloop is gone, so the
			# answer describes the host rather than anything we were still
			# holding open.
			park_alsaloop 0
			_pr=$(capture_rate); PARK_RATE=${_pr:-0}
			# Input flowed and the host has closed its stream, yet no event
			# came (it would have parked us already): the monitor cannot be
			# relied on to wake us either. Poll instead. The second it waits
			# covers a host that closes during this very tick, after a silent
			# stretch: its event may still be on the way through the pipe.
			[ "$PARK_RATE" = 0 ] && [ "$INPUT_SEEN" = 1 ] && [ "$RATE_EVENT" = 0 ] \
				&& monitor_alive && sleep 1
			if [ "$PARK_RATE" = 0 ] && [ "$INPUT_SEEN" = 1 ] && [ "$RATE_EVENT" = 0 ] \
			   && monitor_alive; then
				echo "nexusq-uac2-in: WARNING the host closed its stream without a" \
				     "Capture Rate event — not trusting the monitor, polling" \
				     "the flag every $((PARK_POLL_TICKS * 3))s instead" >&2
				RATE_EVENTS=0
				stop_monitor
			fi
			# Say which of the two we are in — they cost very different
			# amounts, and "probing every 30s" printed while actually polling
			# a flag sent the next reader looking for the wrong thing.
			if [ -z "$RATE_NUMID" ]; then
				_how="probing every ${PARK_RETRY_S}s"
			elif [ "$PARK_RATE" = 0 ] && monitor_alive; then
				_how="host stream is closed; waiting for its Capture Rate event"
			elif [ "$PARK_RATE" = 0 ]; then
				_how="host stream is closed; polling the rate flag every $((PARK_POLL_TICKS * 3))s"
			else
				_how="host still claims ${PARK_RATE} Hz, so probing every ${PARK_RETRY_S}s"
			fi
			echo "nexusq-uac2-in: no input from the USB host for" \
			     "$((IDLE_CONFIRM * 3)) s (hw_ptr parked at $NOW_HW," \
			     "stream still open) — stopping alsaloop instead of" \
			     "letting it spin; $_how" >&2
			ensure_modules
			continue
		fi
	else
		IDLE_TICKS=0
	fi
	LAST_HW="$NOW_HW"

	# Input IS arriving but the loop is stuck: a genuinely wedged alsaloop.
	# Gated on INPUT_MOVING — restarting into a host that is not sending only
	# re-wedges it, which is what the park branch above is for.
	if [ "$INPUT_MOVING" = 1 ] && [ -n "$ALPID" ] && kill -0 "$ALPID" 2>/dev/null \
	   && grep -qx "state: XRUN" "$ALOOP_STATUS" 2>/dev/null; then
		XRUN_TICKS=$((XRUN_TICKS + 1))
		if [ "$XRUN_TICKS" -ge "$XRUN_CONFIRM" ]; then
			echo "nexusq-uac2-in: $ALOOP playback stuck in XRUN for" \
			     "$((XRUN_TICKS * 3)) s while input flows —" \
			     "restarting a wedged alsaloop" >&2
			kill "$ALPID" 2>/dev/null
			reap_alsaloop
			ALPID=""
			start_alsaloop
			XRUN_TICKS=0
			LAST_HW=""
		fi
	else
		XRUN_TICKS=0
	fi
	if [ -n "$SILPID" ] && ! kill -0 "$SILPID" 2>/dev/null; then
		echo "nexusq-uac2-in: silence watcher died, restarting it" >&2
		start_silence
	fi
	ensure_modules
done
