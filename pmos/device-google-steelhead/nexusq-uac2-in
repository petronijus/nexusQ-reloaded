#!/bin/sh
# nexusq-uac2-in — the "USB Audio" input service body. Brings the UAC2 gadget
# capture back into PulseAudio through a STABLE-CLOCK snd-aloop hop (the same
# pattern Roon uses), so USB audio mixes with Spotify/AirPlay/Roon, shares the one
# unified PA volume, follows output switching, and drives the LED visualizer:
#
#   host plays over USB -> UAC2Gadget capture (async, pcm0c)
#     -> alsaloop --sync=simple   (async -> stable, bounded buffers)
#     -> hw:Loopback,0,0          (snd-aloop playback side; timer-clocked)
#     -> PA module-alsa-source usb_in   (device=hw:Loopback,1,0)
#     -> PA module-loopback -> default sink (TAS5713, mixes with everything)
#
# WHY the aloop hop (do NOT "simplify" it away): PA's module-alsa-source must not
# read the async UAC2 gadget directly — that endpoint misreports its latency as an
# ever-growing value (~uptime), which drove module-loopback's resampler to the +1%
# rail and the delay ran away to MINUTES (the r65 removal; docs 2026-08-08).
# snd-aloop is virtual and timer-clocked, so PA reads a well-behaved PCM with sane
# latency; alsaloop --sync=simple absorbs the async->stable conversion with bounded
# buffers up front (proven on the r68 direct path). Result: no runaway, low CPU,
# and — unlike the exclusive r68 direct-to-amp bridge — the PA sink is NEVER
# suspended, so mixing + the unified volume + the LED visualizer all keep working.
#
# The aloop card (Loopback, index 0) is PULSE_IGNORE'd so PA won't auto-grab it; we
# load the source on it EXPLICITLY, exactly like Roon does on RoonLoop. Its old
# asound.conf tee is retired (see asound.conf) so the substream is ours.
#
# LONG-RUNNING (not oneshot): on SIGTERM (systemctl stop / the app's disable --now)
# the trap unloads the two PA modules and kills alsaloop. Toggled from the app as
# the "usbaudio" service; OFF by default. The UAC2 gadget capture card is owned by
# nexusq-usb-gadget.service and is always present.
set -u

CARD="${NQ_UAC2_CARD:-UAC2Gadget}"       # gadget capture card (async endpoint)
ALOOP="${NQ_UAC2_ALOOP:-Loopback}"       # snd-aloop card (spare, PULSE_IGNORE'd)
SUB="${NQ_UAC2_ALOOP_SUB:-0}"            # aloop substream pair to use
SRC="${NQ_UAC2_SOURCE:-usb_in}"          # PA source name
TLAT="${NQ_UAC2_TLATENCY:-80000}"        # alsaloop -t target loop latency (us)
LOOPLAT="${NQ_UAC2_LOOPLAT:-120}"        # module-loopback latency_msec (lip-sync cushion)

pa() { pactl "$@" 2>/dev/null; }         # returns pactl stdout (module index on load)

ALPID=""; MOD_SRC=""; MOD_LB=""; SILPID=""; MOD_CLI=""

# On stop: tear the PA hop down cleanly (loopback first, then its source) and stop
# alsaloop. No suspend-sink to undo — we never suspended. KillMode=mixed keeps
# these pactl children alive past the shell's SIGTERM.
stop_all() {
	# The silence watcher goes FIRST: on SIGTERM it resumes the source it may
	# have suspended, and it must get that chance while the source still exists.
	if [ -n "$SILPID" ]; then
		kill "$SILPID" 2>/dev/null
		i=0
		while [ "$i" -lt 20 ] && kill -0 "$SILPID" 2>/dev/null; do
			i=$((i + 1)); sleep 0.1
		done
	fi
	[ -n "$MOD_LB" ]  && pa unload-module "$MOD_LB"  >/dev/null 2>&1
	[ -n "$MOD_SRC" ] && pa unload-module "$MOD_SRC" >/dev/null 2>&1
	[ -n "$MOD_CLI" ] && pa unload-module "$MOD_CLI" >/dev/null 2>&1
	[ -n "$ALPID" ]   && kill "$ALPID" 2>/dev/null
	exit 0
}
trap stop_all TERM INT

# The gadget capture card appears a few seconds into boot; wait briefly for it.
i=0
while [ "$i" -lt 20 ]; do
	grep -q "$CARD" /proc/asound/cards 2>/dev/null && break
	i=$((i + 1)); sleep 1
done
if ! grep -q "$CARD" /proc/asound/cards 2>/dev/null; then
	echo "nexusq-uac2-in: UAC2 gadget card '$CARD' not present" >&2
	exit 1
fi

# PA is Wants=/After=pulseaudio.service but may still be coming up; wait for it so
# the load-module calls below actually land.
i=0
while [ "$i" -lt 20 ]; do
	pa info >/dev/null 2>&1 && break
	i=$((i + 1)); sleep 1
done

# Defensive: drop any stale usb_in source + its loopback left by a crash, so we
# never stack a second hop on the same substream.
for m in $(pa list short modules | grep -e "source_name=$SRC" -e "source=$SRC" | cut -f1); do
	pa unload-module "$m" >/dev/null 2>&1
done

# Start the async->stable bridge: UAC2 gadget capture -> snd-aloop playback side.
start_alsaloop() {
	alsaloop -C "hw:$CARD" -P "hw:$ALOOP,0,$SUB" -r 48000 -c 2 -f S16_LE \
		--sync=simple -t "$TLAT" &
	ALPID=$!
}
start_alsaloop
sleep 1   # let alsaloop open the playback side before PA opens the capture side

# PA reads the stable capture side and loops it into the default sink (mixes with
# everything, follows output switching). Load the source FIRST so it pins the pair
# at s16le/48k, then the loopback.
start_source() {
	MOD_SRC=$(pa load-module module-alsa-source device="hw:$ALOOP,1,$SUB" \
		source_name="$SRC" source_properties=device.description=USBAudio \
		rate=48000 channels=2 format=s16le)
}
start_loopback() {
	MOD_LB=$(pa load-module module-loopback source="$SRC" latency_msec="$LOOPLAT")
	fix_loopback_volume
}
# module-loopback's sink-input can come up MUTED / attenuated: module-stream-restore
# restores a saved volume/mute for the "Loopback from USBAudio" stream, and a stale
# 0%/muted entry makes USB audio silent while everything else (amp, source) looks
# fine. Force the stream to unity, unmuted — USB audio is a full-level passthrough;
# loudness belongs to the sink (ring) + the source, not this internal hop. Retry a
# few ticks because the sink-input appears just after the module loads. Runs after
# EVERY loopback load, including a re-load by the supervisor below.
fix_loopback_volume() {
	[ -n "$MOD_LB" ] || return 0
	j=0
	while [ "$j" -lt 10 ]; do
		si=$(pactl list sink-inputs 2>/dev/null | awk -v m="$MOD_LB" '
			/^Sink Input #/{id=substr($3,2)}
			/Owner Module:/{if ($3==m) {print id; exit}}')
		[ -n "$si" ] && break
		j=$((j + 1)); sleep 1
	done
	if [ -n "$si" ]; then
		pa set-sink-input-mute "$si" 0
		pa set-sink-input-volume "$si" 100%
	fi
}

# Is a module index still loaded, according to a module list captured by the
# caller? Takes the list as $2 so ONE `pactl` covers both checks — see
# ensure_modules for why that matters.
mod_alive() {
	[ -n "$1" ] || return 1
	printf '%s\n' "$2" | cut -f1 | grep -qx "$1"
}

# Our two PA modules can vanish underneath us WITHOUT this service being touched.
# Measured 2026-08-27: unloading ANY other module-alsa-source — turning Roon off
# does exactly that — takes our module-loopback with it, reproducibly, and then
# USB audio is silent while the unit still reads `active`, alsaloop still runs and
# the source module is still there. Nothing logs it. So the service supervises the
# modules it owns, exactly as it supervises alsaloop and the watcher; the source
# goes first because the loopback is meaningless without it.
# ⚠️ COSTS REAL POWER — do not make this check more eager. Forking `pactl` costs
# ~70 ms of CPU on this SoC (measured independently twice: once profiling the
# silence watcher's wake path, once here). The first version of this ran TWO
# `pactl` calls every 3 s, which is 0.67 forks/s and measured **+4.6 % of a core
# at idle** — the service's cgroup went from ~1.3 % to 5.98 %, the governor
# bounced 350<->700 at 0.43/s, and a whole overnight window came out at 1.29x the
# 350 MHz floor instead of 1.04x. Per-process sampling did not show it, because
# the forks are shorter than the sample interval; only the cgroup total did.
#
# So: ONE `pactl` for both checks, and only every MOD_CHECK_TICKS-th pass. At
# 5 ticks x 3 s that is one fork per 15 s (~0.23 % of a core) and bounds the
# window in which USB audio could be silent after another source's alsa-source is
# unloaded — which was previously permanent, so 15 s is a fine trade.
MOD_CHECK_TICKS=${NQ_UAC2_MOD_CHECK_TICKS:-5}
mod_tick=0
ensure_modules() {
	mod_tick=$((mod_tick + 1))
	[ "$mod_tick" -ge "$MOD_CHECK_TICKS" ] || return 0
	mod_tick=0
	_mods=$(pa list short modules 2>/dev/null)
	[ -n "$_mods" ] || return 0        # PA down/restarting: nothing to conclude
	if ! mod_alive "$MOD_SRC" "$_mods"; then
		echo "nexusq-uac2-in: PA source module vanished, reloading" >&2
		start_source
		MOD_LB=""            # a loopback pointing at the old source is useless
	elif ! mod_alive "$MOD_LB" "$_mods"; then
		echo "nexusq-uac2-in: PA loopback module vanished, reloading" >&2
		start_loopback
	fi
}

start_source
start_loopback


# Idle power: with nothing playing, the host still streams and PulseAudio still
# resamples, which measured 28.83 % of one core (PA alone 27.17 %) and kept the amp
# powered. nq-uac2-silence watches for digital silence and suspends the PA SOURCE
# — never the sink — bringing that to 0.42 % with a 0 ms return. See that script
# for why the sink must not be touched. Started last: it needs `usb_in` to exist.
# The watcher resumes the source through PA's CLI socket rather than by forking
# `pactl` (70 ms on this CPU, right inside the window where audio is lost). The
# socket only exists while this module is loaded, so it is ours to load and to
# unload; the watcher falls back to pactl if it is missing.
MOD_CLI=$(pa load-module module-cli-protocol-unix)

start_silence() {
	nq-uac2-silence &
	SILPID=$!
}
start_silence

# alsaloop can WEDGE WITHOUT DYING, so process liveness is not enough — `kill -0`
# sees a perfectly healthy process the whole time it is burning a core.
#
# The failure that cost us this (2026-08-29, the Prague unit, 28 h): a UAC2 host
# stops sending but LEAVES THE STREAM OPEN. The gadget capture substream then sits
# in `state: RUNNING` with `hw_ptr` frozen at 0 forever — it looks live and
# delivers nothing. alsaloop has nothing to read, so the aloop playback side
# underruns into XRUN, and `--sync=simple` never recovers from that. alsaloop
# neither exits nor blocks: it SPINS. Measured 19-25 % of a core instantaneous,
# 13 h 33 min of CPU over 1 d 15 h wall, holding the MPU at 1200 MHz / 1380 mV and
# the die at 78 °C mean / 90.6 °C peak. Stopping the hop dropped it to 350 MHz and
# 66 °C within seconds.
#
# So the health of this bridge is "is INPUT arriving", which is `hw_ptr` on the
# gadget capture side. XRUN alone is the wrong trigger: restarting alsaloop into a
# host that is not sending just re-wedges it every few seconds.
#
#   input advancing + XRUN persists  -> a genuinely stuck loop, restart alsaloop
#   input frozen                     -> the host is gone; PARK alsaloop entirely
#
# Parked, we cannot watch `hw_ptr` any more (with nothing holding the substream it
# reads `closed`), and the gadget exposes no "host is streaming" flag — its configfs
# attributes are all static. So the parked state duty-cycles a probe instead:
# briefly run alsaloop every PARK_RETRY_S and keep it only if input moves. That
# trades the 46 %-of-a-core spin for roughly 2 s of work every 30 s.
GADGET_STATUS="/proc/asound/$CARD/pcm0c/sub$SUB/status"
ALOOP_STATUS="/proc/asound/$ALOOP/pcm0p/sub$SUB/status"
XRUN_TICKS=0
XRUN_CONFIRM="${NQ_UAC2_XRUN_CONFIRM:-3}"
IDLE_TICKS=0
IDLE_CONFIRM="${NQ_UAC2_IDLE_CONFIRM:-4}"      # ~12 s of no input before parking
PARK_RETRY_S="${NQ_UAC2_PARK_RETRY_S:-30}"
PROBE_S="${NQ_UAC2_PROBE_S:-2}"
PARKED=0
PARK_WAIT=0
LAST_HW=""

hw_ptr() { sed -n 's/^hw_ptr *: *//p' "$GADGET_STATUS" 2>/dev/null; }

# Supervise both children: if alsaloop drops on its own (host stop/start, xrun)
# restart just it — the PA modules stay loaded and the aloop capture underruns
# harmlessly in the gap — and likewise re-spawn the watcher if it ever dies, which
# would otherwise silently cost the idle power this service exists to save. A real
# stop runs the trap above instead; the `wait` on a sleep is interruptible, so
# SIGTERM still fires the trap promptly.
while : ; do
	sleep 3 &
	wait $!
	if [ "$PARKED" = 0 ] && [ -n "$ALPID" ] && ! kill -0 "$ALPID" 2>/dev/null; then
		ALPID=""
		start_alsaloop
		LAST_HW=""
	fi

	if [ "$PARKED" = 1 ]; then
		# Duty-cycled probe: is the host sending again?
		PARK_WAIT=$((PARK_WAIT + 3))
		if [ "$PARK_WAIT" -ge "$PARK_RETRY_S" ]; then
			PARK_WAIT=0
			start_alsaloop
			sleep "$PROBE_S"
			_a=$(hw_ptr); sleep 1; _b=$(hw_ptr)
			if [ -n "$_a" ] && [ -n "$_b" ] && [ "$_a" != "$_b" ]; then
				echo "nexusq-uac2-in: input resumed (hw_ptr $_a -> $_b)" \
				     "— USB audio live again" >&2
				PARKED=0; IDLE_TICKS=0; XRUN_TICKS=0; LAST_HW="$_b"
			else
				kill "$ALPID" 2>/dev/null
				wait "$ALPID" 2>/dev/null
				ALPID=""
			fi
		fi
		ensure_modules
		continue
	fi

	# Health of the bridge = is INPUT arriving on the gadget capture side.
	#
	# "Moving" needs TWO non-empty readings that differ. An empty LAST_HW (first
	# tick, or just after a restart) must NOT read as movement: that false
	# positive let the XRUN branch below fire first and reset this tracking, so
	# the idle counter never reached its threshold and the supervisor flapped
	# alsaloop every 9 s instead of parking it. Absence of evidence counts
	# toward idle — the safe direction, since parking is cheap and reversible.
	NOW_HW=$(hw_ptr)
	INPUT_MOVING=0
	[ -n "$NOW_HW" ] && [ -n "$LAST_HW" ] && [ "$NOW_HW" != "$LAST_HW" ] \
		&& INPUT_MOVING=1
	if [ -n "$ALPID" ] && kill -0 "$ALPID" 2>/dev/null && [ "$INPUT_MOVING" = 0 ]; then
		IDLE_TICKS=$((IDLE_TICKS + 1))
		if [ "$IDLE_TICKS" -ge "$IDLE_CONFIRM" ]; then
			echo "nexusq-uac2-in: no input from the USB host for" \
			     "$((IDLE_TICKS * 3)) s (hw_ptr parked at $NOW_HW," \
			     "stream still open) — stopping alsaloop instead of" \
			     "letting it spin; probing every ${PARK_RETRY_S}s" >&2
			kill "$ALPID" 2>/dev/null
			wait "$ALPID" 2>/dev/null
			ALPID=""
			PARKED=1; PARK_WAIT=0; IDLE_TICKS=0; XRUN_TICKS=0
			ensure_modules
			continue
		fi
	else
		IDLE_TICKS=0
	fi
	LAST_HW="$NOW_HW"

	# Input IS arriving but the loop is stuck: a genuinely wedged alsaloop.
	# Gated on INPUT_MOVING — restarting into a host that is not sending only
	# re-wedges it, which is what the park branch above is for.
	if [ "$INPUT_MOVING" = 1 ] && [ -n "$ALPID" ] && kill -0 "$ALPID" 2>/dev/null \
	   && grep -qx "state: XRUN" "$ALOOP_STATUS" 2>/dev/null; then
		XRUN_TICKS=$((XRUN_TICKS + 1))
		if [ "$XRUN_TICKS" -ge "$XRUN_CONFIRM" ]; then
			echo "nexusq-uac2-in: $ALOOP playback stuck in XRUN for" \
			     "$((XRUN_TICKS * 3)) s while input flows —" \
			     "restarting a wedged alsaloop" >&2
			kill "$ALPID" 2>/dev/null
			wait "$ALPID" 2>/dev/null
			ALPID=""
			start_alsaloop
			XRUN_TICKS=0
			LAST_HW=""
		fi
	else
		XRUN_TICKS=0
	fi
	if [ -n "$SILPID" ] && ! kill -0 "$SILPID" 2>/dev/null; then
		echo "nexusq-uac2-in: silence watcher died, restarting it" >&2
		start_silence
	fi
	ensure_modules
done
