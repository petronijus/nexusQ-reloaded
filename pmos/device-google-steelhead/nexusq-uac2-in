#!/bin/sh
# nexusq-uac2-in — the "USB Audio" input service body. Wires the UAC2 gadget's
# capture stream into PulseAudio so the Q is a USB DAC/speaker:
#
#   host plays over USB -> UAC2Gadget capture (pcm0c) -> module-alsa-source
#   "usb_in" -> module-loopback -> default sink -> TAS5713 amp
#
# Runs in the uid-10000 `user` PA session (see nexusq-uac2-in.service), exactly
# like the Roon loopback, and is toggled from the companion app as the "usbaudio"
# service. OFF by default so the always-on alsa-source + loopback cost nothing
# until the user wants USB audio.
#
# IMPORTANT — this is a LONG-RUNNING process, not a oneshot: the PA modules
# persist in PulseAudio independently of any process, so they MUST be unloaded on
# a SIGTERM (which is what `systemctl stop` and the app's `mask --now` send).
# A oneshot + ExecStop would leak, because `mask --now` replaces the unit with
# /dev/null before the stop, losing ExecStop. So: load, then wait, and unload in
# a signal trap.
#
# The gadget's UAC2 function / the UAC2Gadget capture card itself is owned by
# nexusq-usb-gadget.service and is always present; this only wires it into PA.
set -u

CARD="${NQ_UAC2_CARD:-UAC2Gadget}"
SRC="${NQ_UAC2_SOURCE:-usb_in}"
LAT="${NQ_UAC2_LATENCY:-80}"   # loopback cushion (ms); USB audio is low-latency

# All PA modules this service owns carry "$SRC" (usb_in) in their argument line
# (module-alsa-source source_name=usb_in, module-loopback source=usb_in), so we
# find/unload exactly ours without touching Roon's roon_in loopback.
unload_ours() {
	pactl list short modules 2>/dev/null | awk -v s="$SRC" '$0 ~ s {print $1}' \
		| while read -r m; do pactl unload-module "$m" 2>/dev/null || true; done
}

# Unload on stop / mask (SIGTERM) or SIGINT, then exit cleanly.
trap 'unload_ours; exit 0' TERM INT

unload_ours   # clear any leak from a prior hard (SIGKILL) stop

# The gadget capture card appears a few seconds into boot; wait briefly for it.
i=0
while [ "$i" -lt 20 ]; do
	grep -q "$CARD" /proc/asound/cards 2>/dev/null && break
	i=$((i + 1)); sleep 1
done
if ! grep -q "$CARD" /proc/asound/cards 2>/dev/null; then
	echo "nexusq-uac2-in: UAC2 gadget card '$CARD' not present" >&2
	exit 1
fi

pactl load-module module-alsa-source "device=hw:$CARD" "source_name=$SRC" \
	source_properties=device.description=USB-Audio-In >/dev/null || exit 1
pactl load-module module-loopback "source=$SRC" "latency_msec=$LAT" \
	"sink=@DEFAULT_SINK@" >/dev/null || { unload_ours; exit 1; }

# Stay alive so systemd sees the service "active" while the loopback is wired.
# `wait` is interruptible, so a SIGTERM fires the trap promptly.
while : ; do
	sleep 86400 &
	wait "$!"
done
