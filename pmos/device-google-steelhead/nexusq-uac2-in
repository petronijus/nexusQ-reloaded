#!/bin/sh
# nexusq-uac2-in — the "USB Audio" input service body. Bridges the UAC2 gadget
# capture STRAIGHT to the TAS5713 amp with alsaloop — NO PulseAudio in the audio
# path — for minimum CPU on the weak OMAP4:
#
#   host plays over USB -> UAC2Gadget capture (pcm0c) -> alsaloop (--sync=simple,
#   closed-loop pitch rate-match) -> hw:NexusQSpeaker (TAS5713 amp)
#
# This replaced the old PulseAudio module-alsa-source + module-loopback bridge
# (2026-08-08). That PA design had two measured faults: (a) the playback delay ran
# away to MINUTES over a long session — module-alsa-source reported a bogus,
# ever-growing latency (~uptime, not the real ~ms buffer) that poisoned
# module-loopback's rate controller until its resampler pegged at the +1% rail and
# the backlog grew unbounded; and (b) the loopback sink-input never corked, so
# module-suspend-on-idle could never sleep the amp — the DAC/clock/DMA/resampler
# ran 24/7, burning CPU + ~5 °C even in silence. alsaloop rate-matches from the
# REAL hardware pointers (no PA smoother to diverge) and only runs while the toggle
# is on; measured ~0.2% of one core vs ~15-20% for the old bridge.
#
# TRADE-OFF — EXCLUSIVE amp: alsaloop owns the TAS5713 card directly, so while USB
# audio is on we SUSPEND PulseAudio's tas5713 sink to release the card (Spotify /
# AirPlay / Roon have no output for the duration) and un-suspend it on stop. The
# front-panel volume ring still works throughout: nq-vol sets the TAS5713 hardware
# Master mixer directly, independent of PulseAudio.
#
# LONG-RUNNING (not oneshot): on SIGTERM (systemctl stop / the app's disable --now)
# the trap kills alsaloop and hands the amp back to PulseAudio. Toggled from the
# companion app as the "usbaudio" service; OFF by default. The UAC2 gadget capture
# card is owned by nexusq-usb-gadget.service and is always present.
set -u

CARD="${NQ_UAC2_CARD:-UAC2Gadget}"                 # gadget capture card
SPKR="${NQ_UAC2_SPEAKER_CARD:-NexusQSpeaker}"      # TAS5713 playback card
PA_SINK="${NQ_UAC2_PA_SINK:-alsa_output.platform-sound-tas5713.stereo-fallback}"
TLAT="${NQ_UAC2_TLATENCY:-100000}"                 # alsaloop target loop latency (us)
# Starting amp volume when USB audio turns on. The normal volume path (ring ->
# nexusqd -> nq-vol) drives PulseAudio, but here PA is bypassed, so nq-vol detects
# USB audio is on and drives this TAS5713 hardware Master instead (amixer). We set
# a LOW, never-loud starting level so turning USB audio on can't blast the amp
# (25 W, steep curve); the ring takes it up from there. Tunable via NQ_UAC2_VOL.
STARTVOL="${NQ_UAC2_VOL:-10%}"

pa() { pactl "$@" 2>/dev/null || true; }

ALPID=""
# Un-suspend the PA sink (give the amp back) and stop alsaloop, then exit. Runs on
# SIGTERM/SIGINT — including the app's `disable --now` and systemd's KillMode=mixed.
stop_all() {
	[ -n "$ALPID" ] && kill "$ALPID" 2>/dev/null
	pa suspend-sink "$PA_SINK" 0
	exit 0
}
trap stop_all TERM INT

# The gadget capture card appears a few seconds into boot; wait briefly for it.
i=0
while [ "$i" -lt 20 ]; do
	grep -q "$CARD" /proc/asound/cards 2>/dev/null && break
	i=$((i + 1)); sleep 1
done
if ! grep -q "$CARD" /proc/asound/cards 2>/dev/null; then
	echo "nexusq-uac2-in: UAC2 gadget card '$CARD' not present" >&2
	exit 1
fi

# Release the TAS5713 card from PulseAudio so alsaloop can open it exclusively.
pa suspend-sink "$PA_SINK" 1
sleep 1

# PulseAudio normally drives the amp's Speaker switch (its mixer path) and volume;
# bypassing it, we own both. Set a safe starting Master and enable the Speaker
# output so USB audio is audible; the ring adjusts Master via nq-vol from here. On
# stop, PA reclaims the sink and its mixer path resets Master/Speaker, so no
# restore is needed.
amixer -c "$SPKR" -M sset Master "$STARTVOL" >/dev/null 2>&1 || true
amixer -c "$SPKR" sset Speaker unmute >/dev/null 2>&1 || true

# Bridge capture -> amp. Re-open if alsaloop drops (host stop/start, xrun) while we
# are still meant to be running; a real stop runs the trap above instead. `wait` is
# interruptible, so SIGTERM fires the trap promptly even mid-wait.
while : ; do
	alsaloop -C "hw:$CARD" -P "hw:$SPKR" -r 48000 -c 2 -f S16_LE \
		--sync=simple -t "$TLAT" &
	ALPID=$!
	wait "$ALPID"
	ALPID=""
	sleep 2
done
