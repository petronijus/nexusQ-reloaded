#!/bin/sh
# nexusq-wifi-watchdog — keep the BCM4330 5 GHz link alive on a marginal 2013
# combo chip, and record its health over time.
#
# Three jobs (see brcmfmac-roamoff.conf and docs/2026-07-31-* WiFi investigation):
#
#   1. HEAL — the chip can WEDGE: it stays associated at good signal with RX
#      still working, but TX silently collapses to ~0 (the gateway becomes
#      unreachable). NetworkManager never notices — the link is still
#      "connected" — so nothing recovers it. A `nmcli device disconnect/connect
#      wlan0` reliably un-wedges it (measured 2026-07-31). So: ping the wlan0
#      default gateway every INTERVAL; after FAILS_TO_HEAL consecutive failures,
#      bounce the connection (rate-limited by HEAL_COOLDOWN so it can't storm).
#
#   2. RECONNECT — the heal itself can strand the device. `nmcli device
#      disconnect` BLOCKS NetworkManager's autoconnect on that device until the
#      next explicit connect or a reboot; if the `connect` half then fails
#      (measured 2026-08-30: the scan cache was empty right after a
#      brcmf_escan_timeout, and nmcli answered "A 'wireless' setting is required
#      if no AP path was given"), wlan0 sits in state 30/disconnected FOREVER.
#      The old code treated any not-associated state as "NM owns re-association"
#      and did nothing — and the cottage unit stayed dark for six days on a
#      healthy box (docs/2026-09-05-*). So: a wlan0 that NM reports as plainly
#      `disconnected` (not unmanaged, not unavailable, not mid-activation) for
#      DOWN_TO_RECONNECT consecutive checks gets an explicit rescan + `nmcli
#      device connect`, which is also what clears the autoconnect block. Same
#      cooldown as the heal, so it cannot storm either.
#
#   3. LOG — append one compact JSONL health line per check (loss %, signal)
#      plus distinct heal / heal_result / reconnect / reconnect_result events,
#      co-located with nq-healthd's logs so the diag suite (nq-collect) picks
#      them up. This is how we tell IF and WHEN the link still degrades and
#      whether roamoff=1 is enough.
#
#   4. REPORT — every repair (heal or reconnect) is also counted in a small
#      state file, $RUNDIR/wifi-watchdog.json, which nexusq-mqtt publishes to
#      Home Assistant (a "WiFi repairs" counter and a "WiFi link" problem
#      sensor). A repair is a failure that happened, not a normal event: the
#      firmware wedge these heals were built for is gone since firmware r3
#      (docs/2026-09-23-wifi-unicast-wedge-firmware.md), so a repair that shows
#      up now is news, and a quiet fix buried in a log would hide it. /run is
#      tmpfs, so the count is per boot; a restart of this service continues it.
#
#   5. ESCALATE — the repairs above only talk to NetworkManager. On 2026-11-18
#      08:02 the BCM4330 itself stopped answering on its SDIO bus
#      (`brcmf_sdio_bus_rxctl: resumed on timeout`, then -110 on every command):
#      the heal and then ~1 200 reconnects ran for three days, every one ending
#      `assoc:no`, because no nmcli call can revive a chip the driver cannot
#      reach (docs/2026-11-21-wifi-sdio-wedge-escalation.md). So repairs now
#      climb a ladder, one rung per FAILED repair, and drop back to the bottom
#      as soon as one works or the link is seen healthy:
#        soft    the nmcli bounce / reconnect above (NQ_WIFI_RESET_AFTER failures)
#        reset   power-cycle the chip: unload brcmfmac, unbind and rebind the SDIO
#                host (its mmc-pwrseq pulses the chip's reset line), reload, and
#                connect (NQ_WIFI_REBOOT_AFTER failed resets)
#        reboot  last resort, and only when nothing else can reach the box: no
#                default route over another interface, at least NQ_WIFI_MIN_UPTIME
#                seconds of uptime, and fewer than NQ_WIFI_MAX_REBOOTS reboots in a
#                row (the count lives on the persist partition and is cleared after
#                NQ_WIFI_OK_TO_CLEAR healthy checks, so a box that cannot be fixed
#                cannot reboot-loop). The next boot starts with repairs=1 so Home
#                Assistant's "WiFi repairs" counter shows that it happened.
#
# Scope: ONLY ever touches wlan0. States that are not ours to fix are left
# alone: unmanaged (10) and unavailable (20) mean the radio is off or the driver
# is gone, and anything between prepare (40) and activated (100) means NM is
# already (re)connecting. The watchdog acts on exactly two shapes: the
# associated-but-dead wedge NM cannot see, and the disconnected-and-blocked
# state NM will not leave on its own.
#
# Env overrides: NQ_WIFI_INTERVAL, NQ_WIFI_FAILS, NQ_WIFI_COOLDOWN,
# NQ_WIFI_BADLOSS, NQ_WIFI_DOWNS, NQ_LOGDIR, NQ_WIFI_LOGCAP, NQ_RUNDIR,
# NQ_WIFI_RESET_AFTER, NQ_WIFI_REBOOT_AFTER, NQ_WIFI_MIN_UPTIME,
# NQ_WIFI_MAX_REBOOTS, NQ_WIFI_OK_TO_CLEAR, NQ_PERSIST, NQ_WIFI_MMC.
set -u

IFACE=wlan0
INTERVAL="${NQ_WIFI_INTERVAL:-30}"       # seconds between checks
FAILS_TO_HEAL="${NQ_WIFI_FAILS:-3}"      # consecutive bad checks before a bounce
HEAL_COOLDOWN="${NQ_WIFI_COOLDOWN:-180}" # min seconds between bounces/reconnects (anti-storm)
BAD_LOSS="${NQ_WIFI_BADLOSS:-75}"        # packet-loss % that counts as "bad"
DOWN_TO_RECONNECT="${NQ_WIFI_DOWNS:-4}"  # consecutive `disconnected` checks before we
                                         # reconnect ourselves (~2 min at 30 s): long
                                         # enough for NM's own autoconnect to have had
                                         # its say, short enough that nobody notices.
HEARTBEAT_EVERY="${NQ_WIFI_HEARTBEAT:-10}" # thin the steady "ok" stream to one line
                                         # per Nth check (~5 min at 30 s). EVERY
                                         # non-ok check and EVERY state change is
                                         # still logged in full, so a degradation is
                                         # never thinned away.
LOGDIR="${NQ_LOGDIR:-/var/log/nq-health}"
LOG="$LOGDIR/wifi-watchdog.jsonl"
CAP="${NQ_WIFI_LOGCAP:-20000}"           # keep at most this many log lines (weeks of
                                         # data; a steady day is only ~300 lines now)
RUNDIR="${NQ_RUNDIR:-/run/nexusq}"
STATE="$RUNDIR/wifi-watchdog.json"       # repair count for nexusq-mqtt (job 4)

RESET_AFTER="${NQ_WIFI_RESET_AFTER:-2}"   # failed soft repairs before the chip is reset
REBOOT_AFTER="${NQ_WIFI_REBOOT_AFTER:-2}" # failed chip resets before a reboot is considered
MIN_UPTIME="${NQ_WIFI_MIN_UPTIME:-600}"   # never reboot a box younger than this (s)
MAX_REBOOTS="${NQ_WIFI_MAX_REBOOTS:-3}"   # consecutive watchdog reboots before we stop
OK_TO_CLEAR="${NQ_WIFI_OK_TO_CLEAR:-20}"  # healthy checks (~10 min) that clear that count
PERSIST="${NQ_PERSIST:-/var/lib/nexusq/persist}"
REBOOTS_FILE="$PERSIST/wifi-watchdog-reboots"
MMC_HOST="${NQ_WIFI_MMC:-480d5000.mmc}"   # the SDIO host the BCM4330 sits on (fallback;
                                          # the live one is read from sysfs when wlan0 exists)

mkdir -p "$LOGDIR" "$RUNDIR"

# FORK DIET (device r110). The steady-state check used to fork ~15 times every
# 30 s — `cut` for the uptime, `iw` twice (once for assoc, once for signal) each
# into grep/awk, `ip | awk`, `ping | grep | grep`, and `wc -l` over the whole
# JSONL log for the size cap. Measured on the cottage Q (2026-09-26, sched
# trace): 465 ms of CPU per minute, 0.78 % of a core — as much as systemd-oomd,
# and invisible in per-process accounting because every fork is a new PID. Now
# one `iw`, one `ip` and one `ping` per check, parsed by the shell itself
# (parse_link / parse_gw / parse_loss below, tested against real device output),
# the uptime read with a builtin, and the log length kept in a counter.
# The helpers still return values through variables rather than stdout, because
# every $(...) is a fork of its own in this shell.

# Seconds since boot, into NOW. `read` is a builtin: no fork.
now_s()  { read -r _up _rest < /proc/uptime; NOW=${_up%%.*}; }
mono()   { now_s; echo "$NOW"; }    # for the rare repair paths only

# TESTABLE:parse_link
# parse_link <output of `iw dev wlan0 link`>: sets LINK_ASSOC to yes|no and
# LINK_SIG to the signal in dBm ("-45"), empty when there is none. Same answers
# as the `grep -q "Connected to"` and `awk '/signal:/{print $2}'` it replaces.
parse_link() {
	LINK_ASSOC=no; LINK_SIG=
	case "$1" in *"Connected to"*) LINK_ASSOC=yes ;; esac
	case "$1" in
		*"signal:"*)
			_s=${1#*signal:}
			_s=${_s#"${_s%%[!	 ]*}"}   # drop the blanks after the colon
			LINK_SIG=${_s%%[	 
]*} ;;
	esac
}

# TESTABLE:parse_gw
# parse_gw <output of `ip route show default dev wlan0`>: sets GW to the first
# default route's gateway, empty when there is none. (The awk it replaces
# printed the third field of any line containing "default", which for a
# gateway-less default route was a word, not an address; a route with no "via"
# now reads, correctly, as no gateway.)
parse_gw() {
	GW=
	case "$1" in
		*"default via "*)
			_g=${1#*default via }
			GW=${_g%%[	 
]*} ;;
	esac
}

# TESTABLE:parse_loss
# parse_loss <output of ping>: sets LOSS to the integer packet-loss %, or 100
# when there is no summary line (ping could not even send) — as the
# `grep -oE '[0-9]+% packet loss' | grep -oE '^[0-9]+' || echo 100` it replaces.
parse_loss() {
	LOSS=100
	case "$1" in
		*"% packet loss"*)
			_l=${1%%"% packet loss"*}
			_l=${_l##*[!0-9]}
			[ -n "$_l" ] && LOSS=$_l ;;
	esac
}

probe_link() { parse_link "$(iw dev "$IFACE" link 2>/dev/null)"; }
probe_gw()   { parse_gw "$(ip route show default dev "$IFACE" 2>/dev/null)"; }
probe_loss() { parse_loss "$(ping -I "$IFACE" -c4 -W2 "$1" 2>/dev/null)"; }

emit()   { printf '%s\n' "$1" >> "$LOG"; LOG_LINES=$((LOG_LINES + 1)); }
assoc()  { probe_link; [ "$LINK_ASSOC" = yes ]; }
signal() { probe_link; echo "$LINK_SIG"; }
gw()     { probe_gw; echo "$GW"; }
# NetworkManager's numeric device state for wlan0 ("30 (disconnected)" -> 30);
# empty when NM is not answering, which is treated like "not ours".
nm_state() { nmcli -g GENERAL.STATE device show "$IFACE" 2>/dev/null | cut -d' ' -f1; }

# integer packet-loss % pinging $1 over wlan0 (100 if unpingable)
loss_to() { probe_loss "$1"; echo "$LOSS"; }

# Keep the log bounded without rewriting it every line — and without re-reading
# it either: LOG_LINES is counted once at start (below) and kept by emit(). A
# `wc -l` over a 15 k-line file here cost 61 ms at 350 MHz on every check.
cap_log() {
	if [ "$LOG_LINES" -gt "$CAP" ]; then
		tail -n $((CAP / 2)) "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
		LOG_LINES=$(wc -l < "$LOG" 2>/dev/null || echo 0)
	fi
}

# TESTABLE:down_action
# down_action <nm-device-state> <consecutive-down-checks> [threshold]
# What to do about a wlan0 that is not associated. Prints one word:
#   leave      not ours: NM has no device (unmanaged 10 / unavailable 20 — radio
#              off, driver gone), or is already between prepare (40) and
#              activated (100), or is not answering at all
#   wait       plainly disconnected (30) — or just failed (120), which NM turns
#              into 30 by itself — but not for long enough yet
#   reconnect  disconnected for the threshold: autoconnect is not going to do it
down_action() {
	_st=${1:-}; _n=${2:-0}; _thr=${3:-${DOWN_TO_RECONNECT:-4}}
	case "$_st" in
		30|120)
			if [ "$_n" -ge "$_thr" ]; then echo reconnect; else echo wait; fi ;;
		*)
			echo leave ;;
	esac
}

# Bring wlan0 back by hand. `nmcli device connect` re-enables autoconnect on the
# device AND activates the best available profile; it needs the SSID in NM's scan
# cache, so scan first — an empty cache is exactly how the 2026-08-30 heal died.
# Prints "yes" when wlan0 is associated afterwards, "no" otherwise.
connect_wlan() {
	nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1
	sleep 5
	nmcli device connect "$IFACE" >/dev/null 2>&1
	_rc=$?
	sleep 8
	if assoc; then echo yes; else
		# One retry: the first rescan may have been rejected ("scan trigger
		# already pending") or the connect raced the scan results.
		[ "$_rc" -ne 0 ] && nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1
		sleep 8
		nmcli device connect "$IFACE" >/dev/null 2>&1
		sleep 8
		if assoc; then echo yes; else echo no; fi
	fi
}

# TESTABLE:repairs_in
# repairs_in <state-file>: the number of repairs already recorded this boot, 0
# when there is no file yet or it cannot be read. Read once at start, so a
# restarted watchdog keeps counting instead of silently resetting to zero.
repairs_in() {
	_n=$(sed -n 's/.*"repairs":\([0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -n 1)
	echo "${_n:-0}"
}

# TESTABLE:repair_ok
# repair_ok <associated yes|no> <loss-after %> <bad-loss threshold>: "true" when
# the repair left wlan0 associated with a usable link, "false" otherwise.
repair_ok() {
	if [ "$1" = yes ] && [ "$2" -lt "$3" ]; then echo true; else echo false; fi
}

# TESTABLE:write_state
# write_state <file> <repairs> [<kind> <ok> <uptime-s>]: replace the state file
# as a whole (tempfile + rename) so nexusq-mqtt never reads half a document.
# Without the last three arguments it records the count alone (no repair yet).
write_state() {
	if [ $# -ge 5 ]; then
		_body="\"repairs\":$2,\"last_kind\":\"$3\",\"last_ok\":$4,\"last_uptime\":$5"
	else
		_body="\"repairs\":$2"
	fi
	printf '{%s}\n' "$_body" > "$1.tmp" && mv -f "$1.tmp" "$1"
}

# TESTABLE:escalation
# escalation <failed-repairs-in-a-row> <chip-resets-tried> [reset-after] [reboot-after]
# Which rung of the ladder the next repair stands on: soft (the nmcli bounce /
# reconnect), reset (power-cycle the chip) or reboot. One rung per failed repair;
# the caller zeroes both counts when a repair works or the link is seen healthy.
escalation() {
	_f=${1:-0}; _r=${2:-0}; _ra=${3:-${RESET_AFTER:-2}}; _rb=${4:-${REBOOT_AFTER:-2}}
	if [ "$_f" -lt "$_ra" ]; then echo soft
	elif [ "$_r" -lt "$_rb" ]; then echo reset
	else echo reboot; fi
}

# TESTABLE:reboot_allowed
# reboot_allowed <uptime-s> <other-route yes|no> <reboots-in-a-row> [min-uptime] [max-reboots]
# Prints "yes", or the reason a reboot must not happen: other-route (something
# else still reaches the box, so wlan0 is not worth a reboot), young (it has not
# been up long enough to tell a wedge from a slow boot), limit (it already
# rebooted this many times in a row without the link ever staying healthy — a
# box that cannot be fixed must not reboot-loop).
reboot_allowed() {
	_u=${1:-0}; _o=${2:-no}; _n=${3:-0}; _mu=${4:-${MIN_UPTIME:-600}}; _mx=${5:-${MAX_REBOOTS:-3}}
	if [ "$_o" = yes ]; then echo other-route
	elif [ "$_u" -lt "$_mu" ]; then echo young
	elif [ "$_n" -ge "$_mx" ]; then echo limit
	else echo yes; fi
}

# TESTABLE:other_route
# other_route <output of `ip route show default`>: "yes" when a default route
# runs over an interface other than wlan0 (ethernet, the USB gadget).
other_route() {
	_other=no
	while IFS= read -r _l; do
		case "$_l" in
			*"default "*) case "$_l" in *"dev wlan0"*) ;; *) _other=yes ;; esac ;;
		esac
	done <<EOF
$1
EOF
	echo "$_other"
}

# The SDIO host wlan0's chip hangs off ("480d5000.mmc"), read from the device
# link while wlan0 still exists; the configured one otherwise.
mmc_host_of() {
	_p=$(readlink -f "/sys/class/net/$IFACE/device" 2>/dev/null)
	case "$_p" in
		*/mmc_host/*) _p=${_p%/mmc_host/*}; echo "${_p##*/}" ;;
		*)            echo "$MMC_HOST" ;;
	esac
}

# Power-cycle the chip. NetworkManager cannot: the driver cannot talk to a chip
# that stopped answering on SDIO. Unloading brcmfmac, then unbinding and
# rebinding the SDIO host controller makes the kernel run the host's mmc-pwrseq
# (bcm4330-pwrseq pulses the chip's reset line), and the reload downloads the
# firmware afresh. Every step is bounded by `timeout`: a dead chip makes some of
# them slow, none may hold the watchdog forever.
chip_reset() {
	_host=$(mmc_host_of)
	_drv=/sys/bus/platform/drivers/omap_hsmmc
	timeout -k 5 40 modprobe -r brcmfmac_wcc brcmfmac >/dev/null 2>&1
	if [ -e "$_drv/$_host" ]; then
		echo "$_host" > "$_drv/unbind" 2>/dev/null
		sleep 2
		echo "$_host" > "$_drv/bind" 2>/dev/null
		sleep 2
	fi
	timeout -k 5 40 modprobe brcmfmac >/dev/null 2>&1
	_i=0
	while [ ! -e "/sys/class/net/$IFACE" ] && [ "$_i" -lt 30 ]; do sleep 1; _i=$((_i + 1)); done
	sleep 3                       # let NetworkManager adopt the new device first
	connect_wlan
}

# Count a finished repair, publish it through the state file, and move the
# ladder: a repair that left a usable link zeroes it, a failed one climbs a rung.
record_repair() {  # <kind> <associated yes|no> <loss-after %>
	repairs=$((repairs + 1))
	_ok=$(repair_ok "$2" "$3" "$BAD_LOSS")
	write_state "$STATE" "$repairs" "$1" "$_ok" "$(mono)"
	if [ "$_ok" = true ]; then
		failed_repairs=0; chip_resets=0
	else
		failed_repairs=$((failed_repairs + 1))
	fi
}

# The reboot rung. Counts the reboot on the persist partition BEFORE going down
# (so a crash right after still counts) and leaves the reason in the log.
wifi_reboot() {
	emit "{\"t\":$(mono),\"ev\":\"reboot\",\"reboots\":$((reboots + 1)),\"note\":\"chip reset failed $chip_resets times and nothing else reaches the box\"}"
	printf '%s\n' "$((reboots + 1))" > "$REBOOTS_FILE" 2>/dev/null
	sync
	systemctl reboot 2>/dev/null || reboot
	sleep 60
}

# Pick and run the repair for this moment. <soft> is the function the caller
# wants at the bottom rung (heal or reconnect), with its arguments after it.
do_repair() {
	_soft=$1; shift
	_rung=$(escalation "$failed_repairs" "$chip_resets")
	if [ "$_rung" = reboot ]; then
		_why=$(reboot_allowed "$(mono)" "$(other_route "$(ip route show default 2>/dev/null)")" "$reboots")
		if [ "$_why" = yes ]; then wifi_reboot; return; fi
		emit "{\"t\":$(mono),\"ev\":\"reboot_skipped\",\"why\":\"$_why\"}"
		_rung=reset
	fi
	case "$_rung" in
		reset)
			chip_resets=$((chip_resets + 1))
			sig=$(signal)
			emit "{\"t\":$(mono),\"ev\":\"chip_reset\",\"n\":$chip_resets,\"failed_repairs\":$failed_repairs,\"sig\":\"${sig:-?}\",\"note\":\"nmcli repairs did not bring wlan0 back; power-cycling the BCM4330\"}"
			up=$(chip_reset)
			g=$(gw); after=100; [ -n "$g" ] && after=$(loss_to "$g")
			emit "{\"t\":$(mono),\"ev\":\"chip_reset_result\",\"assoc\":\"$up\",\"loss_after\":$after,\"gw\":\"${g:-?}\"}"
			record_repair reset "$up" "$after" ;;
		*)
			"$_soft" "$@" ;;
	esac
}

heal() {
	loss="$1"; sig=$(signal)
	emit "{\"t\":$(mono),\"ev\":\"heal\",\"loss\":$loss,\"sig\":\"${sig:-?}\",\"note\":\"bounce wlan0 after $FAILS_TO_HEAL bad checks\"}"
	nmcli device disconnect "$IFACE" >/dev/null 2>&1
	sleep 2
	up=$(connect_wlan)
	g=$(gw); after=100; [ -n "$g" ] && after=$(loss_to "$g")
	emit "{\"t\":$(mono),\"ev\":\"heal_result\",\"assoc\":\"$up\",\"loss_after\":$after,\"gw\":\"${g:-?}\"}"
	record_repair heal "$up" "$after"
}

reconnect() {
	st="$1"; n="$2"; sig=$(signal)
	emit "{\"t\":$(mono),\"ev\":\"reconnect\",\"nm\":\"$st\",\"downs\":$n,\"sig\":\"${sig:-?}\",\"note\":\"wlan0 disconnected for $n checks; autoconnect is not coming\"}"
	up=$(connect_wlan)
	g=$(gw); after=100; [ -n "$g" ] && after=$(loss_to "$g")
	emit "{\"t\":$(mono),\"ev\":\"reconnect_result\",\"assoc\":\"$up\",\"loss_after\":$after,\"gw\":\"${g:-?}\"}"
	record_repair reconnect "$up" "$after"
}

LOG_LINES=$(wc -l < "$LOG" 2>/dev/null || echo 0)
fails=0
downs=0
last_heal=0
repairs=$(repairs_in "$STATE")
failed_repairs=0      # consecutive repairs that left no usable link (the ladder's input)
chip_resets=0         # chip resets tried since the link was last healthy
okstreak=0            # consecutive healthy checks (clears the reboot count)
reboots=$(cat "$REBOOTS_FILE" 2>/dev/null); reboots=${reboots:-0}
case "$reboots" in *[!0-9]*) reboots=0 ;; esac
# First start this boot: publish "0 repairs" so a reader can tell a running
# watchdog with nothing to report from one that is not running at all.
[ -f "$STATE" ] || write_state "$STATE" 0
# This boot is the watchdog's own doing: the reboot rung wrote the marker before
# going down. /run is tmpfs, so without this Home Assistant would show a fresh
# boot with nothing to report, hiding that the link had been dead long enough
# for a reboot. The count is only cleared once the link has stayed healthy.
if [ "$reboots" -gt 0 ] && [ "$repairs" -eq 0 ]; then
	repairs=1
	write_state "$STATE" 1 reboot true "$(mono)"
	emit "{\"t\":$(mono),\"ev\":\"boot_after_wifi_reboot\",\"reboots\":$reboots}"
fi
prev_st=""
tick=0
emit "{\"t\":$(mono),\"ev\":\"start\",\"interval\":$INTERVAL,\"fails_to_heal\":$FAILS_TO_HEAL,\"cooldown\":$HEAL_COOLDOWN,\"downs_to_reconnect\":$DOWN_TO_RECONNECT,\"heartbeat_every\":$HEARTBEAT_EVERY,\"repairs\":$repairs}"

while :; do
	tick=$((tick + 1))
	probe_link              # one `iw` for both assoc and signal
	sig=$LINK_SIG
	loss=-1
	if [ "$LINK_ASSOC" != yes ]; then
		st=down; fails=0
		nm=$(nm_state)
		act=$(down_action "$nm" $((downs + 1)))
		# Only a plainly-disconnected device accumulates towards a reconnect; an
		# NM that is busy, or has no device, resets the count — those are not
		# the stranded case, and reconnecting into them would fight NM.
		if [ "$act" = leave ]; then downs=0; else downs=$((downs + 1)); fi
		now_s
		line="{\"t\":$NOW,\"st\":\"down\",\"sig\":\"${sig:-?}\",\"nm\":\"${nm:-?}\",\"downs\":$downs}"
	else
		downs=0
		probe_gw
		g=$GW
		if [ -z "$g" ]; then
			# Associated but NO default route/gateway: NetworkManager wedged in
			# "getting IP configuration" (DHCP got no lease), so wlan0 has an IP
			# but no route and the LAN is unreachable. This IS the associated-
			# but-dead wedge — count it like a bad check so the heal fires; the
			# old code held fails=0 here and so NEVER healed this exact case.
			fails=$((fails + 1)); st=nogw
			now_s
			line="{\"t\":$NOW,\"st\":\"nogw\",\"sig\":\"${sig:-?}\",\"fails\":$fails}"
		else
			probe_loss "$g"
			loss=$LOSS
			if [ "$loss" -ge "$BAD_LOSS" ]; then
				fails=$((fails + 1)); st=bad
			else
				fails=0; st=ok
			fi
			now_s
			line="{\"t\":$NOW,\"st\":\"$st\",\"loss\":$loss,\"sig\":\"${sig:-?}\",\"fails\":$fails}"
		fi
	fi

	# Log every non-ok check and every state change in full; thin only the
	# steady "ok" stream to one heartbeat per HEARTBEAT_EVERY checks.
	if [ "$st" != ok ] || [ "$st" != "$prev_st" ] || [ $((tick % HEARTBEAT_EVERY)) -eq 0 ]; then
		emit "$line"
	fi
	prev_st="$st"

	# A healthy link zeroes the ladder, and once it has stayed healthy for a
	# while the persisted reboot count goes too (a recovered box may reboot
	# again for a future wedge; one that never recovers may not loop).
	if [ "$st" = ok ]; then
		failed_repairs=0; chip_resets=0
		okstreak=$((okstreak + 1))
		if [ "$okstreak" -ge "$OK_TO_CLEAR" ] && [ "$reboots" -gt 0 ]; then
			rm -f "$REBOOTS_FILE"; reboots=0
			emit "{\"t\":$(mono),\"ev\":\"reboot_count_cleared\"}"
		fi
	else
		okstreak=0
	fi

	now_s
	now=$NOW
	if { [ "$st" = bad ] || [ "$st" = nogw ]; } && [ "$fails" -ge "$FAILS_TO_HEAL" ]; then
		if [ $((now - last_heal)) -ge "$HEAL_COOLDOWN" ]; then
			do_repair heal "$loss"
			last_heal=$(mono)
			fails=0
		fi
	elif [ "$st" = down ] && [ "$act" = reconnect ]; then
		if [ $((now - last_heal)) -ge "$HEAL_COOLDOWN" ]; then
			do_repair reconnect "$nm" "$downs"
			last_heal=$(mono)
			downs=0
		fi
	fi
	cap_log
	sleep "$INTERVAL"
done
