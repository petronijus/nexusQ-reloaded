[Unit]
Description=Nexus Q WiFi watchdog (BCM4330 wedge auto-heal + health log)
Documentation=file:///usr/bin/nexusq-wifi-watchdog
# NetworkManager owns wlan0; we only heal the associated-but-dead wedge it can't see.
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/nexusq-wifi-watchdog
# Self-heal: the watchdog itself must never die silently.
Restart=always
RestartSec=10
# Stay out of the way on this dual-core OMAP4.
# 19 since 2026-08-16: with `ignore_nice_load=1` on the conservative
# governor (nexusq-cpufreq-tune drop-in) nice time is credited as idle, so
# this background daemon no longer drives the CPU frequency; the audio path
# is never nice'd and still ramps instantly.
# docs/2026-08-16-idle-700mhz-deep-analysis.md
Nice=19
IOSchedulingClass=idle
# Logs live under /var/log/nq-health (self-rotated, capped).

[Install]
WantedBy=multi-user.target
