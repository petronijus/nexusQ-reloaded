#!/bin/sh
# nq-diag-snapshot — comprehensive, read-only "log everything" state dump for the
# Nexus Q (steelhead). One self-contained snapshot of every subsystem we care
# about (compute, power, thermal, clocks, LED/AVR, USB, net, kernel log, pstore)
# so a single capture is enough to reason about almost any fault after the fact.
#
# Pure POSIX sh / busybox-safe. Every probe is wrapped so a slow/blocking sysfs
# read can never hang the whole snapshot. Nothing here writes device state.
#
# Usage:
#   nq-diag-snapshot            # full dump to stdout
#   nq-diag-snapshot FILE       # full dump to FILE
#   nq-diag-snapshot --brief    # one-screen health line (for tty1 / quick look)

TO="${NQ_TIMEOUT:-5}"            # per-command timeout (s)
have() { command -v "$1" >/dev/null 2>&1; }
t() { if have timeout; then timeout "$TO" "$@"; else "$@"; fi; }

sec() { printf '\n==================== %s ====================\n' "$*"; }
sub() { printf '\n--- %s ---\n' "$*"; }
# run a command, labelled, never fatal
run() { sub "$*"; t "$@" 2>&1 || echo "(failed: $*)"; }
# cat a file/glob if present
catf() { for f in "$@"; do [ -e "$f" ] && { printf '# %s\n' "$f"; t cat "$f" 2>&1; }; done; }

# Ask the manager a unit actually LIVES in. librespot (and the rest of the audio
# chain) are USER units under uid 10000; asking the system manager about them
# returns a confident "inactive/dead" for a perfectly healthy player. This
# snapshot printed exactly that on 2026-09-16 while librespot was running as
# pid 630 — a diagnostic reporting a dead service that is alive is worse than
# one reporting nothing, because it sends the next reader hunting a fault that
# does not exist.
#
# Do NOT reach for `systemctl -M user@` here. That transport routes through
# systemd-run + systemd-stdio-bridge and opens a full PAM LOGIN SESSION on every
# call — the 5-minute churn removed from nq-healthd in device r99. Dropping to
# the uid first opens nothing.
NQ_USER_UID="${NQ_USER_UID:-10000}"
sctl() {   # sctl <system|user> <systemctl args ...>
	_scope="$1"; shift
	if [ "$_scope" = user ]; then
		if have setpriv; then
			t setpriv --reuid="$NQ_USER_UID" --regid="$NQ_USER_UID" --clear-groups \
				env XDG_RUNTIME_DIR="/run/user/$NQ_USER_UID" \
				systemctl --user "$@" 2>/dev/null
		else
			# honest beats confident: "unknown" is what we know, "inactive"
			# would be the same lie this helper exists to stop telling.
			echo unknown
		fi
	else
		t systemctl "$@" 2>/dev/null
	fi
}
unit_scope() {
	case "$1" in
		librespot|pulseaudio|pipewire|wireplumber|shairport-sync|nexusq-uac2-in|nq-uac2-silence) echo user ;;
		*) echo system ;;
	esac
}

brief() {
	C=/sys/devices/system/cpu/cpu0/cpufreq
	echo "freq=$(cat $C/scaling_cur_freq 2>/dev/null)kHz/$(cat $C/scaling_governor 2>/dev/null) x$(nproc 2>/dev/null) temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)mC nexusqd=$(systemctl is-active nexusqd 2>/dev/null) librespot=$(sctl user is-active librespot) load=$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null)"
}

snapshot() {
printf '########## NEXUS Q SNAPSHOT ##########\n'
echo "captured(mono uptime)=$(cut -d. -f1 /proc/uptime 2>/dev/null)s  wall=$(date 2>/dev/null)"

sec SYSTEM
run uname -a
catf /proc/cmdline /proc/version
run uptime
sub "memory"; catf /proc/meminfo
run df -h

sec CPU
echo "nproc=$(nproc 2>/dev/null)"
catf /proc/loadavg
sub "per-cpu cpufreq"
for c in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
	printf '# %s\n' "$c"
	for a in scaling_governor scaling_cur_freq scaling_min_freq scaling_max_freq \
	         scaling_available_frequencies scaling_available_governors scaling_driver \
	         cpuinfo_cur_freq related_cpus; do
		printf '  %-30s %s\n' "$a" "$(cat "$c/$a" 2>/dev/null)"
	done
done
sub "cpufreq stats (if enabled)"; catf /sys/devices/system/cpu/cpu0/cpufreq/stats/time_in_state
catf /proc/cpuinfo

sec CLOCKS
sub "clk_summary"; catf /sys/kernel/debug/clk/clk_summary
sub "key DPLLs"
catf /sys/kernel/debug/clk/dpll_mpu_ck/clk_rate /sys/kernel/debug/clk/dpll_core_ck/clk_rate \
     /sys/kernel/debug/clk/dpll_per_ck/clk_rate /sys/kernel/debug/clk/auxclk3_ck/clk_rate

sec POWER_REGULATORS
sub "all regulators"
for r in /sys/class/regulator/regulator.*; do
	n=$(cat "$r/name" 2>/dev/null); [ -n "$n" ] || continue
	printf '%-18s state=%-9s %suV  users=%s type=%s\n' \
		"$n" "$(cat "$r/state" 2>/dev/null)" "$(cat "$r/microvolts" 2>/dev/null)" \
		"$(cat "$r/num_users" 2>/dev/null)" "$(cat "$r/type" 2>/dev/null)"
done
sub "regulator_summary (debugfs)"; catf /sys/kernel/debug/regulator/regulator_summary
sub "vdd_mpu vs OPP expectation"
cur=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)
case "$cur" in 350000) exp=1025000;; 700000) exp=1203000;; 920000) exp=1317000;; 1200000) exp=1380000;; *) exp=0;; esac
vdd=$(for r in /sys/class/regulator/regulator.*; do [ "$(cat $r/name 2>/dev/null)" = vdd_mpu ] && cat $r/microvolts 2>/dev/null; done)
echo "vdd_mpu=${vdd}uV expected=${exp}uV for ${cur}kHz (OPP 350/1025 700/1203 920/1317 1200/1380)"

sec THERMAL
for z in /sys/class/thermal/thermal_zone*; do
	printf '# %s  type=%s temp=%smC mode=%s policy=%s\n' "$z" \
		"$(cat $z/type 2>/dev/null)" "$(cat $z/temp 2>/dev/null)" \
		"$(cat $z/mode 2>/dev/null)" "$(cat $z/policy 2>/dev/null)"
	for tp in $z/trip_point_*; do printf '  %s=%s\n' "$(basename $tp)" "$(cat $tp 2>/dev/null)"; done
done
sub "cooling devices"
for cd in /sys/class/thermal/cooling_device*; do
	printf '%s: %s/%s (%s)\n' "$(basename $cd)" "$(cat $cd/cur_state 2>/dev/null)" \
		"$(cat $cd/max_state 2>/dev/null)" "$(cat $cd/type 2>/dev/null)"
done

sec GPU_SGX540
# Read-only, cheap (docs/gpu-sgx540/power-clocks-pm.md section 8.1): sysfs and
# debugfs reads only. No access to the SGX registers -- a read of a powered-down
# L3 target can abort the bus -- and no /proc/tty/driver (it hung a unit).
sub "driver"; lsmod 2>/dev/null | grep -iE '^pvr|sgx' || echo "(SGX module not loaded)"
sub "drm devices"; t sh -c 'for c in /sys/class/drm/card*; do [ -e "$c/device/driver" ] && echo "$(basename "$c") $(basename "$(readlink "$c/device/driver")")"; done' 2>/dev/null
sub "target module runtime PM"
for f in runtime_status runtime_active_time runtime_suspended_time control; do
	printf '%s=' "$f"; t cat "/sys/devices/platform/ocp/5600fe00.target-module/power/$f" 2>/dev/null || echo "?"
done
sub "genpd prm_gfx"
for f in current_state active_time total_idle_time; do
	printf '%s=' "$f"; t cat "/sys/kernel/debug/pm_genpd/prm_gfx/$f" 2>/dev/null || echo "?"
done
sub "gfx_pwrdm counters"; t sh -c 'grep -E "gfx_pwrdm" /sys/kernel/debug/pm_debug/count /sys/kernel/debug/pm_debug/time' 2>/dev/null
# Expect l3-gfx-clkctrl:0000:24 under dpll_per_m7x2_ck at 307200000 (nq-health-report checks it).
sub "gpu clock"
t grep -E 'dpll_(core|per)_m7x2_ck|l3-gfx-clkctrl' /sys/kernel/debug/clk/clk_summary 2>/dev/null
sub "gpu irq"; grep -iE 'sgx|pvr' /proc/interrupts 2>/dev/null || echo "(no SGX interrupt registered)"
sub "userspace (fetched per unit)"
if [ -e /var/lib/sgx-ddk/lib/.complete ]; then echo "DDK blobs complete: $(ls /var/lib/sgx-ddk/lib | tr '\n' ' ')"; else echo "DDK blobs NOT complete"; fi
[ -e /etc/nexusq/gpu-off ] && echo "kill switch /etc/nexusq/gpu-off is SET"
for u in nexusq-sgx.service nq-sgx-fetch.service nq-sgx-fetch.timer; do echo "$u $(t systemctl is-active "$u" 2>/dev/null)"; done
sub "desktop session renderer"; t sh -c 'grep -h "nexusq-desktop-session" /home/*/.local/state/tinydm.log 2>/dev/null | tail -2'
sub "gpu kernel log"; dmesg 2>/dev/null | grep -iE 'pvr|sgx|56000000' | tail -20

sec LED_AVR_NEXUSQD
sub "nexusqd / librespot units"
for u in nexusqd librespot; do
	sc="$(unit_scope $u)"
	echo "$u [$sc]: active=$(sctl $sc is-active $u) sub=$(sctl $sc show -p SubState --value $u) pid=$(sctl $sc show -p MainPID --value $u) restarts=$(sctl $sc show -p NRestarts --value $u) watchdog=$(sctl $sc show -p WatchdogUSec --value $u)"
done
run nexusled status
sub "nexusqd recent journal"; t journalctl -u nexusqd --no-pager -n 40 2>/dev/null || echo "(no journal)"
sub "AVR interrupt"; grep -i steelhead-avr /proc/interrupts 2>/dev/null
sub "all LED brightness (ring 0..31 + mute)"
for l in /sys/class/leds/steelhead:rgb:*; do
	printf '%-26s b=%s max=%s trig=%s\n' "$(basename $l)" \
		"$(cat $l/brightness 2>/dev/null)" "$(cat $l/max_brightness 2>/dev/null)" \
		"$(sed -n 's/.*\[\(.*\)\].*/\1/p' $l/trigger 2>/dev/null)"
done
sub "AVR device attrs"; catf /sys/bus/i2c/devices/2-0020/commit_mode

sec USB
run ls /sys/bus/usb/devices/
sub "gadget configfs"
catf /sys/kernel/config/usb_gadget/g1/UDC /sys/kernel/config/usb_gadget/g1/idVendor /sys/kernel/config/usb_gadget/g1/idProduct
sub "gadget functions / config links"; t ls -l /sys/kernel/config/usb_gadget/g1/functions /sys/kernel/config/usb_gadget/g1/configs/c.1 2>/dev/null
sub "ehci/musb dmesg"; dmesg 2>/dev/null | grep -iE "ehci|musb|hsusb|otg|usb[0-9]" | tail -20

sec ETHERNET
run ip -s link show eth0
have ethtool && run ethtool eth0
sub "eth/phy dmesg"; dmesg 2>/dev/null | grep -iE "phy|smsc|lan95|eth|mdio" | tail -20

sec NETWORK
run ip -br addr
run ip route
have nmcli && run nmcli -t -f NAME,TYPE,DEVICE,STATE con show
have ss && run ss -tlnp

sec GPIO_PINMUX
sub "gpio"; catf /sys/kernel/debug/gpio
sub "pinmux (active pins)"; t sh -c 'cat /sys/kernel/debug/pinctrl/*/pinmux-pins 2>/dev/null | grep -v "UNCLAIMED" | head -120'

sec INTERRUPTS
catf /proc/interrupts

sec SYSTEMD
run systemctl --failed --no-legend
sub "running units"; t systemctl list-units --type=service --state=running --no-legend 2>/dev/null

sec PSTORE
# NOT /sys/fs/pstore: systemd-pstore.service copies every record into the archive
# below at boot and unlinks it from pstorefs, so pstorefs is empty within a second
# of boot whatever happened. The archive is cumulative across boots.
if [ -n "$(ls /var/lib/systemd/pstore 2>/dev/null)" ]; then
	find /var/lib/systemd/pstore -type f | while read -r f; do sub "$f"; t cat "$f" 2>&1; done
elif [ -n "$(ls /sys/fs/pstore 2>/dev/null)" ]; then
	# systemd-pstore disabled or not yet run: still where the kernel left them
	for f in /sys/fs/pstore/*; do sub "$f"; t cat "$f" 2>&1; done
else
	echo "(empty — no crash dumps archived on this unit)"
fi

sec PROCESSES
run ps w

sec KERNEL_LOG_FULL
t dmesg 2>&1

printf '\n########## SNAPSHOT END ##########\n'
}

case "${1:-}" in
	--brief) brief ;;
	"" )     snapshot ;;
	* )      snapshot > "$1" 2>&1; echo "snapshot written to $1" >&2 ;;
esac
