#!/bin/sh
# nq-healthd — Nexus Q (steelhead) runtime health monitor
#
# Samples the compute/power/LED subsystems at a fixed interval and appends one
# JSON object per line (JSONL) to a rotating log. A second "events" log records
# only anomalies (threshold trips, state changes) so a later failure — e.g. the
# LED ring "rotation" freezing — can be correlated against what cpufreq, the
# regulators, thermal and nexusqd were doing at that moment.
#
# Pure POSIX sh / busybox-safe (the device shell is /bin/ash). No bashisms.
#
# THE IDLE GOAL this daemon measures against:
#   With every streaming service off and nothing playing — the Q just sitting
#   there asleep — the CPU should spend as close to 100 % of the time at
#   350 MHz as possible, and an absolute minimum at any higher OPP. Every
#   idle-power change is judged against that number, so the number has to be
#   trustworthy: read it from `opp_ms` (kernel counters), never from `freq`
#   (a biased spot sample — see opp_sample). Baseline to beat: 60.5 % @ 350 MHz
#   (v1.12.0/r70, 14 h overnight window, 2026-08-13).
#
# Why these signals (all verified against the live device + repo, not guessed):
#   - nexusqd drives the LED ring and has NO systemd watchdog, so a *hang*
#     (vs a crash, which Restart=on-failure already covers) goes unnoticed.
#     We detect it two ways: control-socket responsiveness (nexusled status)
#     AND forward progress of the daemon's CPU time + the LED frame changing.
#   - vdd_mpu should track the current OPP's voltage; a mismatch points at the
#     VC-bridge / TPS62361 power path (path B). We log expected-vs-actual.
#   - thermal trips are 100 C (passive throttle) / 125 C (critical).
#   - the device RTC is wrong (year 2000), so the authoritative timestamp is the
#     monotonic uptime; wall-clock is logged best-effort for human reference.
#   - per-OPP residency + transition count, differenced from the kernel's own
#     cpufreq stats, is the ONLY honest read on the idle goal above.
#
# This daemon must not distort what it measures. It runs forever on the device
# it is judging, so every probe here is chosen for cost first. r71 FORK DIET:
# the 2026-08-13 attribution (docs/2026-08-13-idle-opp-residency-measurement.md)
# measured this daemon at ~6.3 % of a core — ~0.6 % the shell itself and
# ~5.7 % its forked children (~35-40 processes per 5 s tick), the single
# biggest idle consumer on the box. Every probe that CAN be a builtin now IS
# one (`read` from sysfs/procfs instead of $(cat), parameter expansion instead
# of cut/awk, glob counting instead of ls|wc), the LED frame is fingerprinted
# in ONE od|awk pass instead of md5sum+od+awk, dmesg is scanned every
# NQ_DMESG_EVERY ticks instead of every tick, log rotation is checked once a
# minute, and the inter-sample sleep is a fork-free `read -t` on a private
# fifo fd. Steady-state cost: ~6 forks/tick (date, od+awk, timeout+nexusled),
# everything else amortized.
#
# Usage:
#   nq-healthd                # daemon: loop forever, append to $LOG
#   nq-healthd --once         # emit a single sample to stdout and exit
#                             # (opp_ms is {} — residency needs two samples)
#   NQ_INTERVAL=2 nq-healthd  # override sample interval (seconds, default 5)
#   NQ_UNIT_REFRESH_S=60      # how often a stopped unit is re-asked systemd
#   NQ_DMESG_EVERY=6          # scan dmesg every Nth tick (default 6 = 30 s)

set -u

INTERVAL="${NQ_INTERVAL:-5}"
LOGDIR="${NQ_LOGDIR:-/var/log/nq-health}"
LOG="$LOGDIR/health.jsonl"
EVENTS="$LOGDIR/events.jsonl"
MAXBYTES="${NQ_MAXBYTES:-4194304}"   # rotate health.jsonl past 4 MiB
DMESG_EVERY="${NQ_DMESG_EVERY:-6}"   # dmesg ring scan cadence, in ticks
ROT_EVERY=12                         # rotation stat() cadence, in ticks
# How long nexusqd's CPU time may stand still before `nq_progress` calls it
# wedged. Must stay far above the daemon's idle tick rate — see nq_progress.
PROGRESS_STALE_S="${NQ_PROGRESS_STALE_S:-60}"

# --- fork-free single-line file read ------------------------------------------
# Replaces $(cat file): sets $RDV to the first line, "" when unreadable. The
# `|| :` matters — busybox read returns 1 on EOF-without-newline with the value
# already in RDV, and a vanished /proc entry must not kill the tick (set -u is
# on, but set -e is not; the redirect error is silenced before the open).
rdv() {
	RDV=""
	[ -r "$1" ] || return 1
	IFS= read -r RDV 2>/dev/null < "$1" || :
	return 0
}

# --- expected VDD_MPU (uV) per OPP frequency (kHz). From omap4-steelhead.dts. -
# Sets $VEXP; a function-call subshell per tick was one more needless fork.
opp_voltage() {
	case "$1" in
		350000)  VEXP=1025000 ;;
		700000)  VEXP=1203000 ;;
		920000)  VEXP=1317000 ;;
		1200000) VEXP=1380000 ;;
		*)       VEXP=0 ;;
	esac
}

# Resolve a regulator's sysfs dir once by its name attribute (dirs are
# regulator.N with an opaque index; the stable key is the "name" file).
reg_dir() {
	for d in /sys/class/regulator/regulator.*; do
		rdv "$d/name"
		[ "$RDV" = "$1" ] && { echo "$d"; return 0; }
	done
	return 1
}

# JSON string escaper (minimal: backslash and double-quote). Only events pass
# through here, and only messages that actually contain a metachar pay the sed.
jstr() {
	case "$1" in
		*\"*|*\\*) printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' ;;
		*)         printf '%s' "$1" ;;
	esac
}

# --- resolve stable paths/indices once at startup -----------------------------
CPUFREQ=/sys/devices/system/cpu/cpu0/cpufreq
TZ0=/sys/class/thermal/thermal_zone0
COOL0=/sys/class/thermal/cooling_device0
VDD_DIR="$(reg_dir vdd_mpu || true)"
ABB_DIR="$(reg_dir abb_mpu || true)"
# steelhead-avr IRQ line (GPIO edge); match by the "steelhead-avr" name column.
AVR_IRQ_RE='steelhead-avr'
# LED frame source. nexusqd renders exclusively through the AVR driver's
# `frame` bin_attr, so the per-LED classdev brightness files stay 0 under it —
# fingerprinting those reported a permanently frozen ring (false CRIT, found
# 2026-07-03). Kernel patch 0029 makes `frame` readable; prefer it, keep the
# brightness loop only as a fallback for pre-0029 kernels (where led_frozen
# is then structurally unreliable under nexusqd r5+).
FRAME_ATTR=""
for f in /sys/bus/i2c/devices/*/frame; do
	[ -e "$f" ] || continue
	if head -c 96 "$f" >/dev/null 2>&1; then FRAME_ATTR="$f"; fi
	break
done
# A representative spread of ring LEDs for the brightness FALLBACK fingerprint.
LED_SAMPLE="0 4 8 12 16 20 24 28"

# cpufreq residency counters (kernel-authoritative; see opp_sample).
TIS="$CPUFREQ/stats/time_in_state"
TRANS="$CPUFREQ/stats/total_trans"

# A unit runs iff its cgroup holds processes — an instant, fork-free read that
# replaces the per-sample `systemctl` probe (see the cached-unit-state notes).
# uid 10000 is fixed (the appliance user); librespot is a USER unit since r31.
NQ_CGROUP=/sys/fs/cgroup/system.slice/nexusqd.service/cgroup.procs
LS_CGROUP=/sys/fs/cgroup/user.slice/user-10000.slice/user@10000.service/app.slice/librespot.service/cgroup.procs
# How often a NOT-running unit may still be asked systemd for its exact state
# (inactive vs failed vs masked) and NRestarts. Transitions refresh immediately.
UNIT_REFRESH_S="${NQ_UNIT_REFRESH_S:-300}"

# rolling state for delta/changed detection
PREV_NEXUSQD_TICKS=-1
NQ_LAST_TICK_MOVE=-1  # t_mono when nexusqd's CPU time last advanced (see nq_progress)
PREV_LED_FP=""
PREV_DMESG_ERR=-1
PREV_NEXUSQD_RESTARTS=-1
PREV_LIBRESPOT_RESTARTS=-1
PREV_NEXUSQD_RESP=-1
PREV_PSTORE=-1
PREV_TIS=""          # "<khz>:<counter>" pairs from the previous sample
PREV_TRANS=-1
NQ_LAST_SHOW=-1      # t_mono of the last systemd query, per unit
LS_LAST_SHOW=-1
LED_STALL=0          # consecutive samples where nexusqd is up but frame frozen
TICKN=0              # tick counter driving the amortized (every-Nth) probes
DERR_CACHE=0         # dmesg error count from the last actual ring scan

# --- cached unit state (process-first monitoring) -----------------------------
# The per-sample liveness check is a /proc read on a cached MainPID; systemd is
# consulted ONLY on transitions (pid unknown / vanished / reused). Polling
# systemctl every sample was the top idle CPU consumer on the box: every root
# systemctl opens pid 1's private bus and forces a full object-tree
# re-registration — 5 execs per 5 s sample held pid 1 at a steady ~3.3 %
# (measured 2026-07-12). A unit restart always changes MainPID, so
# transition-triggered queries still catch every NRestarts bump.
NQ_PID=0;  NQ_ACTIVE=unknown;  NQ_RESTARTS=0
LS_PID=0;  LS_ACTIVE=unknown;  LS_RESTARTS=0
# librespot is a USER unit (uid 10000) since device r31; its manager's private
# socket lives under the user runtime dir. Querying the SYSTEM manager (as this
# script did r31..r38) returned unknown/0 forever — librespot restart detection
# was silently broken — and worse, made pid 1 load+GC the nonexistent unit from
# disk on every poll.
LS_RUNTIME=/run/user/10000

# One bus connection for all three properties, printed as Key=Value lines
# (order-independent parse). The user-scope variant reaches the uid-10000
# manager through its private socket; env is scoped to the subshell only.
nq_show() {
	systemctl show -p ActiveState -p MainPID -p NRestarts nexusqd.service 2>/dev/null
}
ls_show() {
	# root cannot borrow the user's XDG_RUNTIME_DIR: systemd 261 refuses
	# cross-user private-socket connections ("Operation not permitted, consider
	# using --machine=<user>@.host"). -M user@ goes through the sanctioned
	# stdio-bridge path and works (verified on-device 2026-07-13). The runtime
	# dir guard skips the spawn while the user manager isn't up yet.
	[ -d "$LS_RUNTIME/systemd" ] || return 1
	systemctl -M user@ --user show -p ActiveState -p MainPID -p NRestarts librespot.service 2>/dev/null
}
# Fork-free Key=Value extractor over nq_show/ls_show output: sets $SV. The
# $(show_val ...) subshell this replaces cost a fork per property per refresh.
sv() {
	SV=""
	_sv_in="$1"
	_sv_ifs="$IFS"; IFS='
'
	for _sv_line in $_sv_in; do
		case "$_sv_line" in "$2"=*) SV="${_sv_line#*=}"; break ;; esac
	done
	IFS="$_sv_ifs"
	return 0
}

emit_event() {
	# emit_event <mono> <severity> <kind> <message>
	mkdir -p "$LOGDIR"
	printf '{"t_mono":%s,"sev":"%s","kind":"%s","msg":"%s"}\n' \
		"$1" "$2" "$3" "$(jstr "$4")" >> "$EVENTS"
}

rotate_if_big() {
	# stat, not `wc -c`: busybox wc READS the whole file (measured 100 us on a
	# 4 MB log, every sample) where stat just fstats it. Called every ROT_EVERY
	# ticks from the main loop — the log grows ~3.6 kB/min against a 4 MiB cap,
	# so even a once-a-minute check overshoots by under 0.1 %.
	[ -f "$LOG" ] || return 0
	sz=$(stat -c %s "$LOG" 2>/dev/null || echo 0)
	[ "$sz" -gt "$MAXBYTES" ] 2>/dev/null && mv -f "$LOG" "$LOG.1"
	return 0
}

# First PID in a cgroup, or 0. Fork-free (`read` from the file, no subshell) —
# this runs per sample for every monitored unit.
CG_PID=0
cg_pid() {
	CG_PID=0
	[ -r "$1" ] || return 1
	while read -r _cgl; do
		case "$_cgl" in ''|*[!0-9]*) continue ;; esac
		CG_PID="$_cgl"; return 0
	done < "$1"
	return 0
}

# One pass over cgroup.procs that yields BOTH the first PID (CG_PID) and
# whether a given pid is still a member (CG_HAS) — the fork-free restart
# detector: a unit restart replaces every pid in the cgroup, so "cached pid no
# longer a member while the cgroup is non-empty" is exactly a (re)start.
CG_HAS=0
cg_scan() {
	CG_PID=0; CG_HAS=0
	[ -r "$1" ] || return 1
	while read -r _cgl; do
		case "$_cgl" in ''|*[!0-9]*) continue ;; esac
		[ "$CG_PID" = 0 ] && CG_PID="$_cgl"
		[ "$_cgl" = "$2" ] && { CG_HAS=1; return 0; }
	done < "$1"
	return 0
}

# Fork-free /proc/<pid>/stat parse: sets $ST_STATE (field 3) and $ST_TICKS
# (utime+stime, fields 14+15). Replaces two awk forks per tick. The comm field
# can contain spaces, so split only AFTER stripping through the closing paren.
read_stat() {
	ST_STATE="-"; ST_TICKS=0
	[ -r "/proc/$1/stat" ] || return 1
	_sl=""
	IFS= read -r _sl 2>/dev/null < "/proc/$1/stat" || :
	[ -n "$_sl" ] || return 1
	_sr="${_sl##*) }"
	set -- $_sr
	[ $# -ge 13 ] || return 1
	ST_STATE="$1"
	shift 11
	ST_TICKS=$(( $1 + $2 ))
	return 0
}

# --- fork-free inter-sample sleep ---------------------------------------------
# `sleep` is one more fork per tick. A `read -t` on a fifo fd nobody ever
# writes to blocks for exactly the timeout at zero process cost. The fifo is
# unlinked immediately after the fd is opened; fd 9 lives for the daemon's
# lifetime. Probed once at startup — if this busybox lacks read -t (the probe
# returns instantly with an error), fall back to plain sleep rather than
# busy-looping.
TICK_FD=0
init_tick() {
	_fifo="$LOGDIR/.nq-healthd.tick.$$"
	mkdir -p "$LOGDIR"
	if mkfifo "$_fifo" 2>/dev/null; then
		if exec 9<>"$_fifo" 2>/dev/null; then
			_err=$( { IFS= read -r -t 1 _probe <&9; } 2>&1 )
			[ -z "$_err" ] && TICK_FD=1
		fi
		rm -f "$_fifo"
	fi
}
tick_wait() {
	if [ "$TICK_FD" = 1 ]; then
		IFS= read -r -t "$INTERVAL" _tickbuf <&9 || :
	else
		sleep "$INTERVAL"
	fi
}

# --- authoritative per-OPP residency ------------------------------------------
# THE IDLE GOAL: with every streaming service off and nothing playing, the box
# should sit at 350 MHz for as close to 100 % of the time as possible, with a
# minimum anywhere above it. That is the number this daemon exists to make
# measurable, and every idle-power change is judged against it.
# Baseline to beat: 60.5 % @ 350 MHz (v1.12.0/r70, 2026-08-13).
#
# `freq` above is a SPOT read taken from inside healthd's own busy tick, so it
# is biased towards whatever OPP the governor picked in response to healthd
# itself: measured 2026-08-11 over a 12 h capture, spot samples claimed 350 MHz
# at 20.5 % where the kernel counter said 39.1 %, and 1200 MHz at 6.6 % vs
# 20.0 %. NEVER compute residency from `freq` — difference the kernel's own
# cumulative counters instead, which is what this does.
#
# opp_ms  = {"<kHz>": ms spent at that OPP since the previous sample}
#           `{}` on the first sample and after a counter reset (honest gap
#           rather than a poisoned window).
# opp_trans = governor transitions in the same window (-1 = unknown). The
#           2026-07-13 governor study used transitions/s as its sawtooth metric.
OPP_MS="{}"
OPP_TRANS=-1
opp_sample() {
	OPP_MS="{}"; OPP_TRANS=-1
	[ -r "$TIS" ] || return 0
	_new=""; _json=""; _reset=0
	while read -r _f _t; do
		case "$_f" in ''|*[!0-9]*) continue ;; esac
		case "$_t" in ''|*[!0-9]*) continue ;; esac
		_new="$_new $_f:$_t"
		_p=""
		for _kv in $PREV_TIS; do
			case "$_kv" in "$_f":*) _p="${_kv#*:}"; break ;; esac
		done
		if [ -z "$_p" ]; then
			_reset=1                      # first sample, or a new OPP appeared
		elif [ "$_t" -lt "$_p" ] 2>/dev/null; then
			_reset=1                      # counters were reset under us
		else
			# counter unit is USER_HZ (1/100 s) -> ms
			_json="$_json,\"$_f\":$(( (_t - _p) * 10 ))"
		fi
	done < "$TIS"
	PREV_TIS="$_new"
	[ "$_reset" = 0 ] && [ -n "$_json" ] && OPP_MS="{${_json#,}}"

	if [ -r "$TRANS" ]; then
		_tr=""; read -r _tr < "$TRANS" 2>/dev/null; : "${_tr:=0}"
		case "$_tr" in ''|*[!0-9]*) _tr=0 ;; esac
		if [ "$PREV_TRANS" -ge 0 ] 2>/dev/null && [ "$_tr" -ge "$PREV_TRANS" ] 2>/dev/null; then
			OPP_TRANS=$(( _tr - PREV_TRANS ))
		fi
		PREV_TRANS="$_tr"
	fi
	return 0
}

sample() {
	# Captured up front: the AVR scan and the pstore glob below use `set --`,
	# which overwrites this function's positional parameters.
	_oncearg="${1:-}"

	# --- time (monotonic is authoritative; RTC is unreliable) ---
	rdv /proc/uptime; mono="${RDV%%.*}"; mono="${mono%% *}"; : "${mono:=0}"
	wall=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)

	# --- cpufreq ---
	rdv "$CPUFREQ/scaling_governor"; gov="${RDV:-?}"
	rdv "$CPUFREQ/scaling_cur_freq"; freq="${RDV:-0}"
	# residency for the window that just closed — the trustworthy signal, see
	# opp_sample(). `freq` stays for liveness/vdd bracketing only.
	opp_sample

	# --- thermal ---
	rdv "$TZ0/temp"; temp="${RDV:-0}"
	rdv "$COOL0/cur_state"; cool="${RDV:--1}"

	# --- power: vdd_mpu vs expected for current OPP ---
	vdd=0; abb=0
	if [ -n "$VDD_DIR" ]; then rdv "$VDD_DIR/microvolts"; vdd="${RDV:-0}"; fi
	if [ -n "$ABB_DIR" ]; then rdv "$ABB_DIR/microvolts"; abb="${RDV:-0}"; fi
	# Re-read the frequency AFTER the voltage: freq and vdd are sampled
	# non-atomically, and ondemand can retarget the OPP between the two reads
	# — that produced adjacent-OPP "vdd_mismatch" warnings on every load ramp
	# (17/71 samples in the 2026-07-03 acceptance capture) with a perfectly
	# healthy power path. Only judge a sample whose OPP held still across
	# both reads.
	rdv "$CPUFREQ/scaling_cur_freq"; freq2="${RDV:-0}"
	opp_voltage "$freq"; vexp="$VEXP"
	vmismatch=0
	if [ "$freq2" = "$freq" ] && [ "$vexp" -gt 0 ] && [ "$vdd" -gt 0 ]; then
		d=$(( vdd - vexp )); [ "$d" -lt 0 ] && d=$(( -d ))
		[ "$d" -gt 20000 ] && vmismatch=1
	fi

	# --- nexusqd: crash AND hang detection (process-first, see cache notes) ---
	nq_alive=0
	rdv "/proc/$NQ_PID/comm"
	if [ "$NQ_PID" -gt 0 ] 2>/dev/null && [ "$RDV" = "nexusqd" ]; then
		nq_alive=1
		NQ_ACTIVE=active
	else
		# Cheap truth first: the unit runs iff its cgroup holds processes. Only
		# a real (re)start, or the slow refresh, may spend a systemd query.
		nq_refresh=0
		cg_pid "$NQ_CGROUP"
		rdv "/proc/$CG_PID/comm"
		if [ "$CG_PID" -gt 0 ] 2>/dev/null && [ "$RDV" = "nexusqd" ]; then
			NQ_PID="$CG_PID"; NQ_ACTIVE=active; nq_alive=1
			nq_refresh=1   # (re)started: one query to pick up the NRestarts bump
		else
			NQ_PID=0; NQ_ACTIVE=inactive
		fi
		if [ "$nq_refresh" = 1 ] || [ "$NQ_LAST_SHOW" -lt 0 ] \
			|| [ $(( mono - NQ_LAST_SHOW )) -ge "$UNIT_REFRESH_S" ] 2>/dev/null; then
			out=$(nq_show)
			sv "$out" ActiveState; [ -n "$SV" ] && NQ_ACTIVE="$SV"
			sv "$out" NRestarts; NQ_RESTARTS="${SV:-0}"
			sv "$out" MainPID; p="${SV:-0}"
			rdv "/proc/$p/comm"
			if [ "$p" -gt 0 ] 2>/dev/null && [ "$RDV" = "nexusqd" ]; then
				NQ_PID="$p"; nq_alive=1   # MainPID wins over the cgroup guess
			fi
			NQ_LAST_SHOW="$mono"
		fi
	fi
	nq_active="$NQ_ACTIVE"; nq_pid="$NQ_PID"; nq_restarts="$NQ_RESTARTS"
	nq_state="-"; nq_ticks=0
	if [ "$nq_alive" = 1 ]; then
		# fork-free stat parse: state + utime+stime (was two awk per tick)
		read_stat "$nq_pid" && { nq_state="$ST_STATE"; nq_ticks="$ST_TICKS"; }
	fi
	# control-socket responsiveness — the real "is it wedged?" probe.
	nq_resp=0
	if [ "$nq_alive" = 1 ]; then
		if command -v nexusled >/dev/null 2>&1; then
			timeout 3 nexusled status >/dev/null 2>&1 && nq_resp=1
		elif [ -S /run/nexusqd.sock ]; then
			nq_resp=1   # socket exists; best-effort without a query tool
		fi
	fi
	# forward progress of daemon CPU time (0 = no progress since last sample)
	# Forward progress of daemon CPU time, measured over a WINDOW rather than
	# sample-to-sample. Per-sample was valid only while nexusqd burned enough CPU
	# to accrue a USER_HZ tick every 5 s; nexusqd r13 (event-driven PA gate +
	# 1 Hz idle render) dropped it to ~0.165 % of a core = ~0.8 ticks per sample,
	# so a zero delta became the ORDINARY case for a perfectly healthy daemon.
	# Left as-is that would have fired CRIT `led_frozen` on an idle Q: LED_STALL
	# reaching 6 is guaranteed once the ring locks/blanks (the keepalive
	# re-commits identical bytes), and the co-signal below would have been
	# satisfied by nothing worse than an efficient daemon. Now: progress is 0
	# only if the tick count has not moved for NQ_PROGRESS_STALE_S. At r13's
	# idle rate nexusqd accrues a tick roughly every 6 s, so a 60 s silence is
	# ~10x beyond normal and genuinely means wedged.
	nq_progress=1
	if [ "$nq_alive" = 1 ]; then
		if [ "$nq_ticks" != "$PREV_NEXUSQD_TICKS" ]; then
			NQ_LAST_TICK_MOVE="$mono"          # advanced now
		elif [ "$NQ_LAST_TICK_MOVE" -ge 0 ] 2>/dev/null \
			&& [ $(( mono - NQ_LAST_TICK_MOVE )) -ge "$PROGRESS_STALE_S" ] 2>/dev/null; then
			nq_progress=0
		fi
		[ "$NQ_LAST_TICK_MOVE" -lt 0 ] 2>/dev/null && NQ_LAST_TICK_MOVE="$mono"
	else
		NQ_LAST_TICK_MOVE=-1                       # not running: restart the window
	fi
	PREV_NEXUSQD_TICKS="$nq_ticks"

	# --- librespot (audio source feeding the visualizer) ---
	# USER unit (uid 10000). The unit runs iff its cgroup holds processes —
	# that read costs nothing and is the definition of "running", so it IS the
	# per-tick liveness check (the old cached-cmdline `grep -qa` cost a fork).
	# systemd is only consulted on a 0->pid transition or the slow refresh:
	# `ls_show` goes through the -M user@ stdio bridge, and every call makes
	# pid 1 open and tear down a full PAM login session for uid 10000. While
	# librespot is masked (the app's "Spotify off"), MainPID is 0 forever, so
	# the r40 "query only on transitions" rule degenerated into querying EVERY
	# sample: ~600 login sessions/h, pid 1 back to 4 % CPU — worse than the
	# 3.4 % that the r40 rewrite was written to fix (measured 2026-08-11, 12 h
	# capture).
	ls_alive=0; ls_refresh=0
	cg_scan "$LS_CGROUP" "$LS_PID"
	if [ "$CG_PID" -gt 0 ] 2>/dev/null; then
		ls_alive=1; LS_ACTIVE=active
		if [ "$LS_PID" -le 0 ] 2>/dev/null || [ "$CG_HAS" = 0 ]; then
			# cached pid gone but the cgroup is populated: a (re)start —
			# one query to pick up the NRestarts bump (MainPID wins below)
			LS_PID="$CG_PID"
			ls_refresh=1
		fi
	else
		LS_PID=0; LS_ACTIVE=inactive
	fi
	# A not-running unit still gets asked systemd occasionally, so that
	# `failed` vs `inactive` vs masked stays honest and NRestarts is picked
	# up — bounded to one query per UNIT_REFRESH_S instead of per sample.
	if [ "$ls_refresh" = 1 ] || [ "$LS_LAST_SHOW" -lt 0 ] \
		|| [ $(( mono - LS_LAST_SHOW )) -ge "$UNIT_REFRESH_S" ] 2>/dev/null; then
		if out=$(ls_show); then
			sv "$out" ActiveState; [ -n "$SV" ] && LS_ACTIVE="$SV"
			sv "$out" NRestarts; LS_RESTARTS="${SV:-0}"
			sv "$out" MainPID; p="${SV:-0}"
			if [ "$p" -gt 0 ] 2>/dev/null; then
				LS_PID="$p"; ls_alive=1   # MainPID wins over the cgroup guess
			fi
		elif [ "$ls_alive" = 0 ]; then
			# user manager not up yet (early boot) — honest unknown, no spam
			LS_ACTIVE=unknown
		fi
		LS_LAST_SHOW="$mono"   # back off on failure too, don't retry per tick
	fi
	ls_active="$LS_ACTIVE"; ls_restarts="$LS_RESTARTS"

	# --- AVR interrupt counter (sum across CPUs) — fork-free line scan ---
	avr_irq=-1
	while IFS= read -r _il; do
		case "$_il" in
			*"$AVR_IRQ_RE"*)
				set -- $_il
				shift   # drop the "NNN:" irq-number column
				_s=0
				for _ic; do
					case "$_ic" in
						''|*[!0-9]*) break ;;
						*) _s=$(( _s + _ic )) ;;
					esac
				done
				avr_irq="$_s"
				break
				;;
		esac
	done < /proc/interrupts

	# --- LED frame activity fingerprint ---
	led_sum=0; led_fp=""
	if [ -n "$FRAME_ATTR" ]; then
		# Authoritative: the driver's committed frame (kernel patch 0029).
		# ONE od|awk pass yields both the brightness sum and a change-sensitive
		# rolling hash — the fingerprint only ever feeds an equality test, so
		# md5sum (a third fork + a second full read of the attr) buys nothing.
		_lf=$(od -An -tu1 "$FRAME_ATTR" 2>/dev/null \
			| awk '{for(i=1;i<=NF;i++){s+=$i;h=(h*31+$i)%2147483647}} END{printf "%d %d",s+0,h+0}')
		led_sum="${_lf% *}"; led_fp="${_lf#* }"
		case "$led_sum" in ''|*[!0-9]*) led_sum=0 ;; esac
	else
		# Fallback (pre-0029 kernel): classdev brightness — blind to
		# nexusqd's frame writes, so led_frozen is unreliable here.
		for i in $LED_SAMPLE; do
			rdv "/sys/class/leds/steelhead:rgb:ring-$i/brightness"; b="${RDV:-0}"
			led_sum=$(( led_sum + b ))
			led_fp="$led_fp:$b"
		done
	fi
	led_changed=1
	[ -n "$PREV_LED_FP" ] && [ "$led_fp" = "$PREV_LED_FP" ] && led_changed=0
	PREV_LED_FP="$led_fp"
	# "rotation frozen": nexusqd up but the frame has not changed for a while.
	if [ "$nq_alive" = 1 ] && [ "$led_changed" = 0 ]; then
		LED_STALL=$(( LED_STALL + 1 ))
	else
		LED_STALL=0
	fi

	# --- dmesg error delta (amortized: every DMESG_EVERY ticks) ---
	# Scanning the whole ring through dmesg|grep every 5 s was 3 forks plus a
	# full ring read per tick for a signal that changes ~never; 30 s granularity
	# loses nothing (the event carries the delta, not the moment).
	derr="$DERR_CACHE"; derr_new=0
	if [ $(( TICKN % DMESG_EVERY )) -eq 0 ]; then
		derr=$(dmesg 2>/dev/null | grep -icE 'oops|panic|call trace|bug:|hung task|rcu_sched stall|i2c.*(timeout|fail)|omap_voltage|under.?volt|brown.?out|thermal.*(shutdown|crit)' )
		: "${derr:=0}"
		if [ "$PREV_DMESG_ERR" -ge 0 ] 2>/dev/null; then
			derr_new=$(( derr - PREV_DMESG_ERR ))
			[ "$derr_new" -lt 0 ] && derr_new=0   # ring buffer wrapped
		fi
		PREV_DMESG_ERR="$derr"
		DERR_CACHE="$derr"
	fi

	# --- pstore (crash dumps from a previous boot) — glob count, no ls|wc ---
	set -- /sys/fs/pstore/*
	if [ -e "$1" ] || [ -L "$1" ]; then pstore=$#; else pstore=0; fi

	# --- system ---
	rdv /proc/loadavg; load1="${RDV%% *}"; : "${load1:=0}"
	memav=0
	while IFS=' :	' read -r _mk _mv _mu; do
		case "$_mk" in MemAvailable) memav="${_mv:-0}"; break ;; esac
	done < /proc/meminfo

	# --- write the sample (JSONL) ---
	printf '{"t_mono":%s,"wall":"%s","gov":"%s","freq":%s,"opp_ms":%s,"opp_trans":%s,"temp_mC":%s,"cool":%s,"vdd_uV":%s,"vdd_exp_uV":%s,"vdd_mismatch":%s,"abb_uV":%s,"nq_active":"%s","nq_pid":%s,"nq_alive":%s,"nq_state":"%s","nq_resp":%s,"nq_progress":%s,"nq_restarts":%s,"ls_active":"%s","ls_restarts":%s,"avr_irq":%s,"led_sum":%s,"led_changed":%s,"led_stall":%s,"dmesg_err":%s,"dmesg_err_new":%s,"pstore":%s,"load1":%s,"mem_avail_kB":%s}\n' \
		"$mono" "$wall" "$gov" "$freq" "$OPP_MS" "$OPP_TRANS" "$temp" "$cool" \
		"$vdd" "$vexp" "$vmismatch" "$abb" \
		"$nq_active" "$nq_pid" "$nq_alive" "$nq_state" "$nq_resp" "$nq_progress" "$nq_restarts" \
		"$ls_active" "$ls_restarts" "$avr_irq" \
		"$led_sum" "$led_changed" "$LED_STALL" \
		"$derr" "$derr_new" "$pstore" "$load1" "$memav"

	# --- anomaly events (only on transition / threshold, not every sample) ---
	if [ "$_oncearg" != "--once" ]; then
		# nexusqd wedged: alive but unresponsive, or frame frozen >= 6 samples
		if [ "$nq_alive" = 1 ] && [ "$nq_resp" = 0 ] && [ "$PREV_NEXUSQD_RESP" != 0 ]; then
			emit_event "$mono" crit nexusqd_hang "nexusqd PID $nq_pid alive but control socket unresponsive (state=$nq_state, progress=$nq_progress)"
		fi
		if [ "$LED_STALL" = 6 ]; then
			# A static frame alone is NOT a hang: the screensaver locks a
			# static frame after ~300 s idle BY DESIGN (the v1.6.5 keepalive
			# re-commits identical bytes, so content never changes). Only
			# escalate when a distress co-signal fires in the same sample;
			# a later responsiveness drop is covered by nexusqd_hang above.
			# (False CRIT on every idle capture before this guard, 2026-07-03.)
			if [ "$nq_resp" = 0 ] || [ "$nq_progress" = 0 ]; then
				emit_event "$mono" crit led_frozen "LED frame unchanged for 6 samples with distressed nexusqd (resp=$nq_resp progress=$nq_progress) - ring/AVR/nexusqd hang"
			else
				emit_event "$mono" info led_static "LED frame static for 6 samples with healthy nexusqd (resp=1) - screensaver/static-by-design, not a fault"
			fi
		fi
		if [ "$PREV_NEXUSQD_RESTARTS" -ge 0 ] 2>/dev/null && [ "$nq_restarts" -gt "$PREV_NEXUSQD_RESTARTS" ]; then
			emit_event "$mono" warn nexusqd_restart "nexusqd restarted (NRestarts $PREV_NEXUSQD_RESTARTS -> $nq_restarts)"
		fi
		if [ "$PREV_LIBRESPOT_RESTARTS" -ge 0 ] 2>/dev/null && [ "$ls_restarts" -gt "$PREV_LIBRESPOT_RESTARTS" ]; then
			emit_event "$mono" warn librespot_restart "librespot restarted (NRestarts $PREV_LIBRESPOT_RESTARTS -> $ls_restarts)"
		fi
		if [ "$vmismatch" = 1 ]; then
			emit_event "$mono" warn vdd_mismatch "vdd_mpu ${vdd}uV != expected ${vexp}uV for ${freq}kHz OPP"
		fi
		if [ "$temp" -ge 95000 ] 2>/dev/null; then
			emit_event "$mono" warn thermal_high "cpu_thermal ${temp}mC approaching passive trip (100C)"
		fi
		if [ "$temp" -ge 120000 ] 2>/dev/null; then
			emit_event "$mono" crit thermal_crit "cpu_thermal ${temp}mC approaching critical trip (125C)"
		fi
		if [ "$derr_new" -gt 0 ] 2>/dev/null; then
			emit_event "$mono" warn dmesg_errors "$derr_new new kernel error line(s) since last sample"
		fi
		if [ "$PREV_PSTORE" -ge 0 ] 2>/dev/null && [ "$pstore" -gt "$PREV_PSTORE" ]; then
			emit_event "$mono" crit pstore_new "new pstore crash dump(s) present: $pstore file(s)"
		fi
	fi
	PREV_NEXUSQD_RESTARTS="$nq_restarts"
	PREV_LIBRESPOT_RESTARTS="$ls_restarts"
	PREV_NEXUSQD_RESP="$nq_resp"
	PREV_PSTORE="$pstore"
}

case "${1:-}" in
	--once)
		sample --once
		exit 0
		;;
esac

mkdir -p "$LOGDIR"
init_tick
rdv /proc/uptime; _m0="${RDV%%.*}"; _m0="${_m0%% *}"
emit_event "${_m0:-0}" info start "nq-healthd started (interval=${INTERVAL}s, tickfd=$TICK_FD)"
while :; do
	[ $(( TICKN % ROT_EVERY )) -eq 0 ] && rotate_if_big
	sample >> "$LOG"
	TICKN=$(( TICKN + 1 ))
	tick_wait
done
