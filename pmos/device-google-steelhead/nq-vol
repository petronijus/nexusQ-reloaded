#!/bin/sh
# Volume helper for the front-panel rotary ring. nexusqd runs this (as the `user`
# session, uid 10000) for each ring detent / mute: arg is "up" | "down" | "mute".
#
# The ring drives the PulseAudio DEFAULT sink — i.e. whatever output (speaker /
# SPDIF / HDMI) is currently selected — so it is one unified knob over every PA
# input mixing there: Spotify / AirPlay / Roon AND USB Audio, which is now a PA
# source via the snd-aloop hop (see nexusq-uac2-in) instead of the old exclusive
# hardware-mixer path. `up` is capped at 100%: a raw `pactl +3%` runs past 100%
# into digital over-amplification (observed 477%).
case "$1" in
	up)
		pactl set-sink-volume @DEFAULT_SINK@ +3%
		V=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oE '[0-9]+%' | head -1 | tr -d %)
		[ "${V:-0}" -gt 100 ] && pactl set-sink-volume @DEFAULT_SINK@ 100%
		;;
	down) pactl set-sink-volume @DEFAULT_SINK@ -3% ;;
	mute) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
esac
