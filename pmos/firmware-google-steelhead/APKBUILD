# Reference: <https://postmarketos.org/devicepkg>
# Firmware: Google Nexus Q (steelhead) -- BCM4330 WiFi/BT
# Modeled on firmware-samsung-maguro (identical BCM4330 chip)
pkgname=firmware-google-steelhead
pkgver=1
pkgrel=3
pkgdesc="Google Nexus Q BCM4330 WiFi (brcmfmac) + BT firmware"
url="https://postmarketos.org"
arch="armv7"
license="proprietary"
depends="firmware-aosp-broadcom-wlan"
options="!strip !check !archcheck !spdx !tracedeps"
# The three blobs below are staged into this aport by docker-build.sh Phase 6
# (from ./firmware/), because the proprietary ones must not live in the public
# tree. The mainline kernel drives this chip with brcmfmac (WiFi) + hci_uart_bcm
# (BT), which look for these exact names under /lib/firmware/brcm:
#   - brcmfmac4330-sdio.bin : WiFi firmware -- stock's own fw_bcmdhd.bin
#                             (5.90.125.0, from system.img /vendor/firmware), which
#                             brcmfmac runs fine; else "brcmfmac ... failed ... -2".
#                             r3 replaced the linux-firmware 5.90.195.114 blob, which
#                             stopped delivering unicast frames every few minutes
#                             (docs/2026-09-23-wifi-unicast-wedge-firmware.md).
#   - brcmfmac4330-sdio.txt : brcmfmac NVRAM/calibration (the device's bcmdhd.cal,
#                             which is already key=value NVRAM) -- RF calibration.
#   - BCM4330B1.hcd         : BT patchram for the BCM4330B1 -- else
#                             "BCM: firmware Patch file not found" and no Bluetooth.
# NOTE: firmware-aosp-broadcom-wlan ships AOSP's bcmdhd fw_bcm4330 images under
# other names; nothing here loads them, the dependency is kept only for parity with
# firmware-samsung-maguro. (The old claim that brcmfmac cannot run a bcmdhd image
# was never tested and is wrong: on the 4330 both drivers speak BCDC over SDIO.)
# If the blobs are absent (public clone without the firmware overlay), docker-build.sh
# replaces this with an empty package -- WiFi/BT then simply have no firmware.
source="
	brcmfmac4330-sdio.bin
	brcmfmac4330-sdio.txt
	BCM4330B1.hcd
"

build() {
	true
}

package() {
	install -Dm644 "$srcdir/brcmfmac4330-sdio.bin" \
		"$pkgdir"/lib/firmware/brcm/brcmfmac4330-sdio.bin
	install -Dm644 "$srcdir/brcmfmac4330-sdio.txt" \
		"$pkgdir"/lib/firmware/brcm/brcmfmac4330-sdio.txt
	install -Dm644 "$srcdir/BCM4330B1.hcd" \
		"$pkgdir"/lib/firmware/brcm/BCM4330B1.hcd

	# brcmfmac builds a board-specific name from the DT compatible
	# ("google,steelhead") and tries brcmfmac4330-sdio.google,steelhead.{bin,txt}
	# BEFORE the generic files, logging "Direct firmware load ... failed -2" for
	# the .bin. Ship board-named symlinks to the (identical) generic files so the
	# board-specific probe succeeds and the -2 never happens. Comma is a legal
	# filename char. (The .txt probe is already nowarn, symlinked for consistency.)
	ln -sf brcmfmac4330-sdio.bin \
		"$pkgdir"/lib/firmware/brcm/"brcmfmac4330-sdio.google,steelhead.bin"
	ln -sf brcmfmac4330-sdio.txt \
		"$pkgdir"/lib/firmware/brcm/"brcmfmac4330-sdio.google,steelhead.txt"
}

sha512sums=""
