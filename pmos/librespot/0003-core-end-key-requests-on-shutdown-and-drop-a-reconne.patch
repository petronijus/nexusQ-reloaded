         assert_eq!(started.elapsed(), Duration::from_millis(1500));
@@ -248,6 +261,21 @@ mod tests {
         assert_eq!(key.expect("the reply came").0, KEY);
     }
 
+    #[tokio::test(start_paused = true)]
