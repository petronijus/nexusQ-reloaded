_flavor="${pkgname#linux-}"
_config="config-$_flavor.$arch"
_carch="arm"

# PowerVR SGX540 kernel driver: openpvrsgx (DDK 1.17.4948957), built in-tree as
# the module pvrsrvkm_omap4_sgx540_120 and shipped IN this package, because
# nq-kernel-ota stages only /lib/modules/<release> out of the kernel apk.
# Upstream is pinned to one commit of _pvrsgx_branch; prepare()
# copies its drivers/gpu/drm/pvrsgx into the tree and our patches 0063-0075 go
# on top. The pin is never edited by hand: scripts/bump-pvrsgx.sh moves
# commit + sha512 together and test-applies the whole series on a pristine tree.
# The sha512 is checked in unpack() as well as in sha512sums, because the build
# regenerates sha512sums (pmbootstrap checksum) and would otherwise accept
# whatever the URL serves. docs/2026-10-11-gpu-sgx540-groundwork.md
_pvrsgx_branch=pvrsrvkm-6.18-rc6
_pvrsgx_commit=d2f1e031d58aca97bc4b62367f0d7bef4a7559c3
_pvrsgx_sha512=a8f1d1b2e7d8a412fa41c37a07b5869a3bd829841bf8836ff610123ed79155d449f69d85d9466f167e2a526178f132074992f9c90642921b09679f75406f5374
_pvrsgx_ddk=1.17.4948957
_pvrsgx_archive="linux_openpvrsgx-$_pvrsgx_commit.tar.gz"

