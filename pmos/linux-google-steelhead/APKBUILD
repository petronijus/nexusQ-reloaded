builddir="$srcdir/linux-$pkgver"

unpack() {
	fetch || return 1
	mkdir -p "$srcdir"
	msg "Unpacking linux-$pkgver.tar.xz..."
	unxz -c "$SRCDEST/linux-$pkgver.tar.xz" | tar -C "$srcdir" -xf - || return 1

	# The pin, enforced here and not only through sha512sums (see the variables).
	echo "$_pvrsgx_sha512  $SRCDEST/$_pvrsgx_archive" | sha512sum -c - \
		|| die "$_pvrsgx_archive does not match the pinned sha512 (scripts/bump-pvrsgx.sh moves the pin)"
	# Only the driver directory is used: extracting the whole second kernel tree
	# would put ~1.4 GB into srcdir for 6 MB of it.
	msg "Unpacking drivers/gpu/drm/pvrsgx of openpvrsgx $_pvrsgx_commit..."
	gunzip -c "$SRCDEST/$_pvrsgx_archive" \
		| tar -C "$srcdir" -xf - "linux_openpvrsgx-$_pvrsgx_commit/drivers/gpu/drm/pvrsgx" \
		|| return 1
}

prepare() {
	# The pvrsgx copy runs BEFORE the patches: 0064-0075 patch files that only
	# exist once it is in place (0063, the Kconfig/Makefile hook, is the only one
	# that touches pristine files). Exactly the files the pvrsrvkm-6.18-rc6 build
	# uses for DDK $_pvrsgx_ddk -- the other DDK versions stay out of the tree.
	local _pvr_src="$srcdir/linux_openpvrsgx-$_pvrsgx_commit/drivers/gpu/drm/pvrsgx"
	local _pvr_dst="$builddir/drivers/gpu/drm/pvrsgx"
	[ -d "$_pvr_src/$_pvrsgx_ddk" ] || die "the openpvrsgx archive has no drivers/gpu/drm/pvrsgx/$_pvrsgx_ddk"
	# A future mainline that ships its own pvrsgx directory must be noticed, not
	# silently overwritten.
	[ -e "$_pvr_dst" ] && die "linux-$pkgver already has drivers/gpu/drm/pvrsgx"
	mkdir -p "$_pvr_dst"
	cp -a "$_pvr_src/Kconfig" "$_pvr_src/Makefile" \
		"$_pvr_src/pvr-drv.c" "$_pvr_src/pvr-drv.h" \
		"$_pvr_src/$_pvrsgx_ddk" "$_pvr_dst/"

	default_prepare
	cp "$srcdir/$_config" .config

	# Give EVERY build its own kernel release string, so its modules land in
	# their own /lib/modules/<release>. Without this both kernels call
	# themselves 6.18.48, share /lib/modules/6.18.48, and installing a new
	# kernel's modules OVERWRITES the running kernel's -- which poisons the
	# rollback path that kernel OTA (phase 2) depends on: fall back to the old
	# kernel and its modules are gone, so no cfg80211, so no WiFi, so no way in.
	# (CONFIG_MODVERSIONS=y and CONFIG_CFG80211=m, so this is not theoretical.)
	# Keyed on pkgrel, not a fixed suffix, so the NEXT update does not collide
	# either. LOCALVERSION_AUTO is off in the defconfig so the string stays
	# deterministic (it would otherwise append git state).
	# docs/2026-08-18-kernel-ota-phase2.md
	sed -i "s/^CONFIG_LOCALVERSION=.*/CONFIG_LOCALVERSION=\"-r$pkgrel\"/" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" \
		KCFLAGS="-Wno-array-bounds" \
		olddefconfig

	# olddefconfig silently drops a symbol whose Kconfig is missing (the hook
	# patch 0063 not applied, a renamed option after a pin bump), and the image
	# would then ship without the GPU module and without a word.
	local _sym
	for _sym in CONFIG_SGX=y CONFIG_PVRSGX_1_17_4948957=y CONFIG_SGX_DRM=y CONFIG_SGX_OMAP=m; do
		grep -qx "$_sym" .config || die "olddefconfig dropped $_sym"
	done
	grep -qx 'CONFIG_SGX_OMAP4470=y' .config && die "CONFIG_SGX_OMAP4470=y: the Nexus Q is an OMAP4460"
	# osfunc.c has an #error for a non-preemptible kernel; say it readably here
	# instead of twenty minutes into the build.
	grep -Eqx 'CONFIG_PREEMPT(_VOLUNTARY)?=y' .config \
		|| die "pvrsgx 1.17 needs CONFIG_PREEMPT_VOLUNTARY=y or CONFIG_PREEMPT=y"
	# Until bring-up has proven the driver on the hardware it must not autoload.
	# The blacklist rides in the forced command line, so it is part of the
	# zImage and travels with the kernel slot (see the defconfig). The revision
	# that lets the module autoload removes this check with it.
	grep -Eq '^CONFIG_CMDLINE=".*modprobe\.blacklist=([^ "]*,)?pvrsrvkm_omap4_sgx540_120[, "]' .config \
		|| die "CONFIG_SGX_OMAP=m without modprobe.blacklist=pvrsrvkm_omap4_sgx540_120 in CONFIG_CMDLINE"
	grep -qx 'CONFIG_CMDLINE_FORCE=y' .config \
		|| die "the SGX blacklist needs CONFIG_CMDLINE_FORCE=y (U-Boot's cmdline would replace it)"

	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" \
		KCFLAGS="-Wno-array-bounds"
}

package() {
	mkdir -p "$pkgdir"/boot

	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	local _rel _ko _f
	_rel=$(cat "$builddir"/include/config/kernel.release)

	# /boot keeps the layout every consumer reads -- boot/vmlinuz,
	# boot/System.map, boot/config: the image's rootfs /boot (docker-build.sh
	# Phase 10, which the on-device mkinitfs trigger needs), nq-kernel-ota and
	# nq-rootfs-ab. zinstall's names come from postmarketos-installkernel, and
	# version 3 (pulled from the binary repo on 2026-10-12) installs
	# vmlinuz-<release> and System.map-<release> and no config, which shipped an
	# empty rootfs /boot. Pin the names here instead of following it.
	for _f in vmlinuz System.map config; do
		if [ -e "$pkgdir/boot/$_f-$_rel" ]; then
			mv "$pkgdir/boot/$_f-$_rel" "$pkgdir/boot/$_f"
		fi
	done
	[ -e "$pkgdir/boot/config" ] || install -m644 "$builddir/.config" "$pkgdir/boot/config"
	for _f in vmlinuz System.map config; do
		[ -f "$pkgdir/boot/$_f" ] || die "boot/$_f is missing from the package"
	done
	[ -z "$(find "$pkgdir/boot" -maxdepth 1 -name '*-[0-9]*' -type f)" ] \
		|| die "a versioned file is left in boot/: $(ls "$pkgdir/boot")"

	# The SGX540 module is part of THIS package on purpose: nq-kernel-ota
	# carries /lib/modules/<release> only from the kernel apk. Never split it.
	_ko=$(find "$pkgdir/lib/modules/$_rel" -name pvrsrvkm_omap4_sgx540_120.ko)
	[ -n "$_ko" ] || die "pvrsrvkm_omap4_sgx540_120.ko is missing from the package"
	[ -z "$(find "$pkgdir/lib/modules/$_rel" -name 'pvrsrvkm_omap4_sgx544_*.ko')" ] \
		|| die "the OMAP4470 SGX544 module was built (patch 0071 not effective)"
}

