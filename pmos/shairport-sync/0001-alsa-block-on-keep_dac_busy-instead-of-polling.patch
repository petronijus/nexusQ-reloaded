              (strcasecmp(th, "always") == 0)) {
     config.disable_standby_mode = disable_standby_always;
-    config.keep_dac_busy = 1;
+    set_keep_dac_busy(1);
   } else if (strcasecmp(th, "auto") == 0)
     config.disable_standby_mode = disable_standby_auto;
   else {
