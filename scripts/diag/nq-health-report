#!/usr/bin/env python3
"""nq-health-report — analyze a Nexus Q (steelhead) diagnostic capture.

Consumes what `nqctl snapshot` / the nexusq-diag skill collect:
  - health.jsonl   (time series from nq-healthd)
  - events.jsonl   (anomaly events emitted by nq-healthd)
  - snapshot.txt   (one-shot nq-diag-snapshot, optional)
  - mem.jsonl      (every 10 min since device r125: memory per service, optional)

It produces a human-readable report AND a machine summary (--json) of findings,
so an agent can act on the conclusion without re-parsing raw logs. Stdlib only.

Usage:
  nq-health-report CAPTURE_DIR [--json] [--since=TIME] [--until=TIME]
  nq-health-report health.jsonl [--json] [--since=TIME] [--until=TIME]

--since/--until restrict the analysis to a wall-clock window, e.g. an
overnight soak without the ssh sessions at either end (a session is itself
the largest load an idle Q sees). TIME is ISO 8601; without a zone it is the
host's local time: --since=2026-09-28T01:30 --until=2026-09-28T07:45
"""

import sys
import os
import json
import statistics
from datetime import datetime, timezone

# --- OPP voltage table (uV), mirrors nq-healthd / the DTS -------------------
OPP = {350000: 1025000, 700000: 1203000, 920000: 1317000, 1200000: 1380000}


def load_jsonl(path):
    out = []
    if not path or not os.path.exists(path):
        return out
    with open(path, errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                out.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return out


def fmt_dur(samples, interval_guess):
    return f"{samples} samples (~{samples * interval_guess}s)"


def snapshot_block(text, section, sub):
    """Non-empty lines of one `--- sub ---` block inside one `==== section ====`.

    The snapshot is one long text file and it is tempting to just grep it. That
    is exactly what this replaces, and the reason is worth keeping: the old
    failed-unit check scanned the WHOLE snapshot for a line containing both
    ".service" and "failed", which the kernel log satisfies without a single
    unit having failed —

        systemd[1]: modprobe@efi_pstore.service: Failed to read pids.max ...

    — so every healthy boot on a kernel without CONFIG_CGROUP_PIDS reported a
    failed unit, while `systemctl --failed` was empty on all three managers.
    A diagnostic that cries wolf is worse than no diagnostic: it is the one
    finding a reader has to re-verify by hand every single time.

    Anchoring to the section AND the sub-block means only the real
    `systemctl --failed` output can answer this question.
    """
    lines = text.splitlines()
    in_sec = in_sub = False
    out = []
    for ln in lines:
        st = ln.strip()
        if st.startswith("====") and st.endswith("===="):
            in_sec = st.strip("= ").strip() == section
            in_sub = False
            continue
        if not in_sec:
            continue
        if st.startswith("---") and st.endswith("---"):
            in_sub = st.strip("- ").strip() == sub
            continue
        if in_sub and st:
            out.append(st)
    return out


def parse_when(text):
    """ISO 8601 -> aware UTC datetime; no zone means the host's local time."""
    t = datetime.fromisoformat(text.replace("Z", "+00:00"))
    if t.tzinfo is None:
        t = t.astimezone()
    return t.astimezone(timezone.utc)


def in_window(rows, since=None, until=None):
    """The samples whose `wall` falls inside [since, until)."""
    if since is None and until is None:
        return rows
    out = []
    for r in rows:
        try:
            w = parse_when(r["wall"])
        except (KeyError, TypeError, ValueError):
            continue
        if (since is None or w >= since) and (until is None or w < until):
            out.append(r)
    return out


def events_in_window(events, since=None, until=None):
    """(the events inside [since, until), how many could not be placed).

    t_mono restarts at every boot and events.jsonl outlives boots, so only the
    wall time (device r124 on) places an event. With no window every event is
    kept; with one, an event without a wall time is left out and counted, never
    guessed into the window."""
    if since is None and until is None:
        return events, 0
    placed = [e for e in events if "wall" in e]
    return in_window(placed, since, until), len(events) - len(placed)


# Services whose CPU means the window was NOT idle: audio was flowing.
PLAYBACK_UNITS = ("librespot", "shairport-sync", "pulseaudio")
PLAYBACK_PCT = 2.0  # % of one core, averaged; PulseAudio idles at ~0.2 %


def counter_delta(rows, key, pid_key=None):
    """Sum of a cumulative counter's increases across the rows, restarting at
    every reset (the counter going down, or pid_key changing): a daemon that
    restarted mid-window is counted in both of its lives, never negative."""
    total, prev, prev_pid, seen = 0, None, None, False
    for r in rows:
        v = r.get(key)
        if not isinstance(v, int) or v < 0:
            continue
        pid = r.get(pid_key) if pid_key else None
        if prev is not None and v >= prev and pid == prev_pid:
            total += v - prev
            seen = True
        prev, prev_pid = v, pid
    return total if seen else None


def accounting(rows, interval):
    """What the window cost, from healthd >= device r119's accounting fields.
    Returns None when no sample carries them."""
    acc = [r for r in rows if isinstance(r.get("busy_ms"), int) and r["busy_ms"] >= 0]
    if not acc:
        return None
    span_s = len(acc) * interval
    out = {"span_s": span_s}
    out["busy_pct_of_2_cores"] = 100.0 * sum(r["busy_ms"] for r in acc) / (span_s * 1000 * 2)
    fk = [r["forks"] for r in acc if isinstance(r.get("forks"), int) and r["forks"] >= 0]
    iq = [r["irqs"] for r in acc if isinstance(r.get("irqs"), int) and r["irqs"] >= 0]
    out["forks_per_min"] = 60.0 * sum(fk) / (len(fk) * interval) if fk else None
    out["irqs_per_s"] = sum(iq) / (len(iq) * interval) if iq else None

    # unit_us is the delta over one minute, on every 12th sample
    unit_rows = [r for r in rows if isinstance(r.get("unit_us"), dict) and r["unit_us"]]
    units = {}
    for r in unit_rows:
        for k, v in r["unit_us"].items():
            units[k] = units.get(k, 0) + v
    unit_span_s = 60.0 * len(unit_rows)
    out["unit_pct_of_1_core"] = (
        {k: 100.0 * v / (unit_span_s * 1e6) for k, v in sorted(units.items(), key=lambda kv: -kv[1])}
        if unit_rows
        else {}
    )

    renders = counter_delta(rows, "nq_renders", "nq_pid")
    ctl = counter_delta(rows, "nq_ctl", "nq_pid")
    out["nexusqd_renders_per_s"] = renders / span_s if renders is not None else None
    out["nexusqd_ctl_per_min"] = 60.0 * ctl / span_s if ctl is not None else None
    wakes = counter_delta(rows, "ambient_wakes")
    fixes = counter_delta(rows, "tap_fixes")
    out["ambient_wakes"] = wakes
    out["ambient_wakes_per_h"] = 3600.0 * wakes / span_s if wakes is not None else None
    out["tap_fixes"] = fixes
    return out


# --- memory: who is growing? (healthd >= device r125) -----------------------
# mem.jsonl carries, every 10 min, the box's MemAvailable/AnonPages/Shmem and
# every service's anonymous memory from its cgroup. A leak is a slope, and a
# slow one only beats GC churn over hours: the one that started this record was
# +0.33 MB/h, visible over three days and invisible over a 2.5 min RSS diff.
MEM_MIN_SPAN_H = 3.0  # shorter than this, no trend is claimed at all
MEM_WARN_SPAN_H = 6.0  # a warning rests on at least this much
MEM_WARN_DAYS = 14.0  # MemAvailable gone within this at the anon growth rate
MEM_GROWER_KB_H = 50.0  # a service growing slower than this is noise
MEM_SLICES = ("system.slice", "user.slice", "init.scope")


def slope_per_h(points):
    """Least-squares slope of [(t_s, value)] per hour; None without two
    distinct times."""
    if len(points) < 2:
        return None
    n = len(points)
    mt = sum(t for t, _ in points) / n
    mv = sum(v for _, v in points) / n
    den = sum((t - mt) ** 2 for t, _ in points)
    if den == 0:
        return None
    return 3600.0 * sum((t - mt) * (v - mv) for t, v in points) / den


def series_span_h(points):
    return (points[-1][0] - points[0][0]) / 3600.0 if len(points) >= 2 else 0.0


def long_slope_per_h(points):
    """slope_per_h, but only for a series that itself covers MEM_MIN_SPAN_H.
    A field can be younger than the window: after the upgrade to r125,
    health.jsonl held 13.8 h of samples without anon_kB and two minutes with
    it, and those two minutes fitted -80 MB/h (2026-10-03)."""
    return slope_per_h(points) if series_span_h(points) >= MEM_MIN_SPAN_H else None


def since_restart(points):
    """The tail of a unit's series since it last restarted. A restart shows as
    the unit missing from a record (None) or its anon falling below half the
    previous value: a service starts again from its startup size, and a GC
    rarely hands back half. Fitting across a restart would read as a shrink."""
    tail = []
    prev = None
    for t, v in points:
        if v is None or (prev is not None and v < prev / 2):
            tail = []
        if v is not None:
            tail.append((t, v))
        prev = v
    return tail


def last_boot(rows):
    """The records of the newest boot: by boot_id where the records carry it
    (mem.jsonl), else the last run in which t_mono never went backwards."""
    if rows and rows[-1].get("boot_id"):
        bid = rows[-1]["boot_id"]
        return [r for r in rows if r.get("boot_id") == bid]
    start = 0
    for i in range(1, len(rows)):
        if rows[i].get("t_mono", 0) < rows[i - 1].get("t_mono", 0):
            start = i
    return rows[start:]


def memory_trend(mem_rows, health_rows):
    """Memory growth over the newest boot in the window, from mem.jsonl, or,
    without it, from health.jsonl's anon_kB / mem_avail_kB (box only, no
    per-service figures). None when neither has a usable series."""
    src = "mem.jsonl"
    rows = last_boot([r for r in mem_rows if isinstance(r.get("t_mono"), int)])
    if len(rows) < 2:
        src = "health.jsonl"
        rows = last_boot([r for r in health_rows if isinstance(r.get("t_mono"), int)])
    rows = [r for r in rows if isinstance(r.get("mem_avail_kB"), int) and r["mem_avail_kB"] > 0]
    if len(rows) < 2:
        return None
    span_h = (rows[-1]["t_mono"] - rows[0]["t_mono"]) / 3600.0
    out = {"source": src, "span_h": span_h, "mem_avail_kB": rows[-1]["mem_avail_kB"]}
    if span_h < MEM_MIN_SPAN_H:
        return out
    anon = [(r["t_mono"], r["anon_kB"]) for r in rows if isinstance(r.get("anon_kB"), int) and r["anon_kB"] > 0]
    out["anon_kB"] = anon[-1][1] if anon else None
    out["anon_span_h"] = series_span_h(anon)
    out["anon_kB_per_h"] = long_slope_per_h(anon)
    out["avail_kB_per_h"] = slope_per_h([(r["t_mono"], r["mem_avail_kB"]) for r in rows])
    shm = [(r["t_mono"], r["shmem_kB"]) for r in rows if isinstance(r.get("shmem_kB"), int)]
    out["shmem_kB_per_h"] = long_slope_per_h(shm)
    # Days until MemAvailable is gone if anon keeps growing: anon is what the
    # kernel cannot reclaim, so it is the rate that eats MemAvailable for good.
    rate = out["anon_kB_per_h"]
    out["days_to_exhaustion"] = out["mem_avail_kB"] / rate / 24.0 if rate and rate > 0 else None

    names = []
    for r in rows:
        for k in r.get("unit_anon_kB") or {}:
            if k not in names:
                names.append(k)
    slices, services = {}, {}
    for name in names:
        pts = [(r["t_mono"], (r.get("unit_anon_kB") or {}).get(name)) for r in rows]
        tail = since_restart(pts)
        if tail:
            k = long_slope_per_h(tail)
            if k is not None:
                (slices if name in MEM_SLICES else services)[name] = k
    out["slices_kB_per_h"] = slices
    out["growers_kB_per_h"] = dict(
        sorted(((k, v) for k, v in services.items() if v >= MEM_GROWER_KB_H), key=lambda kv: -kv[1])
    )
    return out


def mem_trend_msg(m):
    def mb(kb):
        return f"{kb / 1024:+.2f} MB/h"

    parts = [f"over {m['span_h']:.1f} h of this boot ({m['source']}): MemAvailable {m['mem_avail_kB'] / 1024:.0f} MB"]
    if m.get("avail_kB_per_h") is not None:
        parts[0] += f" ({mb(m['avail_kB_per_h'])})"
    if m.get("anon_kB_per_h") is not None:
        parts.append(f"anon {m['anon_kB'] / 1024:.0f} MB ({mb(m['anon_kB_per_h'])})")
    if m.get("shmem_kB_per_h") is not None:
        parts.append(f"shmem {mb(m['shmem_kB_per_h'])}")
    if m.get("slices_kB_per_h"):
        parts.append("by slice: " + ", ".join(f"{k} {mb(v)}" for k, v in m["slices_kB_per_h"].items()))
    if m.get("growers_kB_per_h"):
        parts.append("growing: " + ", ".join(f"{k} {mb(v)}" for k, v in list(m["growers_kB_per_h"].items())[:6]))
    elif m["source"] == "mem.jsonl":
        parts.append(f"no service grows faster than {MEM_GROWER_KB_H:.0f} kB/h")
    return "; ".join(parts)


def governed_busy_ms(r):
    """The busy time the governor answers to: busy_ms (both cores) minus its
    niced part. nexusq-cpufreq-tune runs the conservative governor with
    ignore_nice_load=1, so niced work (an `apk upgrade`, the housekeeping
    daemons at Nice=19) is meant to stay at the lowest OPP. nice_ms exists from
    device r124; before it, all of busy_ms counts. None when unknown."""
    busy = r.get("busy_ms")
    if busy is None or busy < 0:
        return None
    nice = r.get("nice_ms")
    return busy - nice if isinstance(nice, int) and 0 <= nice <= busy else busy


def lowest_opp_share(r, lowest=350000):
    """The share of the sample the CPU spent at the lowest OPP, from opp_ms
    (time in state over the window). The spot `freq` is one instant: during a
    busy window it read 350 MHz while opp_ms had the CPU at 1.2 GHz for 93 % of
    it (2026-09-30). Falls back to the spot reading without opp_ms."""
    opp = r.get("opp_ms")
    if isinstance(opp, dict) and opp:
        total = sum(v for v in opp.values() if isinstance(v, (int, float)) and v > 0)
        if total > 0:
            return opp.get(str(lowest), 0) / total
    freq = r.get("freq")
    if freq:
        return 1.0 if freq <= lowest else 0.0
    return None


def reached_opp(r, khz):
    opp = r.get("opp_ms")
    if isinstance(opp, dict) and opp.get(str(khz), 0) > 0:
        return True
    return (r.get("freq") or 0) >= khz


def busy_run(rows, interval, pred):
    """Longest run of consecutive samples with the CPU busy >= 80 % of one core
    in the work the governor answers to (governed_busy_ms), that also satisfy
    `pred`."""
    best = run = 0
    for r in rows:
        busy = governed_busy_ms(r)
        if busy is not None and busy >= 0.8 * interval * 1000 and pred(r):
            run += 1
            best = max(best, run)
        else:
            run = 0
    return best


def analyze(rows, events, snap_text, mem_rows=None):
    findings = []  # (severity, kind, message, t_mono_or_None)

    def add(sev, kind, msg, t=None):
        findings.append({"sev": sev, "kind": kind, "msg": msg, "t_mono": t})

    if not rows:
        add("info", "no_data", "no health samples found")
        return findings, {}

    # crude interval estimate from consecutive monotonic timestamps
    monos = [r.get("t_mono", 0) for r in rows if isinstance(r.get("t_mono"), int)]
    deltas = [b - a for a, b in zip(monos, monos[1:]) if 0 < b - a < 3600]
    interval = int(statistics.median(deltas)) if deltas else 5
    span = (monos[-1] - monos[0]) if len(monos) >= 2 else 0

    # ---- nexusqd hang: alive but control socket unresponsive ----
    hang = [r for r in rows if r.get("nq_alive") == 1 and r.get("nq_resp") == 0]
    if hang:
        add(
            "crit",
            "nexusqd_hang",
            f"nexusqd alive but UNRESPONSIVE in {len(hang)} sample(s) "
            f"(first @ uptime {hang[0].get('t_mono')}s) — the LED ring would be frozen here",
            hang[0].get("t_mono"),
        )

    # ---- LED frame frozen while daemon up ----
    # A static frame alone is NOT a hang: the screensaver locks a static frame
    # after ~300 s idle by design (the keepalive re-commits identical bytes).
    # CRIT only when a distress co-signal (unresponsive socket / no CPU
    # progress) fires in the same stalled samples; otherwise it is
    # static-by-design and merely noted. (False CRIT on every idle capture
    # before this guard, 2026-07-03.)
    frozen = [r for r in rows if r.get("led_stall", 0) and r["led_stall"] >= 6]
    distressed = [r for r in frozen if r.get("nq_resp") == 0 or r.get("nq_progress") == 0]
    if distressed:
        add(
            "crit",
            "led_frozen",
            f"LED frame unchanged >=6 samples WITH distressed nexusqd "
            f"(resp=0/no-progress) on {len(distressed)} occasion(s) "
            f"(first @ uptime {distressed[0].get('t_mono')}s)",
            distressed[0].get("t_mono"),
        )
    elif frozen:
        add(
            "info",
            "led_static",
            f"LED frame static >=6 samples on {len(frozen)} occasion(s) with a "
            f"responsive nexusqd — screensaver/static-by-design, not a fault",
        )

    # ---- nexusqd no forward progress while alive (softer hang signal) ----
    stuck = 0
    longest = 0
    for r in rows:
        if r.get("nq_alive") == 1 and r.get("nq_progress") == 0:
            stuck += 1
            longest = max(longest, stuck)
        else:
            stuck = 0
    if longest >= 4:
        add(
            "warn",
            "nexusqd_no_progress",
            f"nexusqd consumed no CPU for up to {fmt_dur(longest, interval)} while alive "
            f"(idle is normal, but combined with led_frozen this confirms a hang)",
        )

    # ---- restarts ----
    nqr = [r.get("nq_restarts", 0) for r in rows]
    if nqr and max(nqr) > min(nqr):
        add("warn", "nexusqd_restart", f"nexusqd restarted during capture (NRestarts {min(nqr)} -> {max(nqr)})")
    lsr = [r.get("ls_restarts", 0) for r in rows]
    if lsr and max(lsr) > min(lsr):
        add("warn", "librespot_restart", f"librespot restarted during capture (NRestarts {min(lsr)} -> {max(lsr)})")
    # daemon not active at all
    if any(r.get("nq_active") not in ("active", "unknown") for r in rows):
        bad = next(r for r in rows if r.get("nq_active") not in ("active", "unknown"))
        add("crit", "nexusqd_down", f"nexusqd.service not active (state={bad.get('nq_active')})")

    # ---- thermal ----
    temps = [r.get("temp_mC", 0) for r in rows if r.get("temp_mC")]
    if temps:
        tmax = max(temps)
        msg = f"peak cpu_thermal {tmax / 1000:.1f}C (avg {statistics.mean(temps) / 1000:.1f}C)"
        if tmax >= 120000:
            add("crit", "thermal_crit", msg + " — near 125C critical trip")
        elif tmax >= 100000:
            add("warn", "thermal_throttle", msg + " — at/over 100C passive trip")
        elif tmax >= 90000:
            add("warn", "thermal_high", msg + " — approaching 100C passive trip")
        else:
            add("info", "thermal_ok", msg)
    throttled = [r for r in rows if r.get("cool", 0) and r["cool"] > 0]
    if throttled:
        add("warn", "thermal_cooling_active", f"CPU cooling engaged (cur_state>0) in {len(throttled)} sample(s)")

    # ---- power: VDD_MPU vs OPP ----
    mism = [r for r in rows if r.get("vdd_mismatch") == 1]
    if mism:
        # persistent vs transient
        sev = "warn" if len(mism) < max(3, len(rows) // 10) else "crit"
        ex = mism[0]
        add(
            sev,
            "vdd_mismatch",
            f"vdd_mpu off expected OPP voltage in {len(mism)}/{len(rows)} samples "
            f"(e.g. {ex.get('vdd_uV')}uV vs {ex.get('vdd_exp_uV')}uV @ {ex.get('freq')}kHz)",
            ex.get("t_mono"),
        )

    # ---- governor / scaling behaviour ----
    freqs = [r.get("freq", 0) for r in rows if r.get("freq")]
    if freqs:
        # residency from opp_ms (ms in each OPP) where the samples have it,
        # else from the spot readings (samples per frequency)
        residency, unit = {}, "ms"
        for r in rows:
            if isinstance(r.get("opp_ms"), dict):
                for k, v in r["opp_ms"].items():
                    if isinstance(v, (int, float)) and v > 0:
                        residency[int(k)] = residency.get(int(k), 0) + v
        if not residency:
            unit = "samples"
            for f in freqs:
                residency[f] = residency.get(f, 0) + 1
        gov = rows[-1].get("gov", "?")
        reached_top = any(reached_opp(r, 1200000) for r in rows)
        # A stall is the CPU really working while the governor holds the lowest
        # OPP: busy_ms (both cores, per sample) at or above the conservative
        # governor's up_threshold of ONE core, 80 %, for several samples in a
        # row. load1 is no evidence: a one-minute average that also counts tasks
        # waiting on I/O, it touched 1.0 at ~16 % utilization in an idle night
        # (2026-09-30) and raised this warning for nothing. The busy time is
        # the governed part (niced work is meant to stay low), and "at the
        # lowest OPP" is >= 90 % of the sample by opp_ms, not the spot reading
        # (both misread an `apk add` window the same day).
        stall = busy_run(rows, interval, lambda r: (lowest_opp_share(r) or 0) >= 0.9)
        if stall >= 3:
            # Samples from before device r124 have no nice_ms: their niced work,
            # which the governor ignores on purpose, cannot be taken out.
            blind = (
                ""
                if all("nice_ms" in r for r in rows if r.get("busy_ms") is not None)
                else (
                    " (these samples predate nice_ms, so niced work such as `nice apk add`, which "
                    "ignore_nice_load keeps at 350MHz on purpose, cannot be told apart)"
                )
            )
            add(
                "warn",
                "governor_not_scaling",
                f"the CPU ran >=80% of a core for {fmt_dur(stall, interval)} in a row "
                f"while it spent >=90% of each sample at 350MHz (governor={gov}) — possible scaling stall{blind}",
            )
        elif not reached_top and busy_run(rows, interval, lambda r: True) >= 3:
            add("info", "governor_no_turbo", f"sustained load seen but 1200MHz OPP never used (governor={gov})")
        res_str = ", ".join(f"{k // 1000}MHz:{v}" for k, v in sorted(residency.items()))
        add("info", "freq_residency", f"governor={gov}; residency in {unit} [{res_str}]")

    # ---- cpuidle: are the deep C-states armed, running, or vetoed? ----
    # healthd >= device r106 adds cstate_ms/cstate_n (per-window residency by
    # state name, both CPUs summed), cstate_armed and qos_us. Older samples lack
    # them and are skipped. The veto check is the one that matters: a 170 us QoS
    # request from the BT UART kept C2 from ever running for weeks while every
    # counter looked merely "quiet" (docs/2026-09-20-sleep-states-design.md 4m).
    # Exit latencies are steelhead's stock table (kernel patch 0056).
    exit_lat_us = {"C2": 1100, "C3": 1200}
    cst_rows = [r for r in rows if isinstance(r.get("cstate_ms"), dict)]
    if cst_rows:
        tot = {}
        for r in cst_rows:
            for k, v in r["cstate_ms"].items():
                tot[k] = tot.get(k, 0) + (v or 0)
        idle_ms = sum(tot.values())
        armed_now = cst_rows[-1].get("cstate_armed", "") or ""
        share = (
            ", ".join(f"{k} {100 * v / idle_ms:.1f}%" for k, v in sorted(tot.items()))
            if idle_ms
            else "no idle time recorded"
        )
        add("info", "cstate_residency", f"deep states armed: {armed_now or 'none'}; share of idle time [{share}]")

        vetoed = []
        for r in cst_rows:
            armed = [s for s in (r.get("cstate_armed") or "").split(",") if s]
            q = r.get("qos_us")
            lat = [exit_lat_us[s] for s in armed if s in exit_lat_us]
            if lat and isinstance(q, int) and 0 <= q < min(lat):
                vetoed.append(r)
        # Since kernel r17 the states are armed on every boot, so a SHORT veto is
        # ordinary: an active Bluetooth UART pins 170 us while it streams, and the
        # deep states wait it out. What must never hide again is the veto that
        # never lets go -- that is how C2 not running at all went unseen for weeks.
        # So: persistent (>= VETO_PERSISTENT of the samples) is a warn, anything
        # less an info that still says how much of the window was vetoed.
        VETO_PERSISTENT = 0.9
        if vetoed:
            ex = vetoed[0]
            frac = len(vetoed) / len(cst_rows)
            detail = (
                f"CPU-latency QoS below the armed states' exit latency in "
                f"{len(vetoed)}/{len(cst_rows)} sample(s) (e.g. qos {ex.get('qos_us')} us, "
                f"armed {ex.get('cstate_armed')})"
            )
            if frac >= VETO_PERSISTENT:
                add(
                    "warn",
                    "cstate_vetoed",
                    detail + " — the governor can (almost) never pick them; look for a "
                    "held-open device (BT UART, ALSA with a tiny period)",
                    ex.get("t_mono"),
                )
            else:
                add(
                    "info",
                    "cstate_vetoed_transient",
                    detail + " — transient (e.g. Bluetooth streaming), deep idle resumes after",
                    ex.get("t_mono"),
                )

    # ---- CPU accounting (healthd >= device r119) ----
    acc = accounting(rows, interval)
    if acc:
        top = ", ".join(f"{k} {v:.2f}%" for k, v in list(acc["unit_pct_of_1_core"].items())[:8])
        add(
            "info",
            "cpu_busy",
            f"busy {acc['busy_pct_of_2_cores']:.2f}% of both cores; "
            f"forks {acc['forks_per_min']:.1f}/min; interrupts {acc['irqs_per_s']:.0f}/s"
            if acc["forks_per_min"] is not None and acc["irqs_per_s"] is not None
            else f"busy {acc['busy_pct_of_2_cores']:.2f}% of both cores",
        )
        if top:
            add("info", "cpu_by_unit", f"% of one core: {top}")
        if acc["nexusqd_renders_per_s"] is not None:
            add(
                "info",
                "nexusqd_cadence",
                f"nexusqd {acc['nexusqd_renders_per_s']:.2f} renders/s, {acc['nexusqd_ctl_per_min']:.2f} commands/min",
            )
        if acc["ambient_wakes"] is not None:
            add(
                "info",
                "ambient_wakes",
                f"ambient scheduler woke {acc['ambient_wakes']} time(s) "
                f"({acc['ambient_wakes_per_h']:.1f}/h); the LED tap's source was "
                f"put back {acc['tap_fixes'] or 0} time(s)",
            )
        busy_audio = {k: v for k, v in acc["unit_pct_of_1_core"].items() if k in PLAYBACK_UNITS and v >= PLAYBACK_PCT}
        if busy_audio:
            add(
                "warn",
                "window_not_idle",
                "audio was flowing in this window ("
                + ", ".join(f"{k} {v:.1f}%" for k, v in busy_audio.items())
                + ") — it is not an idle measurement; narrow it with --since/--until",
            )

    # ---- memory growth (healthd >= device r125 for the per-service view) ----
    mem = memory_trend(mem_rows or [], rows)
    if mem:
        if mem["span_h"] < MEM_MIN_SPAN_H:
            add(
                "info",
                "mem_trend",
                f"MemAvailable {mem['mem_avail_kB'] / 1024:.0f} MB; {mem['span_h']:.1f} h of this boot "
                f"is too short to tell a leak from churn (needs {MEM_MIN_SPAN_H:.0f} h)",
            )
        else:
            add("info", "mem_trend", mem_trend_msg(mem))
            days = mem.get("days_to_exhaustion")
            if days is not None and days < MEM_WARN_DAYS and mem["anon_span_h"] >= MEM_WARN_SPAN_H:
                add(
                    "warn",
                    "mem_growth",
                    f"anonymous memory grows {mem['anon_kB_per_h'] / 1024:.2f} MB/h: at that rate "
                    f"MemAvailable ({mem['mem_avail_kB'] / 1024:.0f} MB) is gone in {days:.1f} days"
                    + (
                        " — " + ", ".join(list(mem["growers_kB_per_h"])[:3]) + " lead"
                        if mem.get("growers_kB_per_h")
                        else ""
                    ),
                )

    # ---- kernel errors / pstore ----
    if any(r.get("dmesg_err_new", 0) for r in rows):
        n = sum(r.get("dmesg_err_new", 0) for r in rows)
        add("warn", "kernel_errors", f"{n} new kernel error line(s) during capture (see snapshot dmesg)")
    # The count is of /var/lib/systemd/pstore, which PERSISTS across reboots, so a
    # non-zero value means "this unit has crashed at some point", not "it crashed
    # just now" — as a crit it would fire on every capture forever after one
    # panic. A crash during THIS capture arrives as healthd's pstore_new event.
    pst = max((r.get("pstore", 0) or 0) for r in rows) if rows else 0
    if pst:
        add(
            "info",
            "pstore",
            f"{pst} crash dump(s) archived in /var/lib/systemd/pstore "
            "(cumulative across boots; a new one raises pstore_new)",
        )

    # ---- snapshot cross-checks (failed units, pstore in one-shot) ----
    if snap_text:
        if "SNAPSHOT END" not in snap_text:
            add("warn", "snapshot_truncated", "nq-diag-snapshot did not finish (truncated/blocked)")
        for line in snapshot_block(snap_text, "SYSTEMD", "systemctl --failed --no-legend"):
            add("warn", "failed_unit", f"systemd failed unit: {line[:120]}")

    summary = {
        "accounting": acc,
        "memory": mem,
        "samples": len(rows),
        "span_s": span,
        "interval_s": interval,
        "temp_peak_C": (max(temps) / 1000 if temps else None),
        "nexusqd_hang_samples": len(hang),
        "led_frozen_events": len(distressed),
        "led_static_events": len(frozen) - len(distressed),
        "vdd_mismatch_samples": len(mism),
        "worst_severity": (
            "crit"
            if any(f["sev"] == "crit" for f in findings)
            else "warn"
            if any(f["sev"] == "warn" for f in findings)
            else "ok"
        ),
    }
    return findings, summary


def timeline_around(rows, t, window=4):
    if t is None:
        return []
    idx = next((i for i, r in enumerate(rows) if r.get("t_mono") == t), None)
    if idx is None:
        return []
    lo, hi = max(0, idx - window), min(len(rows), idx + window + 1)
    return rows[lo:hi]


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    as_json = "--json" in sys.argv
    opts = dict(a[2:].split("=", 1) for a in sys.argv[1:] if a.startswith("--") and "=" in a)
    since = parse_when(opts["since"]) if "since" in opts else None
    until = parse_when(opts["until"]) if "until" in opts else None
    if not args:
        print(__doc__)
        sys.exit(2)
    target = args[0]
    if os.path.isdir(target):
        health = os.path.join(target, "health.jsonl")
        events = os.path.join(target, "events.jsonl")
        memlog = os.path.join(target, "mem.jsonl")
        snap = os.path.join(target, "snapshot.txt")
    else:
        health, events, snap, memlog = target, None, None, None

    rows = in_window(load_jsonl(health), since, until)
    evs, unplaced = events_in_window(load_jsonl(events), since, until)
    snap_text = ""
    if snap and os.path.exists(snap):
        with open(snap, errors="replace") as fh:
            snap_text = fh.read()

    mem_rows = in_window(load_jsonl(memlog), since, until)
    findings, summary = analyze(rows, evs, snap_text, mem_rows)

    if as_json:
        print(
            json.dumps(
                {"summary": summary, "findings": findings, "device_events": evs, "events_unplaced": unplaced}, indent=2
            )
        )
        return

    sevrank = {"crit": 0, "warn": 1, "info": 2}
    findings.sort(key=lambda f: sevrank.get(f["sev"], 3))
    icon = {"crit": "🔴", "warn": "🟡", "info": "🔵"}

    print("══ Nexus Q health report ══")
    print(
        f"samples={summary.get('samples')} span={summary.get('span_s')}s "
        f"interval≈{summary.get('interval_s')}s "
        f"peak_temp={summary.get('temp_peak_C')}C "
        f"verdict={summary.get('worst_severity', '?').upper()}"
    )
    print()
    for f in findings:
        print(f"{icon.get(f['sev'], '•')} [{f['kind']}] {f['msg']}")

    # show the timeline window around the worst (crit) finding that has a time
    crit_t = next((f["t_mono"] for f in findings if f["sev"] == "crit" and f["t_mono"] is not None), None)
    if crit_t is not None:
        print(f"\n── timeline around uptime {crit_t}s ──")
        for r in timeline_around(rows, crit_t):
            print(
                f"  t={r.get('t_mono')}s freq={r.get('freq')} temp={r.get('temp_mC')}mC "
                f"vdd={r.get('vdd_uV')} nq_alive={r.get('nq_alive')} "
                f"nq_resp={r.get('nq_resp')} led_sum={r.get('led_sum')} "
                f"led_stall={r.get('led_stall')} dmesg_new={r.get('dmesg_err_new')}"
            )

    if evs:
        print("\n── device-side events ──")
        for e in evs[-12:]:
            when = e.get("wall") or f"uptime {e.get('t_mono')}s"
            print(f"  [{e.get('sev')}] {e.get('kind')} @ {when}: {e.get('msg')}")
    if unplaced:
        print(f"\n({unplaced} device-side event(s) left out: written before device r124, they carry no wall time")
        print(" and cannot be placed in the --since/--until window)")


if __name__ == "__main__":
    main()
