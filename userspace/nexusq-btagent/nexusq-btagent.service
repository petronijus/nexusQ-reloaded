[Unit]
Description=Nexus Q Bluetooth pairing agent (Just-Works) + pairing-exposure LED
Documentation=file:/usr/share/doc/nexusq-btagent/README.md
# bluetoothd must exist for us to register against; we do NOT hard-depend on it
# beyond Wants= because the daemon re-registers on NameOwnerChanged, so a
# bluetoothd restart (or a late start) is handled at runtime, not by ordering.
After=bluetooth.service
Wants=bluetooth.service
# Started after nexusqd by nexusqd's own Before=, never an After=nexusqd.service
# here: next to an older nexusqd (After=multi-user.target, an OTA interrupted
# halfway) that is a boot ordering cycle and systemd DELETES a start job in it
# (it killed nexusq-setupd in v1.9.0-rc1); tests/test_unit_order.py. The LED is
# a soft dependency anyway: led_send() tolerates nexusqd being absent and the
# 10 s reconcile retries once it appears.

[Service]
Type=simple
ExecStart=/usr/bin/nexusq-btagent
# Unlike setupd this is NOT one-shot: the appliance must be able to accept a
# pairing at any time (BT audio), so the agent lives for the whole uptime.
Restart=always
RestartSec=3
# 19 since 2026-08-16: with `ignore_nice_load=1` on the conservative
# governor (nexusq-cpufreq-tune drop-in) nice time is credited as idle, so
# this background daemon no longer drives the CPU frequency; the audio path
# is never nice'd and still ramps instantly.
# docs/2026-08-16-idle-700mhz-deep-analysis.md
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
