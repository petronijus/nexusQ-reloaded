#!/bin/sh
# nq-kernel-ota — write a kernel (boot.img) to the Nexus Q's eMMC from the
# running system, without a host, a cable, or fastboot.
#
# THE POINT: until now applying a kernel meant `fastboot flash boot`, which needs
# USB. The Q normally lives on WiFi with nothing plugged in, so "kernel updates
# are software-only" was never actually true — proved the hard way on 2026-08-18.
#
# THE SHAPE (the industry trial-boot/rollback pattern, adapted to a bootloader we
# cannot change — see docs/2026-08-18-kernel-ota-phase2.md):
#
#     p9  "boot"      slot A — the kernel that is known to work. NEVER written
#                     with an image that has not booted.
#     p8  "recovery"  slot B — the TRIAL slot. u-boot boots it when the reboot
#                     reason in SAR RAM says "recovery".
#
#     stage    write the new image to slot B, read it back, compare
#     try      set the reason and reboot -> u-boot runs the new kernel from B
#     promote  (on the next successful boot) copy B to A and clear the marker
#
# So a kernel that does not boot can never cost us the kernel that does.
#
# ⚠️ WHAT THIS CANNOT DO. Stock u-boot (2011.09-rc1) has no bootcount/altbootcmd
# and does NOT fall back when the trial image is unbootable — it just stops
# (measured 2026-08-18). Recovery from a failed trial boot is therefore PHYSICAL:
# power off long enough to drain the always-on domain (the reason word is lost
# and u-boot boots slot A again), or enter fastboot -- power on with the dome
# UNTOUCHED, palm the centre when the mute LED lights, lift off at solid red
# (INSTALL.md 1b; the older "cover the sensor before power" wording never
# worked, issue #4). That is why `try` refuses to run unattended and says so
# out loud.
set -u

KERNEL_PKG=linux-google-steelhead
BOOT_SLOT=${NQ_KOTA_BOOT_SLOT:-/dev/mmcblk0p9}     # A — proven kernel (override: tests only)
TRIAL_SLOT=${NQ_KOTA_TRIAL_SLOT:-/dev/mmcblk0p8}   # B — trial (stock recovery lives here)
STATE_DIR=${NQ_KOTA_STATE_DIR:-/var/lib/nexusq-kernel-ota}   # overridable for tests only
PENDING="$STATE_DIR/pending"      # marker: a trial boot is in flight
BACKUP="$STATE_DIR/slot-a-backup.img"
# The apk the staged kernel came from, kept until the package database agrees
# with it: reconcile falls back to it when the OTA repo does not carry it yet.
STAGED_APK_DIR="$STATE_DIR/staged-apk"
# shellcheck disable=SC2034  # reference only: sar()'s embedded Python carries its own copy
SAR_ADDR=0x4A326A0C               # reboot-reason string, read by stock u-boot
DT_ROOT=${NQ_KOTA_DT_ROOT:-/sys/firmware/devicetree/base}
PERSIST_MNT=${NQ_KOTA_PERSIST_MNT:-/var/lib/nexusq/persist}
IDENTITY_RECORD=${NQ_KOTA_IDENTITY_RECORD:-$PERSIST_MNT/identity/radio}
EMMC_CID=${NQ_KOTA_CID:-/sys/block/mmcblk0/device/cid}

die() { echo "nq-kernel-ota: $*" >&2; exit 1; }
log() { echo "nq-kernel-ota: $*"; }

part_bytes() {
    if [ -b "$1" ]; then
        _n=$(basename "$1")
        echo $(( $(cat "/sys/block/mmcblk0/$_n/size") * 512 ))
    else
        stat -c %s "$1"         # a plain file standing in for a slot (tests)
    fi
}

# --- the reboot reason, straight out of the SAR scratchpad -------------------
# Readable/writable because the kernel ships CONFIG_DEVMEM=y and does NOT set
# CONFIG_STRICT_DEVMEM. Kernel patch 0044 writes this on reboot; u-boot reads it.
sar() {
    python3 - "$1" "${2:-}" <<'PY'
import mmap, os, sys
ADDR = 0x4A326A0C
PAGE = 0x1000
base, off = ADDR & ~(PAGE - 1), ADDR & (PAGE - 1)
mode, value = sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else ""
flags = os.O_RDWR if mode == "write" else os.O_RDONLY
prot = (mmap.PROT_READ | mmap.PROT_WRITE) if mode == "write" else mmap.PROT_READ
fd = os.open("/dev/mem", flags | os.O_SYNC)
m = mmap.mmap(fd, PAGE, mmap.MAP_SHARED, prot, offset=base)
if mode == "read":
    print(m[off:off + 32].split(b"\x00")[0].decode(errors="replace"))
else:
    # stock clears 0x20 bytes then writes the reason; match it exactly
    m[off:off + 32] = b"\x00" * 32
    if value:
        b = value.encode()[:31]
        m[off:off + len(b)] = b
    # No flush(): this is a MAP_SHARED mapping of /dev/mem, so the store has
    # already reached the SAR register — and msync() on it fails with EINVAL,
    # which printed a traceback on every arm/disarm and would have buried a real
    # failure the next time one happened.
    m.close()
PY
}

# --- pack an Android boot image, exactly like the host build does ------------
# Header v0, "kernel" = zImage with the DTB appended (deviceinfo_append_dtb=true),
# same layout as make-bootimg.py on the host.
#
# THE RAMDISK IS NOT OPTIONAL ANY MORE, and getting this wrong is silent.
# The boot image carries the A/B initramfs that picks the rootfs slot (p13 or
# p14) -- see docs/2026-08-20-rescue-initramfs-and-ramdisk-address.md. A kernel
# OTA that packed a ramdisk-LESS image would promote it into slot A and the
# kernel would simply fall back to its forced root=/dev/mmcblk0p13. Everything
# would boot, everything would look healthy, and slot switching would be gone.
# So callers pass the ramdisk through, and `stage-apk` takes it from the image
# that is currently in the boot slot.
#
# The load address matters too: 0x81000000, the Android-stock offset, sits inside
# this kernel's own reserved memory and the kernel drops the initrd rather than
# failing to boot. Ramdisk-less images keep the stock value so they stay
# byte-identical to what was flashed before this existed.
pack_bootimg() {
    python3 - "$1" "$2" "$3" "$4" "${5:--}" <<'PACKEOF'
import hashlib, struct, sys
kern_p, dtb_p, out_p, cmdline, rd_p = sys.argv[1:6]
kernel = open(kern_p, "rb").read() + (open(dtb_p, "rb").read() if dtb_p != "-" else b"")
ramdisk = open(rd_p, "rb").read() if rd_p != "-" else b""
base, ps = 0x80000000, 2048
rd_off = 0x04000000 if ramdisk else 0x01000000
pad = lambda d: d + b"\x00" * ((ps - len(d) % ps) % ps)
hdr = struct.pack("<8s10I16s512s", b"ANDROID!",
                  len(kernel),  base + 0x00008000,
                  len(ramdisk), base + rd_off,
                  0,            base + 0x00f00000,
                  base + 0x00000100, ps, 0, 0,
                  b"", cmdline.encode().ljust(512, b"\x00"))
sha = hashlib.sha1()
for blob in (kernel, struct.pack("<I", len(kernel)),
             ramdisk, struct.pack("<I", len(ramdisk)), b"", struct.pack("<I", 0)):
    sha.update(blob)
img = pad(hdr + sha.digest().ljust(32, b"\x00")) + pad(kernel)
if ramdisk:
    img += pad(ramdisk)
if len(img) > 8 * 1024 * 1024:
    sys.exit("image is %d B -- the boot partition holds 8 MiB" % len(img))
open(out_p, "wb").write(img)
print("packed %s: %d B (kernel+dtb %d B, ramdisk %d B)"
      % (out_p, len(img), len(kernel), len(ramdisk)))
PACKEOF
}

# --- per-unit identity lives in the appended DTB, and only there -------------
# The WiFi MAC (`local-mac-address`) and the BT address (`local-bd-address`) are
# hardcoded in kernel/dts/omap4-steelhead.dts for the FIRST unit; every other
# unit gets its own values as a 6+6-byte patch of the DTB at flash time
# (docs/2026-08-28-per-unit-bt-wifi-identity.md). A kernel apk therefore carries
# the first unit's identity, and staging it as-is renames the device: measured
# 2026-09-05 on the cottage unit, which came out of its first kernel OTA as the
# Prague box on both radios (docs/2026-09-05-*). So `stage-apk` carries the
# booting slot's values onto the new DTB -- reality against reality, exactly as
# it already does for the initramfs. A byte patch, never a re-serialisation: the
# blob's length and layout stay identical, only 12 payload bytes move.
fdt_tool() {
    python3 - "$@" <<'FDTEOF'
import struct, sys

# (property name, stored reversed?) -- the BD address is little-endian in the DT.
PROPS = (("local-mac-address", False), ("local-bd-address", True))
LABEL = {"local-mac-address": "wifi", "local-bd-address": "bt"}

def load(path):
    """Return (bytes, offset-of-FDT, totalsize) for a boot image, a boot
    partition, or a bare .dtb."""
    with open(path, "rb") as f:
        data = f.read(8 * 1024 * 1024)
    if data[:8] == b"ANDROID!":
        ks, ka, rs, ra, ss, sa, tags, ps = struct.unpack_from("<8I", data, 8)
        k = data[ps:ps + ks]
        i = 0
        while True:
            i = k.find(b"\xd0\x0d\xfe\xed", i)
            if i < 0:
                sys.exit("%s: no appended DTB in the kernel" % path)
            tot = struct.unpack_from(">I", k, i + 4)[0]
            # The real one ends exactly at the end of the kernel; the magic also
            # occurs by chance inside the compressed zImage with a nonsense size.
            if i + tot == len(k):
                return data, ps + i, tot
            i += 4
    if data[:4] == b"\xd0\x0d\xfe\xed":
        return data, 0, struct.unpack_from(">I", data, 4)[0]
    sys.exit("%s: neither an Android boot image nor a DTB" % path)

def props(data, base):
    """Walk the structure block; {name: [(node-path, abs-offset, length)]}."""
    (magic, total, off_struct, off_strings, off_rsv, ver, lastcomp, cpu,
     size_strings, size_struct) = struct.unpack_from(">10I", data, base)
    p, end, path, out = base + off_struct, base + off_struct + size_struct, [], {}
    while p < end:
        tok = struct.unpack_from(">I", data, p)[0]; p += 4
        if tok == 1:                                   # FDT_BEGIN_NODE
            e = data.index(b"\0", p); path.append(data[p:e].decode(errors="replace"))
            p = (e + 1 + 3) & ~3
        elif tok == 2:                                 # FDT_END_NODE
            path.pop()
        elif tok == 3:                                 # FDT_PROP
            ln, no = struct.unpack_from(">II", data, p); p += 8
            ns = base + off_strings + no; name = data[ns:data.index(b"\0", ns)].decode()
            out.setdefault(name, []).append(("/".join(path), p, ln))
            p = (p + ln + 3) & ~3
        elif tok == 4:                                 # FDT_NOP
            pass
        elif tok == 9:                                 # FDT_END
            break
        else:
            sys.exit("corrupt FDT: token %d at %d" % (tok, p - 4))
    return out

def fmt(b, rev):
    return ":".join("%02x" % x for x in (b[::-1] if rev else b))

def one(pr, name, what):
    hits = [h for h in pr.get(name, []) if h[2] == 6]
    if len(hits) != 1:
        sys.exit("%s: expected exactly one 6-byte %s, found %d" % (what, name, len(hits)))
    return hits[0]

mode = sys.argv[1]
if mode == "identity":
    d, b, t = load(sys.argv[2]); pr = props(d, b)
    out = []
    for name, rev in PROPS:
        hits = [h for h in pr.get(name, []) if h[2] == 6]
        out.append("%s=%s" % (LABEL[name], fmt(d[hits[0][1]:hits[0][1] + 6], rev) if len(hits) == 1 else "?"))
    print(" ".join(out))
elif mode == "carry":
    src, dst = sys.argv[2], sys.argv[3]
    sd, sb, st = load(src); sp = props(sd, sb)
    dd, db, dt = load(dst); dp = props(dd, db)
    if dd[:8] == b"ANDROID!":
        sys.exit("carry: the destination must be a bare .dtb, not a boot image")
    dd = bytearray(dd); changed = 0
    for name, rev in PROPS:
        _, so, _ = one(sp, name, src); _, do, _ = one(dp, name, dst)
        sv, dv = sd[so:so + 6], bytes(dd[do:do + 6])
        if sv == dv:
            print("nq-kernel-ota: %s already %s" % (name, fmt(sv, rev))); continue
        dd[do:do + 6] = sv; changed += 1
        print("nq-kernel-ota: %s carried over: %s -> %s" % (name, fmt(dv, rev), fmt(sv, rev)))
    if changed:
        open(dst, "wb").write(dd)
    print("nq-kernel-ota: identity carry-over: %d propert%s patched" % (changed, "y" if changed == 1 else "ies"))
elif mode == "split":
    # split <boot image|partition> <out kernel> <out dtb> <out cmdline>: the
    # boot image's kernel section is zImage + appended DTB; hand back the two
    # halves and the header's own cmdline, so a repack reproduces the image.
    src, ok_, od, oc = sys.argv[2:6]
    d, b, t = load(src)
    if d[:8] != b"ANDROID!":
        sys.exit("split: %s is not an Android boot image" % src)
    ks, ka, rs, ra, ss, sa, tags, ps = struct.unpack_from("<8I", d, 8)
    open(ok_, "wb").write(d[ps:b]); open(od, "wb").write(d[b:b + t])
    open(oc, "wb").write(d[64:576].split(b"\0", 1)[0])
elif mode == "set":
    # set <bare dtb> <wifi aa:bb:..> <bt aa:bb:..>: write this identity.
    dst, want = sys.argv[2], {"local-mac-address": sys.argv[3], "local-bd-address": sys.argv[4]}
    dd, db, dt = load(dst)
    if dd[:8] == b"ANDROID!":
        sys.exit("set: the destination must be a bare .dtb, not a boot image")
    dp = props(dd, db); dd = bytearray(dd)
    for name, rev in PROPS:
        _, do, _ = one(dp, name, dst)
        v = bytes.fromhex(want[name].replace(":", ""))
        if len(v) != 6:
            sys.exit("set: %s is not a 6-byte address" % want[name])
        dd[do:do + 6] = v[::-1] if rev else v
        print("nq-kernel-ota: %s -> %s" % (name, want[name].lower()))
    open(dst, "wb").write(dd)
elif mode == "diffcheck":
    # diffcheck <proven image|partition> <new image>: the new image may differ
    # from the proven one ONLY in the two identity payloads and the header's
    # SHA1 id -- anything else means the repack is not the image that booted.
    a, _, _ = load(sys.argv[2]); bimg, bb, bt = load(sys.argv[3])
    ks, ka, rs, ra, ss, sa, tags, ps = struct.unpack_from("<8I", bimg, 8)
    n = len(bimg)
    if len(a) < n or a[n:].strip(b"\0"):
        sys.exit("diffcheck: the proven image is not the new one's length (plus padding)")
    allowed = set(range(576, 608))                 # the header's id field
    for name, rev in PROPS:
        _, off, _ = one(props(bimg, bb), name, sys.argv[3])
        allowed.update(range(off, off + 6))
    diff = [i for i in range(n) if a[i] != bimg[i]]
    bad = [i for i in diff if i not in allowed]
    if bad:
        sys.exit("diffcheck: %d byte(s) differ outside the identity (first at %d)" % (len(bad), bad[0]))
    print("nq-kernel-ota: the new image differs from the proven one in %d byte(s), all identity or header id" % len(diff))
elif mode == "running":
    # running <devicetree root>: the identity the RUNNING kernel was given.
    import os
    found = {}
    for root, dirs, files in os.walk(sys.argv[2]):
        for name, rev in PROPS:
            if name in files:
                v = open(os.path.join(root, name), "rb").read()
                if len(v) == 6:
                    found.setdefault(name, []).append(fmt(v, rev))
    print(" ".join("%s=%s" % (LABEL[n], found[n][0] if len(found.get(n, [])) == 1 else "?") for n, _ in PROPS))
else:
    sys.exit("fdt_tool: unknown mode %s" % mode)
FDTEOF
}

# "wifi=aa:bb:.. bt=aa:bb:.." for a boot image, a boot partition, or a .dtb.
identity_of() { fdt_tool identity "${1:?usage: nq-kernel-ota identity <image|partition|dtb>}"; }

# Patch the identity found in $1 (image/partition/dtb) into the bare DTB $2.
# Refuses when either side does not hold exactly one 6-byte property of each
# kind -- a guess here would rename a unit just as surely as doing nothing.
carry_identity() {
    fdt_tool carry "${1:?usage: nq-kernel-ota carry-identity <src image|partition|dtb> <dst.dtb>}" "${2:?}"
}

# Pull the ramdisk section out of an Android boot image (or straight off a boot
# partition). This is how a kernel OTA keeps the A/B initramfs: whatever is
# booting today is carried over verbatim onto the new kernel, so an OTA can
# never quietly drop it. Prints the size; writes nothing and exits 1 if there is
# no ramdisk, which is the legacy ramdisk-less case and not an error.
extract_ramdisk() {
    python3 - "$1" "$2" <<'RDEOF'
import struct, sys
src, out = sys.argv[1], sys.argv[2]
with open(src, "rb") as f:
    hdr = f.read(4096)
    if hdr[:8] != b"ANDROID!":
        sys.exit("not an Android boot image")
    ks, ka, rs, ra, ss, sa, tags, ps = struct.unpack_from("<8I", hdr, 8)
    if rs == 0:
        sys.exit(1)
    pages = lambda n: (n + ps - 1) // ps
    f.seek(ps * (1 + pages(ks)))
    data = f.read(rs)
if len(data) != rs:
    sys.exit("truncated ramdisk: got %d of %d B" % (len(data), rs))
open(out, "wb").write(data)
print("%d" % rs)
RDEOF
}

# CONFIG_CMDLINE belongs to the kernel being packed, so read it from that
# kernel's own config rather than assuming the running one's.
cmdline_from_config() {
    sed -n 's/^CONFIG_CMDLINE="\(.*\)"$/\1/p' "$1" | head -1
}

cmd_bootimg() {
    _k=${1:?usage: nq-kernel-ota bootimg <vmlinuz> <dtb|-> <out.img> [config] [ramdisk]}
    _d=${2:?}; _o=${3:?}; _c=${4:-/boot/config}; _rd=${5:--}
    _cl=$(cmdline_from_config "$_c")
    [ -n "$_cl" ] || log "warning: no CONFIG_CMDLINE in $_c -- packing an empty cmdline"
    pack_bootimg "$_k" "$_d" "$_o" "$_cl" "$_rd"
}

# The ramdisk the CURRENTLY BOOTING image carries, or "-" if it has none.
# Everything that builds a new boot image on the device goes through this, so the
# A/B initramfs survives a kernel update by construction rather than by anyone
# remembering to preserve it.
current_ramdisk() {
    _dst=$1
    if extract_ramdisk "$BOOT_SLOT" "$_dst" >/dev/null 2>&1; then
        echo "$_dst"
    else
        echo "-"
    fi
}

# Prove the packer is right, using the only ground truth available: rebuild the
# image for the kernel that is CURRENTLY RUNNING and compare it with slot A.
cmd_verify_self() {
    _tmp=$(mktemp -d)
    _dtb=/boot/omap4-steelhead.dtb
    [ -f "$_dtb" ] || _dtb=/boot/dtbs/omap4-steelhead.dtb
    # Repack with the ramdisk slot A already carries, not a freshly built one.
    # The question this answers is "does the packer reproduce the booting image",
    # and rebuilding the initramfs here would be testing a different thing and
    # would fail the moment the rootfs shipped a newer nq-slot.
    _rd=$(current_ramdisk "$_tmp/ramdisk.img")
    [ "$_rd" = "-" ] || log "slot A carries a $(stat -c %s "$_rd") B ramdisk (the A/B initramfs)"
    cmd_bootimg /boot/vmlinuz "$_dtb" "$_tmp/rebuilt.img" /boot/config "$_rd" >/dev/null || die "pack failed"
    _sz=$(stat -c %s "$_tmp/rebuilt.img")
    _a=$(md5sum < "$_tmp/rebuilt.img" | cut -d' ' -f1)
    _b=$(dd if="$BOOT_SLOT" bs=1 count="$_sz" 2>/dev/null | md5sum | cut -d' ' -f1)
    rm -rf "$_tmp"
    log "rebuilt   $_sz B  md5 $_a"
    log "slot A    (first $_sz B) md5 $_b"
    if [ "$_a" = "$_b" ]; then
        log "MATCH -- the on-device packer reproduces the booting image exactly"
    else
        die "MISMATCH -- do not stage anything until this is understood"
    fi
}

# --- stage straight out of a kernel apk -------------------------------------
# Deliberately does NOT `apk add` the package. Upgrading it would delete the OLD
# package's files, including the RUNNING kernel's /lib/modules -- which is the
# rollback path this whole design exists to protect. The apk is a payload
# source; the package database catches up in `promote`, once the new kernel is
# the one running. docs/2026-08-18-kernel-ota-phase2.md
cmd_stage_apk() {
    _apk=${1:?usage: nq-kernel-ota stage-apk <linux-google-steelhead-*.apk>}
    [ -f "$_apk" ] || die "no such apk: $_apk"
    _tmp=$(mktemp -d)

    log "unpacking $_apk"
    tar -xzf "$_apk" -C "$_tmp" 2>/dev/null || { rm -rf "$_tmp"; die "cannot unpack apk"; }
    _rel=$(cat "$_tmp"/usr/share/kernel/*/kernel.release 2>/dev/null)
    [ -n "$_rel" ] || { rm -rf "$_tmp"; die "apk has no kernel.release -- is this a kernel package?"; }
    log "kernel release in apk: $_rel"
    [ "$_rel" = "$(uname -r)" ] && { rm -rf "$_tmp"; die "that apk IS the running kernel ($_rel)"; }
    [ -d "$_tmp/lib/modules/$_rel" ] || { rm -rf "$_tmp"; die "apk has no /lib/modules/$_rel"; }

    # Installing into a NEW directory cannot disturb the running kernel's tree.
    [ -d "/lib/modules/$_rel" ] && { log "refreshing existing /lib/modules/$_rel"; rm -rf "/lib/modules/$_rel"; }
    cp -a "$_tmp/lib/modules/$_rel" /lib/modules/ || { rm -rf "$_tmp"; die "installing modules failed"; }
    depmod "$_rel" 2>/dev/null || log "warning: depmod failed for $_rel"
    log "modules installed: /lib/modules/$_rel (running kernel's $(uname -r) untouched)"

    _dtb="$_tmp/boot/omap4-steelhead.dtb"
    [ -f "$_dtb" ] || _dtb="$_tmp/boot/dtbs/omap4-steelhead.dtb"
    [ -f "$_tmp/boot/vmlinuz" ] || { rm -rf "$_tmp"; die "apk has no /boot/vmlinuz"; }
    [ -f "$_dtb" ] || { rm -rf "$_tmp"; die "apk has no omap4-steelhead.dtb"; }

    # The apk's DTB names the FIRST unit. Carry this unit's own WiFi MAC and BT
    # address over from the slot that is booting today, or refuse: a kernel that
    # boots fine, looks healthy and has quietly renamed the device is the same
    # class of failure as the lost ramdisk below. NQ_KOTA_NO_IDENTITY=1 skips
    # it, for an image whose DTB deliberately has no such properties.
    if [ "${NQ_KOTA_NO_IDENTITY:-0}" = "1" ]; then
        log "NQ_KOTA_NO_IDENTITY=1 -- NOT carrying the boot slot's identity over"
    else
        carry_identity "$BOOT_SLOT" "$_dtb" \
            || { rm -rf "$_tmp"; die "could not carry this unit's identity onto the new DTB -- refusing to stage a kernel that would rename it (NQ_KOTA_NO_IDENTITY=1 overrides)"; }
    fi

    # Carry the booting image's ramdisk onto the new kernel. On a device with the
    # A/B rootfs that ramdisk is the initramfs that chooses the slot; packing
    # without it would produce an image that boots fine, looks healthy, and has
    # silently lost slot switching. On a legacy ramdisk-less device this is a
    # no-op and the image comes out byte-identical to before.
    _rd=$(current_ramdisk "$_tmp/ramdisk.img")
    if [ "$_rd" = "-" ]; then
        log "boot slot has no ramdisk -- packing ramdisk-less, as before"
    else
        log "carrying over the boot slot's initramfs ($(stat -c %s "$_rd") B)"
    fi

    cmd_bootimg "$_tmp/boot/vmlinuz" "$_dtb" "$_tmp/boot.img" "$_tmp/boot/config" "$_rd" \
        || { rm -rf "$_tmp"; die "pack failed"; }

    # Refuse to stage an image that lost a ramdisk the boot slot has. This is the
    # one failure that would not announce itself.
    if [ "$_rd" != "-" ] && ! extract_ramdisk "$_tmp/boot.img" "$_tmp/check.img" >/dev/null 2>&1; then
        rm -rf "$_tmp"
        die "packed image has no ramdisk but the boot slot does -- refusing to stage"
    fi
    # autopromote compares this against `uname -r` after the trial boot, so it can
    # tell "the new kernel is running" from "we fell back to slot A".
    NQ_KOTA_RELEASE="$_rel" cmd_stage "$_tmp/boot.img"
    # Keep the apk itself for reconcile_pkgdb: a kernel staged from a LOCAL apk
    # (one the OTA repo does not publish yet) could otherwise never be handed to
    # the package database -- seen 2026-09-17 and again with 6.18.48-r17, both
    # fixed by hand. One at a time: whatever was kept for an earlier stage goes.
    rm -rf "$STAGED_APK_DIR"
    mkdir -p "$STAGED_APK_DIR"
    cp "$_apk" "$STAGED_APK_DIR/$KERNEL_PKG-$_rel.apk" \
        || log "warning: could not keep $_apk for reconcile"
    rm -rf "$_tmp"
    log "staged kernel $_rel. Nothing has booted it yet -- run 'try' with the device in reach."
}

# --- what runs on the next boot, from the systemd unit -----------------------
# "It booted" is NOT the same as "it works". A kernel that comes up without
# cfg80211 boots perfectly and leaves the device unreachable — promoting that
# into slot A would lock us out of the only working kernel we have. So promotion
# waits for the box to be genuinely usable: our services up AND the network
# actually carrying traffic.
#
# The reason is disarmed FIRST, unconditionally: whatever else happens, the next
# reboot must go to slot A rather than back into the trial slot.
HEALTH_WAIT_S="${NQ_KOTA_HEALTH_WAIT_S:-180}"

# "Healthy" here means one thing: this kernel produced a system somebody can
# still reach. A trial kernel that boots into an unreachable device is the
# failure this gate exists to catch, because stock u-boot has no bootcount and
# will not fall back on its own.
#
# Reachability is NOT the same as having a default route. This device spends much
# of its life on the USB gadget link with no route off it at all -- that is how
# it is administered, and how it would be rescued. Requiring a gateway there
# means the gate can never pass, so a kernel that is running perfectly well never
# gets promoted. Either path counts.
health_ok() {
    [ "$(systemctl is-active nexusq-control)" = active ] || return 1
    [ "$(systemctl is-active nq-healthd)" = active ] || return 1
    # An identity trial (personalize) runs the SAME kernel and ramdisk as the
    # boot slot, 12 address bytes apart, and the gate above it has already
    # proven the new DTB is the one running. Reachability is not in question --
    # and a freshly flashed unit, which is exactly who gets an identity trial,
    # has no network yet: it is set up AFTER its first boot. Requiring a route
    # there would leave the trial unpromoted and the unit on the image's
    # generic identity for good.
    [ "${_identity_trial:-0}" = 1 ] && return 0

    # Routed network: a gateway that answers.
    _gw=$(ip route show default 2>/dev/null | awk '/default/ {print $3; exit}')
    if [ -n "$_gw" ] && ping -c1 -W2 "$_gw" >/dev/null 2>&1; then
        return 0
    fi

    # USB gadget: LOWER_UP means a host has actually enumerated and configured
    # the link -- not merely that we brought the interface up -- and an address
    # on it means somebody can talk to us.
    if ip link show usb0 2>/dev/null | grep -q LOWER_UP \
       && ip -4 addr show usb0 2>/dev/null | grep -q "inet "; then
        return 0
    fi

    return 1
}

cmd_autopromote() {
    [ -f "$PENDING" ] || exit 0            # nothing in flight — normal boot
    _want=$(awk '{print $4}' "$PENDING" 2>/dev/null)

    log "trial boot marker found; disarming the reboot reason first"
    sar write ""

    _now=$(uname -r)
    if [ -n "$_want" ] && [ "$_want" != "$_now" ]; then
        log "running $_now but the trial staged $_want — the trial slot did NOT boot."
        log "slot A is intact and still in charge. Leaving the marker for inspection;"
        log "clear it with 'nq-kernel-ota restore' or stage again."
        exit 0
    fi
    _wid=$(awk '{print $5}' "$PENDING" 2>/dev/null | tr ',' ' ')
    _identity_trial=0
    if [ -n "$_wid" ]; then
        _identity_trial=1
        _rid=$(fdt_tool running "$DT_ROOT")
        if [ "$_rid" != "$_wid" ]; then
            log "the running kernel reports $_rid, the trial staged $_wid —"
            log "the trial slot did NOT boot. Slot A is intact and in charge; the marker stays."
            exit 0
        fi
    fi

    log "running the staged kernel ($_now); waiting up to ${HEALTH_WAIT_S}s for the device to prove it is usable"
    _t=0
    while [ "$_t" -lt "$HEALTH_WAIT_S" ]; do
        if health_ok; then
            log "healthy after ${_t}s — promoting"
            cmd_promote
            exit 0
        fi
        sleep 10; _t=$((_t + 10))
    done

    log "NOT healthy after ${HEALTH_WAIT_S}s — refusing to promote."
    log "slot A still holds the previous kernel; reboot to go back to it."
    exit 1
}

# --- fetch the kernel apk from the OTA repo and stage it ---------------------
# `apk fetch` downloads WITHOUT installing, which is exactly the relationship we
# want with the kernel package: the repo hosts it as a payload source, apk never
# applies it. (nexusq-control's system upgrade passes
# --ignore linux-google-steelhead for the same reason.)

cmd_stage_latest() {
    _dir=$(mktemp -d)
    log "refreshing the package index"
    apk update >/dev/null 2>&1 || log "warning: apk update failed — using the cached index"
    log "fetching $KERNEL_PKG"
    if ! apk fetch --output "$_dir" "$KERNEL_PKG" >/dev/null 2>&1; then
        rm -rf "$_dir"; die "could not fetch $KERNEL_PKG — is the OTA repo reachable?"
    fi
    _apk=$(ls "$_dir"/$KERNEL_PKG-*.apk 2>/dev/null | head -1)
    [ -n "$_apk" ] || { rm -rf "$_dir"; die "fetch produced no apk"; }
    log "fetched $(basename "$_apk")"
    cmd_stage_apk "$_apk"
    rm -rf "$_dir"
}

usage() {
    cat <<'EOF'
usage: nq-kernel-ota <command>

  stage <boot.img>   write the image to the TRIAL slot and verify it read-back
  stage-apk <apk>    unpack a kernel apk, install its modules beside the running
                     kernel's, pack a boot image carrying the boot slot's initramfs
                     AND this unit's WiFi/BT identity, and stage it
  stage-latest       fetch the kernel apk from the OTA repo and stage-apk it
  try                arm the trial boot and reboot into it  (INTERACTIVE ONLY)
  promote            copy the trial slot into the boot slot and clear the marker
  reconcile          make the package database and /boot describe the kernel
                     that is actually running (promote does this itself; run it
                     again once the repo carries that kernel)
  status             what is where, and whether a trial is pending
  reason [value]     read (or set) the u-boot reboot reason in SAR RAM
  restore            put the boot slot back from the pre-update backup

  identity [what]    the WiFi MAC / BT address held in a boot image, partition or
                     .dtb (default: the boot slot)
  carry-identity <src> <dst.dtb>
                     byte-patch the identity found in <src> into a bare DTB; this
                     is what stage-apk does with the boot slot before packing
  personalize [--no-boot]
                     make the boot slot carry THIS unit's identity (persist-store
                     record, else derived from the eMMC CID) and record it;
                     repacks and trial-boots only when the slot says otherwise

  rescue <img>       boot a maintenance image (rootfs left UNMOUNTED) out of the
                     trial slot; `reboot` from it returns to the normal system
EOF
}

cmd_status() {
    log "slot A (boot)  $BOOT_SLOT  $(part_bytes $BOOT_SLOT) B  md5 $(dd if=$BOOT_SLOT bs=1M count=8 2>/dev/null | md5sum | cut -d' ' -f1)"
    log "slot B (trial) $TRIAL_SLOT  $(part_bytes $TRIAL_SLOT) B  md5 $(dd if=$TRIAL_SLOT bs=1M count=8 2>/dev/null | md5sum | cut -d' ' -f1)"
    log "reboot reason  '$(sar read)'"
    log "identity       slot A: $(identity_of "$BOOT_SLOT" 2>/dev/null || echo '?')   slot B: $(identity_of "$TRIAL_SLOT" 2>/dev/null || echo '?')"
    log "identity rec.  $(head -n1 "$IDENTITY_RECORD" 2>/dev/null || echo 'none in the persist store yet')"
    if [ -f "$PENDING" ]; then
        log "PENDING trial boot: $(cat "$PENDING")"
    else
        log "no trial boot pending"
    fi
    [ -f "$BACKUP" ] && log "slot-A backup: $BACKUP ($(stat -c %s "$BACKUP") B)"
    return 0
}

# Write an image into the trial slot, with every check that must never be
# skipped: size, magic, a backup of slot A and a read-back compare. Shared by
# `stage` (an OTA kernel, which then arms a pending trial) and `rescue` (a
# maintenance image, which must NOT). Sets $_want to the image md5.
write_trial() {
    _img=$1
    [ -f "$_img" ] || die "no such image: $_img"
    _sz=$(stat -c %s "$_img")
    _cap=$(part_bytes "$TRIAL_SLOT")
    [ "$_sz" -le "$_cap" ] || die "image is $_sz B, trial slot holds $_cap B"
    # An Android boot header is the minimum sanity check: a truncated download
    # must never reach a partition.
    [ "$(dd if="$_img" bs=8 count=1 2>/dev/null)" = "ANDROID!" ] \
        || die "not an Android boot image (bad magic) — refusing to write"

    mkdir -p "$STATE_DIR"
    log "backing up slot A -> $BACKUP"
    dd if="$BOOT_SLOT" of="$BACKUP" bs=1M count=8 2>/dev/null || die "slot A backup failed"

    log "writing $_sz B to the trial slot"
    dd if="$_img" of="$TRIAL_SLOT" bs=1M conv=fsync 2>/dev/null || die "write failed"
    sync

    # Read back and compare. The 2026-06 flash corruption (sparse DONT_CARE over a
    # non-erased eMMC) is exactly the class of bug a read-back catches.
    _want=$(md5sum < "$_img" | cut -d' ' -f1)
    _got=$(dd if="$TRIAL_SLOT" bs=1 count="$_sz" 2>/dev/null | md5sum | cut -d' ' -f1)
    [ "$_want" = "$_got" ] || die "READ-BACK MISMATCH ($_want != $_got) — slot B is not what we wrote"
    log "read-back verified: $_got"

}

cmd_stage() {
    write_trial "${1:?usage: nq-kernel-ota stage <boot.img>}"
    # Field 5, when set, is the identity the staged DTB carries (personalize):
    # the same kernel release on both slots cannot tell autopromote which one
    # booted, the identity the running kernel reports can.
    _idf=$(printf '%s' "${NQ_KOTA_IDENTITY:-}" | tr ' ' ',')
    printf '%s %s %s %s %s\n' "$(date -u +%FT%TZ)" "$_img" "$_want" "${NQ_KOTA_RELEASE:-}" "$_idf" > "$PENDING"
    log "staged. Next: 'nq-kernel-ota try' — and read what it prints first."
}

# --- boot a maintenance image out of the trial slot -------------------------
# Same slot and same bootloader trick as an OTA trial, but deliberately WITHOUT
# a pending marker, because a rescue image is not a candidate for slot A.
#
# It would be actively dangerous to reuse `stage` here. autopromote decides
# whether a trial booted by comparing `uname -r` against the release recorded in
# the pending file, and a rescue image is built from the RUNNING kernel — same
# release. So the next normal boot would conclude the trial had succeeded and
# copy the rescue image over slot A, leaving a device that boots into a
# rescue shell for good. (That check is sound for real OTA kernels: every
# release bumps pkgrel, which CONFIG_LOCALVERSION puts into `uname -r`.)
#
# Getting back out is just `reboot`: the rescue init clears the reboot reason
# as its first action, so the bootloader falls back to slot A on its own.
cmd_rescue() {
    _rimg=${1:?usage: nq-kernel-ota rescue <rescue-boot.img>}
    [ -f "$PENDING" ] && die "an OTA trial is pending — resolve it first (status / restore)"
    write_trial "$_rimg"
    cat <<'EOF'

  The rescue image is in the trial slot. Booting it leaves the rootfs on p13
  UNMOUNTED, so it can be repaired, resized or replaced. Nothing has been
  written to p13 and nothing will be unless you do it from that shell.

  It comes up as a telnet server on 172.16.43.1 over the USB gadget (give the
  host 172.16.43.2/24; there is no DHCP in the rescue). There is
  no serial console on this board, so if that gadget fails to enumerate you are
  blind and the way out is a power cycle.

EOF
    if [ "${NQ_KOTA_YES:-}" != "1" ]; then
        printf "  type YES to boot the rescue image: "
        read _ans
        [ "$_ans" = "YES" ] || die "aborted"
    fi
    log "arming the rescue boot"
    sar write recovery
    log "reason is now '$(sar read)' — rebooting into the rescue image"
    sync
    systemctl reboot --reboot-argument=recovery
}

# --- personalize: one generic boot image, every unit its own identity ---------
#
# The WiFi MAC and BT address live in the DTB appended to the boot image, and
# the DTS carries ONE unit's: the Prague Q's, whose factory values they are
# (docs/2026-08-28-per-unit-bt-wifi-identity.md). The hardware reports no address
# of its own, and stock's bootloader-cmdline channel is closed by
# CONFIG_CMDLINE_FORCE. So until now every other unit got its identity as a hand
# byte-patch at flash time -- and every unit flashed from a public release came
# up as the Prague Q on both radios.
#
# This makes the identity the unit's own, from the one unique thing it has that
# the OS can read: the eMMC CID.
#
#   the unit's identity is, in this order:
#     1. the record in the persist store (identity/radio) -- what it has been,
#        across any flash;
#     2. otherwise, what its boot slot carries, IF that is not the image's
#        generic identity (a unit personalised before this existed: the
#        cottage Q, and any unit a kernel OTA carried an identity onto);
#     3. otherwise the generic identity if this IS the unit it belongs to
#        (IDENTITY_OWNER_CID);
#     4. otherwise derived from the CID: the Google OUI the factory used plus
#        three bytes of sha256("nexusq/<wifi|bt>/emmc-cid/<cid>").
#   It is recorded in the store (so a flash cannot lose it), and if the boot
#   slot says otherwise, the slot's image is repacked with it -- the proven
#   kernel and ramdisk, 12 identity bytes changed, checked byte for byte
#   (fdt_tool diffcheck) -- staged in the trial slot and booted once. The
#   autopromote gate promotes it only when the RUNNING kernel reports the new
#   identity, i.e. only when the new DTB is what actually booted.
IDENTITY_GENERIC="wifi=f8:8f:ca:20:48:e1 bt=f8:8f:ca:20:49:e5"
IDENTITY_OWNER_CID=1501004d414734464125ef8120a7ce45   # the Prague Q's eMMC

# TESTABLE:derive_identity
# derive_identity <eMMC CID>: "wifi=f8:8f:ca:xx:xx:xx bt=f8:8f:ca:yy:yy:yy".
derive_identity() {
    _w=$(printf '%s' "nexusq/wifi/emmc-cid/$1" | sha256sum | cut -c1-6)
    _b=$(printf '%s' "nexusq/bt/emmc-cid/$1" | sha256sum | cut -c1-6)
    printf 'wifi=f8:8f:ca:%s:%s:%s bt=f8:8f:ca:%s:%s:%s\n' \
        "$(echo "$_w" | cut -c1-2)" "$(echo "$_w" | cut -c3-4)" "$(echo "$_w" | cut -c5-6)" \
        "$(echo "$_b" | cut -c1-2)" "$(echo "$_b" | cut -c3-4)" "$(echo "$_b" | cut -c5-6)"
}

# TESTABLE:wanted_identity
# wanted_identity <record or ""> <boot slot identity> <eMMC CID>: the rules above.
wanted_identity() {
    if [ -n "$1" ]; then echo "$1"; return; fi
    case "$2" in *"?"*) ;; *)
        if [ "$2" != "$IDENTITY_GENERIC" ]; then echo "$2"; return; fi
        if [ "$3" = "$IDENTITY_OWNER_CID" ]; then echo "$2"; return; fi ;;
    esac
    derive_identity "$3"
}

cmd_personalize() {
    _boot=1
    [ "${1:-}" = --no-boot ] && _boot=0        # stage it, do not reboot (tests, by hand)
    if [ -f "$PENDING" ]; then
        log "a trial boot is pending; the identity check waits until it is resolved"
        return 0
    fi
    _have=$(identity_of "$BOOT_SLOT") || die "cannot read the boot slot's identity"
    _rec=""; [ -s "$IDENTITY_RECORD" ] && _rec=$(head -n1 "$IDENTITY_RECORD")
    _cid=$(cat "$EMMC_CID" 2>/dev/null || true)
    [ -n "$_rec" ] || [ -n "$_cid" ] || die "no identity record and no eMMC CID to derive one from"
    _want=$(wanted_identity "$_rec" "$_have" "$_cid")

    if [ -z "$_rec" ]; then
        if mountpoint -q "$PERSIST_MNT" 2>/dev/null; then
            mkdir -p "$(dirname "$IDENTITY_RECORD")"
            printf '%s\n' "$_want" > "$IDENTITY_RECORD.tmp" && mv "$IDENTITY_RECORD.tmp" "$IDENTITY_RECORD"
            log "identity recorded in the persist store: $_want"
        else
            log "the persist store is not mounted; the identity is not recorded this boot"
        fi
    fi
    if [ "$_want" = "$_have" ]; then
        log "identity ok: $_have"
        return 0
    fi

    log "the boot slot carries $_have; this unit is $_want"
    _tmp=$(mktemp -d)
    fdt_tool split "$BOOT_SLOT" "$_tmp/kernel" "$_tmp/dtb" "$_tmp/cmdline" \
        || { rm -rf "$_tmp"; die "cannot take the boot slot's image apart"; }
    _w=$(echo "$_want" | sed 's/.*wifi=\([^ ]*\).*/\1/'); _b=$(echo "$_want" | sed 's/.*bt=\([^ ]*\).*/\1/')
    fdt_tool set "$_tmp/dtb" "$_w" "$_b" || { rm -rf "$_tmp"; die "cannot write the identity into the DTB"; }
    _rd=$(current_ramdisk "$_tmp/ramdisk.img")
    pack_bootimg "$_tmp/kernel" "$_tmp/dtb" "$_tmp/boot.img" "$(cat "$_tmp/cmdline")" "$_rd" >/dev/null \
        || { rm -rf "$_tmp"; die "pack failed"; }
    fdt_tool diffcheck "$BOOT_SLOT" "$_tmp/boot.img" \
        || { rm -rf "$_tmp"; die "the repacked image is not the proven one plus the identity -- refusing"; }
    NQ_KOTA_RELEASE=$(uname -r) NQ_KOTA_IDENTITY="$_want" cmd_stage "$_tmp/boot.img"
    rm -rf "$_tmp"
    if [ "$_boot" = 0 ]; then
        log "staged, not booted (--no-boot)"
        return 0
    fi
    log "booting it once so it takes effect; the health gate promotes it"
    NQ_KOTA_YES=1 cmd_try
}

cmd_try() {
    [ -f "$PENDING" ] || die "nothing staged"
    cat <<'EOF'

  ⚠️  A TRIAL BOOT CANNOT BE UNDONE REMOTELY.

  Stock u-boot has no bootcount and does not fall back: if the staged kernel
  does not boot, this device STOPS at the bootloader and needs hands on it —
  leave it unplugged long enough for the always-on domain to drain (the
  reason word is lost and u-boot boots slot A again), or reach fastboot: power
  on with the dome UNTOUCHED, palm the centre when the mute LED lights, lift
  off at solid red (INSTALL.md 1b).

  Do this only with the device in reach. Slot A is untouched either way.

EOF
    if [ "${NQ_KOTA_YES:-}" != "1" ]; then
        printf "  type YES to boot the trial kernel: "
        read _ans
        [ "$_ans" = "YES" ] || die "aborted"
    fi
    log "arming the trial boot"
    sar write recovery
    log "reason is now '$(sar read)' — rebooting"
    sync
    systemctl reboot --reboot-argument=recovery
}


reconcile_pkgdb() {
    # Reconcile the package database LAST, now that the new kernel is the one
    # running. This also refreshes /boot (vmlinuz, dtbs, config, kernel.release).
    #
    # ⚠️ It used to say here that once the new kernel is promoted it is "safe to
    # let apk replace" the old package. That was WRONG and it was measured wrong
    # on 2026-08-31: `apk add --upgrade` deletes the outgoing package's files,
    # which took all 155 modules of 6.12.12-r52 with it. `restore` below puts
    # slot-a-backup.img -- the OLD kernel -- back on the boot slot, and a kernel
    # whose /lib/modules apk has just deleted comes up with no cfg80211, so no
    # WiFi, on a box with no serial console. The rollback path was silently
    # disarmed by the very step that tidied up after it. So the outgoing tree is
    # stashed across the upgrade and put back, unowned by apk, for as long as the
    # backup image it belongs to still exists.
    #
    # This step was documented from the start and NOT implemented — the code had
    # only a comment. The gap was silent and real: after the first promotion the
    # device booted 6.12.12-r48 from slot A while `apk info` still said r46 and
    # /boot still held r46's vmlinuz, so anything rebuilding an image from /boot
    # (verify-self, the rescue builder) quietly used the WRONG kernel.
    if ! command -v apk >/dev/null 2>&1; then
        :
    elif apk info -v 2>/dev/null | grep -q "^$KERNEL_PKG-$(uname -r)\$"; then
        # Already in agreement. Worth checking before reaching for the network:
        # this device often has no route off the USB link, and a pointless
        # `apk add` there fails on DNS and prints a warning that reads like a
        # real problem.
        log "package database already agrees ($KERNEL_PKG-$(uname -r))"
    else
        log "reconciling the package database with the running kernel"
        _old=$(apk info -v 2>/dev/null | grep "^$KERNEL_PKG-" | head -1 | sed "s/^$KERNEL_PKG-//")
        _stash=""
        if [ -n "$_old" ] && [ "$_old" != "$(uname -r)" ] &&
           [ -d "/lib/modules/$_old" ] && [ -f "$BACKUP" ]; then
            _stash="$STATE_DIR/modules-$_old.tar.gz"
            log "stashing /lib/modules/$_old — it belongs to the backup image"
            tar -czf "$_stash" -C / "lib/modules/$_old" 2>/dev/null || _stash=""
        fi
        # `apk add --upgrade` exits 0 when there is nothing newer to fetch, so its
        # exit code says "apk ran", not "apk agrees". Measured 2026-09-17: a kernel
        # staged from a LOCAL apk (scp'd to the device, then `stage-apk`) promoted
        # correctly and this line logged "apk now agrees: …-6.18.48-r1" while
        # `uname -r` was r2 — the OTA repo had not published r2 yet, so the upgrade
        # was a successful no-op. /boot then described r1, which is precisely the
        # failure the WARNING is written about, and the only signal said the
        # opposite. So read the verdict back out of the database and compare it to
        # the kernel that is actually running; never infer it from an exit code.
        apk add --upgrade "$KERNEL_PKG" >/dev/null 2>&1 || true
        _now=$(apk info -v 2>/dev/null | grep "^$KERNEL_PKG-" | head -1 | sed "s/^$KERNEL_PKG-//")
        # The repo does not carry the running kernel (yet): install it from the
        # apk it was staged from. Same stash/restore around it as the repo path,
        # because `apk add` of a file deletes the outgoing tree just the same.
        _kept="$STAGED_APK_DIR/$KERNEL_PKG-$(uname -r).apk"
        if [ "$_now" != "$(uname -r)" ] && [ -f "$_kept" ]; then
            log "the repo has no $KERNEL_PKG-$(uname -r); installing the apk it was staged from"
            apk add "$_kept" >/dev/null 2>&1 || log "warning: apk add $_kept failed"
            _now=$(apk info -v 2>/dev/null | grep "^$KERNEL_PKG-" | head -1 | sed "s/^$KERNEL_PKG-//")
        fi
        if [ "$_now" = "$(uname -r)" ]; then
            rm -rf "$STAGED_APK_DIR"
            log "apk now agrees: $KERNEL_PKG-$_now"
        else
            log "WARNING: the package database still says $KERNEL_PKG-${_now:-none}"
            log "         while the running kernel is $(uname -r), so /boot describes"
            log "         the WRONG kernel and anything that rebuilds an image from it"
            log "         (verify-self, the rescue builder) would use it. Usually this"
            log "         means the repo does not carry $(uname -r) yet: publish it, then"
            log "         re-run this step. The running kernel is fine either way."
        fi
        if [ -n "$_stash" ] && [ ! -d "/lib/modules/$_old" ]; then
            if tar -xzf "$_stash" -C / 2>/dev/null; then
                depmod "$_old" 2>/dev/null || true
                log "put /lib/modules/$_old back — 'restore' stays usable"
            else
                log "WARNING: could not restore /lib/modules/$_old from $_stash."
                log "         'restore' would boot the backup kernel WITHOUT modules."
            fi
        fi
        [ -n "$_stash" ] && rm -f "$_stash"
    fi
}
cmd_promote() {
    [ -f "$PENDING" ] || die "nothing pending — promote is for a kernel that just proved it boots"
    log "promoting trial slot -> boot slot"
    dd if="$TRIAL_SLOT" of="$BOOT_SLOT" bs=1M conv=fsync 2>/dev/null || die "promote failed"
    sync
    _a=$(dd if="$BOOT_SLOT" bs=1M count=8 2>/dev/null | md5sum | cut -d' ' -f1)
    _b=$(dd if="$TRIAL_SLOT" bs=1M count=8 2>/dev/null | md5sum | cut -d' ' -f1)
    [ "$_a" = "$_b" ] || die "post-promote mismatch ($_a != $_b)"
    sar write ""              # never leave a recovery request armed
    rm -f "$PENDING"
    log "promoted and disarmed. Slot A md5 $_a"

    # Reconcile the package database with the kernel that is now running.
    # Extracted into reconcile_pkgdb() (and exposed as `reconcile`) on
    # 2026-09-17: when the repo does not yet carry the running kernel there is
    # nothing this step can do, and until then there was no way to run it again
    # afterwards — the device sat with /boot describing the previous kernel and
    # only a log line, which was wrong, to say so.
    reconcile_pkgdb
}

cmd_restore() {
    [ -f "$BACKUP" ] || die "no backup at $BACKUP"
    log "restoring slot A from $BACKUP"
    dd if="$BACKUP" of="$BOOT_SLOT" bs=1M conv=fsync 2>/dev/null || die "restore failed"
    sync
    sar write ""
    rm -f "$PENDING"
    log "restored and disarmed."
}

case "${1:-}" in
    stage)       shift; cmd_stage "$@" ;;
    stage-apk)    shift; cmd_stage_apk "$@" ;;
    stage-latest) cmd_stage_latest ;;
    bootimg)     shift; cmd_bootimg "$@" ;;
    verify-self) cmd_verify_self ;;
    try)     cmd_try ;;
    promote)     cmd_promote ;;
    reconcile)   reconcile_pkgdb ;;
    personalize) shift; cmd_personalize "$@" ;;
    autopromote) cmd_autopromote ;;
    status)  cmd_status ;;
    identity)       identity_of "${2:-$BOOT_SLOT}" ;;
    carry-identity) shift; carry_identity "$@" ;;
    restore) cmd_restore ;;
    rescue)  shift; cmd_rescue "$@" ;;
    reason)  if [ $# -ge 2 ]; then
                 sar write "$2"
                 log "reason set to '$(sar read)'"
                 # Writing the word is not enough to act on it, and the failure is
                 # silent. Kernel patch 0044 rewrites the reason from the machine
                 # .restart hook on EVERY restart, so a plain `reboot` clobbers
                 # whatever was set here with the default "normal" on the way
                 # down. Measured: setting "recovery" this way and rebooting
                 # normally boots slot A, not the trial slot.
                 log "NB: this is clobbered by a plain reboot. To act on it use"
                 log "    systemctl reboot --reboot-argument=$2"
             else
                 sar read
             fi ;;
    *)       usage; exit 1 ;;
esac
