#!/bin/sh
# nq-kernel-ota — write a kernel (boot.img) to the Nexus Q's eMMC from the
# running system, without a host, a cable, or fastboot.
#
# THE POINT: until now applying a kernel meant `fastboot flash boot`, which needs
# USB. The Q normally lives on WiFi with nothing plugged in, so "kernel updates
# are software-only" was never actually true — proved the hard way on 2026-08-18.
#
# THE SHAPE (the industry trial-boot/rollback pattern, adapted to a bootloader we
# cannot change — see docs/2026-08-18-kernel-ota-phase2.md):
#
#     p9  "boot"      slot A — the kernel that is known to work. NEVER written
#                     with an image that has not booted.
#     p8  "recovery"  slot B — the TRIAL slot. u-boot boots it when the reboot
#                     reason in SAR RAM says "recovery".
#
#     stage    write the new image to slot B, read it back, compare
#     try      set the reason and reboot -> u-boot runs the new kernel from B
#     promote  (on the next successful boot) copy B to A and clear the marker
#
# So a kernel that does not boot can never cost us the kernel that does.
#
# ⚠️ WHAT THIS CANNOT DO. Stock u-boot (2011.09-rc1) has no bootcount/altbootcmd
# and does NOT fall back when the trial image is unbootable — it just stops
# (measured 2026-08-18). Recovery from a failed trial boot is therefore PHYSICAL:
# cover the mute sensor at power-on for fastboot, or power off long enough to
# drain the always-on domain. That is why `try` refuses to run unattended and
# says so out loud.
set -u

BOOT_SLOT=/dev/mmcblk0p9          # A — proven kernel
TRIAL_SLOT=/dev/mmcblk0p8         # B — trial (stock recovery lives here)
STATE_DIR=/var/lib/nexusq-kernel-ota
PENDING="$STATE_DIR/pending"      # marker: a trial boot is in flight
BACKUP="$STATE_DIR/slot-a-backup.img"
SAR_ADDR=0x4A326A0C               # reboot-reason string, read by stock u-boot

die() { echo "nq-kernel-ota: $*" >&2; exit 1; }
log() { echo "nq-kernel-ota: $*"; }

part_bytes() {
    _n=$(basename "$1")
    echo $(( $(cat "/sys/block/mmcblk0/$_n/size") * 512 ))
}

# --- the reboot reason, straight out of the SAR scratchpad -------------------
# Readable/writable because the kernel ships CONFIG_DEVMEM=y and does NOT set
# CONFIG_STRICT_DEVMEM. Kernel patch 0044 writes this on reboot; u-boot reads it.
sar() {
    python3 - "$1" "${2:-}" <<'PY'
import mmap, os, sys
ADDR = 0x4A326A0C
PAGE = 0x1000
base, off = ADDR & ~(PAGE - 1), ADDR & (PAGE - 1)
mode, value = sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else ""
flags = os.O_RDWR if mode == "write" else os.O_RDONLY
prot = (mmap.PROT_READ | mmap.PROT_WRITE) if mode == "write" else mmap.PROT_READ
fd = os.open("/dev/mem", flags | os.O_SYNC)
m = mmap.mmap(fd, PAGE, mmap.MAP_SHARED, prot, offset=base)
if mode == "read":
    print(m[off:off + 32].split(b"\x00")[0].decode(errors="replace"))
else:
    # stock clears 0x20 bytes then writes the reason; match it exactly
    m[off:off + 32] = b"\x00" * 32
    if value:
        b = value.encode()[:31]
        m[off:off + len(b)] = b
    m.flush()
PY
}

# --- pack an Android boot image, exactly like the host build does ------------
# The device's u-boot boots a header-v0 image whose "kernel" is zImage with the
# DTB appended (deviceinfo_append_dtb=true) and whose ramdisk is EMPTY -- the
# kernel has CONFIG_CMDLINE_FORCE, boots root=/dev/mmcblk0p13 directly, and
# u-boot ignores the ramdisk section on a partition boot. Same layout as
# make-bootimg.py on the host; `verify-self` proves it by rebuilding the RUNNING
# kernel's image and comparing it against slot A.
pack_bootimg() {
    python3 - "$1" "$2" "$3" "$4" <<'PACKEOF'
import hashlib, struct, sys
kern_p, dtb_p, out_p, cmdline = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
kernel = open(kern_p, "rb").read() + (open(dtb_p, "rb").read() if dtb_p != "-" else b"")
base, ps = 0x80000000, 2048
pad = lambda d: d + b"\x00" * ((ps - len(d) % ps) % ps)
hdr = struct.pack("<8s10I16s512s", b"ANDROID!",
                  len(kernel), base + 0x00008000,
                  0,           base + 0x01000000,
                  0,           base + 0x00f00000,
                  base + 0x00000100, ps, 0, 0,
                  b"", cmdline.encode().ljust(512, b"\x00"))
sha = hashlib.sha1()
for blob in (kernel, struct.pack("<I", len(kernel)),
             b"", struct.pack("<I", 0), b"", struct.pack("<I", 0)):
    sha.update(blob)
img = pad(hdr + sha.digest().ljust(32, b"\x00")) + pad(kernel)
if len(img) > 8 * 1024 * 1024:
    sys.exit("image is %d B -- the boot partition holds 8 MiB" % len(img))
open(out_p, "wb").write(img)
print("packed %s: %d B (kernel+dtb %d B)" % (out_p, len(img), len(kernel)))
PACKEOF
}

# CONFIG_CMDLINE belongs to the kernel being packed, so read it from that
# kernel's own config rather than assuming the running one's.
cmdline_from_config() {
    sed -n 's/^CONFIG_CMDLINE="\(.*\)"$/\1/p' "$1" | head -1
}

cmd_bootimg() {
    _k=${1:?usage: nq-kernel-ota bootimg <vmlinuz> <dtb|-> <out.img> [config]}
    _d=${2:?}; _o=${3:?}; _c=${4:-/boot/config}
    _cl=$(cmdline_from_config "$_c")
    [ -n "$_cl" ] || log "warning: no CONFIG_CMDLINE in $_c -- packing an empty cmdline"
    pack_bootimg "$_k" "$_d" "$_o" "$_cl"
}

# Prove the packer is right, using the only ground truth available: rebuild the
# image for the kernel that is CURRENTLY RUNNING and compare it with slot A.
cmd_verify_self() {
    _tmp=$(mktemp -d)
    _dtb=/boot/omap4-steelhead.dtb
    [ -f "$_dtb" ] || _dtb=/boot/dtbs/omap4-steelhead.dtb
    cmd_bootimg /boot/vmlinuz "$_dtb" "$_tmp/rebuilt.img" /boot/config >/dev/null || die "pack failed"
    _sz=$(stat -c %s "$_tmp/rebuilt.img")
    _a=$(md5sum < "$_tmp/rebuilt.img" | cut -d' ' -f1)
    _b=$(dd if="$BOOT_SLOT" bs=1 count="$_sz" 2>/dev/null | md5sum | cut -d' ' -f1)
    rm -rf "$_tmp"
    log "rebuilt   $_sz B  md5 $_a"
    log "slot A    (first $_sz B) md5 $_b"
    if [ "$_a" = "$_b" ]; then
        log "MATCH -- the on-device packer reproduces the booting image exactly"
    else
        die "MISMATCH -- do not stage anything until this is understood"
    fi
}

# --- stage straight out of a kernel apk -------------------------------------
# Deliberately does NOT `apk add` the package. Upgrading it would delete the OLD
# package's files, including the RUNNING kernel's /lib/modules -- which is the
# rollback path this whole design exists to protect. The apk is a payload
# source; the package database catches up in `promote`, once the new kernel is
# the one running. docs/2026-08-18-kernel-ota-phase2.md
cmd_stage_apk() {
    _apk=${1:?usage: nq-kernel-ota stage-apk <linux-google-steelhead-*.apk>}
    [ -f "$_apk" ] || die "no such apk: $_apk"
    _tmp=$(mktemp -d)

    log "unpacking $_apk"
    tar -xzf "$_apk" -C "$_tmp" 2>/dev/null || { rm -rf "$_tmp"; die "cannot unpack apk"; }
    _rel=$(cat "$_tmp"/usr/share/kernel/*/kernel.release 2>/dev/null)
    [ -n "$_rel" ] || { rm -rf "$_tmp"; die "apk has no kernel.release -- is this a kernel package?"; }
    log "kernel release in apk: $_rel"
    [ "$_rel" = "$(uname -r)" ] && { rm -rf "$_tmp"; die "that apk IS the running kernel ($_rel)"; }
    [ -d "$_tmp/lib/modules/$_rel" ] || { rm -rf "$_tmp"; die "apk has no /lib/modules/$_rel"; }

    # Installing into a NEW directory cannot disturb the running kernel's tree.
    [ -d "/lib/modules/$_rel" ] && { log "refreshing existing /lib/modules/$_rel"; rm -rf "/lib/modules/$_rel"; }
    cp -a "$_tmp/lib/modules/$_rel" /lib/modules/ || { rm -rf "$_tmp"; die "installing modules failed"; }
    depmod "$_rel" 2>/dev/null || log "warning: depmod failed for $_rel"
    log "modules installed: /lib/modules/$_rel (running kernel's $(uname -r) untouched)"

    _dtb="$_tmp/boot/omap4-steelhead.dtb"
    [ -f "$_dtb" ] || _dtb="$_tmp/boot/dtbs/omap4-steelhead.dtb"
    [ -f "$_tmp/boot/vmlinuz" ] || { rm -rf "$_tmp"; die "apk has no /boot/vmlinuz"; }
    [ -f "$_dtb" ] || { rm -rf "$_tmp"; die "apk has no omap4-steelhead.dtb"; }

    cmd_bootimg "$_tmp/boot/vmlinuz" "$_dtb" "$_tmp/boot.img" "$_tmp/boot/config" \
        || { rm -rf "$_tmp"; die "pack failed"; }
    # autopromote compares this against `uname -r` after the trial boot, so it can
    # tell "the new kernel is running" from "we fell back to slot A".
    NQ_KOTA_RELEASE="$_rel" cmd_stage "$_tmp/boot.img"
    rm -rf "$_tmp"
    log "staged kernel $_rel. Nothing has booted it yet -- run 'try' with the device in reach."
}

# --- what runs on the next boot, from the systemd unit -----------------------
# "It booted" is NOT the same as "it works". A kernel that comes up without
# cfg80211 boots perfectly and leaves the device unreachable — promoting that
# into slot A would lock us out of the only working kernel we have. So promotion
# waits for the box to be genuinely usable: our services up AND the network
# actually carrying traffic.
#
# The reason is disarmed FIRST, unconditionally: whatever else happens, the next
# reboot must go to slot A rather than back into the trial slot.
HEALTH_WAIT_S="${NQ_KOTA_HEALTH_WAIT_S:-180}"

health_ok() {
    [ "$(systemctl is-active nexusq-control)" = active ] || return 1
    [ "$(systemctl is-active nq-healthd)" = active ] || return 1
    # The failure that actually matters: no network means no way back in.
    _gw=$(ip route show default 2>/dev/null | awk '/default/ {print $3; exit}')
    [ -n "$_gw" ] || return 1
    ping -c1 -W2 "$_gw" >/dev/null 2>&1 || return 1
    return 0
}

cmd_autopromote() {
    [ -f "$PENDING" ] || exit 0            # nothing in flight — normal boot
    _want=$(awk '{print $4}' "$PENDING" 2>/dev/null)

    log "trial boot marker found; disarming the reboot reason first"
    sar write ""

    _now=$(uname -r)
    if [ -n "$_want" ] && [ "$_want" != "$_now" ]; then
        log "running $_now but the trial staged $_want — the trial slot did NOT boot."
        log "slot A is intact and still in charge. Leaving the marker for inspection;"
        log "clear it with 'nq-kernel-ota restore' or stage again."
        exit 0
    fi

    log "running the staged kernel ($_now); waiting up to ${HEALTH_WAIT_S}s for the device to prove it is usable"
    _t=0
    while [ "$_t" -lt "$HEALTH_WAIT_S" ]; do
        if health_ok; then
            log "healthy after ${_t}s — promoting"
            cmd_promote
            exit 0
        fi
        sleep 10; _t=$((_t + 10))
    done

    log "NOT healthy after ${HEALTH_WAIT_S}s — refusing to promote."
    log "slot A still holds the previous kernel; reboot to go back to it."
    exit 1
}

usage() {
    cat <<EOF
usage: nq-kernel-ota <command>

  stage <boot.img>   write the image to the TRIAL slot and verify it read-back
  try                arm the trial boot and reboot into it  (INTERACTIVE ONLY)
  promote            copy the trial slot into the boot slot and clear the marker
  status             what is where, and whether a trial is pending
  reason [value]     read (or set) the u-boot reboot reason in SAR RAM
  restore            put the boot slot back from the pre-update backup
EOF
}

cmd_status() {
    log "slot A (boot)  $BOOT_SLOT  $(part_bytes $BOOT_SLOT) B  md5 $(dd if=$BOOT_SLOT bs=1M count=8 2>/dev/null | md5sum | cut -d' ' -f1)"
    log "slot B (trial) $TRIAL_SLOT  $(part_bytes $TRIAL_SLOT) B  md5 $(dd if=$TRIAL_SLOT bs=1M count=8 2>/dev/null | md5sum | cut -d' ' -f1)"
    log "reboot reason  '$(sar read)'"
    if [ -f "$PENDING" ]; then
        log "PENDING trial boot: $(cat "$PENDING")"
    else
        log "no trial boot pending"
    fi
    [ -f "$BACKUP" ] && log "slot-A backup: $BACKUP ($(stat -c %s "$BACKUP") B)"
    return 0
}

cmd_stage() {
    _img=${1:?usage: nq-kernel-ota stage <boot.img>}
    [ -f "$_img" ] || die "no such image: $_img"
    _sz=$(stat -c %s "$_img")
    _cap=$(part_bytes "$TRIAL_SLOT")
    [ "$_sz" -le "$_cap" ] || die "image is $_sz B, trial slot holds $_cap B"
    # An Android boot header is the minimum sanity check: a truncated download
    # must never reach a partition.
    [ "$(dd if="$_img" bs=8 count=1 2>/dev/null)" = "ANDROID!" ] \
        || die "not an Android boot image (bad magic) — refusing to write"

    mkdir -p "$STATE_DIR"
    log "backing up slot A -> $BACKUP"
    dd if="$BOOT_SLOT" of="$BACKUP" bs=1M count=8 2>/dev/null || die "slot A backup failed"

    log "writing $_sz B to the trial slot"
    dd if="$_img" of="$TRIAL_SLOT" bs=1M conv=fsync 2>/dev/null || die "write failed"
    sync

    # Read back and compare. The 2026-06 flash corruption (sparse DONT_CARE over a
    # non-erased eMMC) is exactly the class of bug a read-back catches.
    _want=$(md5sum < "$_img" | cut -d' ' -f1)
    _got=$(dd if="$TRIAL_SLOT" bs=1 count="$_sz" 2>/dev/null | md5sum | cut -d' ' -f1)
    [ "$_want" = "$_got" ] || die "READ-BACK MISMATCH ($_want != $_got) — slot B is not what we wrote"
    log "read-back verified: $_got"

    printf '%s %s %s %s\n' "$(date -u +%FT%TZ)" "$_img" "$_want" "${NQ_KOTA_RELEASE:-}" > "$PENDING"
    log "staged. Next: 'nq-kernel-ota try' — and read what it prints first."
}

cmd_try() {
    [ -f "$PENDING" ] || die "nothing staged"
    cat <<EOF

  ⚠️  A TRIAL BOOT CANNOT BE UNDONE REMOTELY.

  Stock u-boot has no bootcount and does not fall back: if the staged kernel
  does not boot, this device STOPS at the bootloader and needs hands on it —
  cover the mute sensor at power-on to reach fastboot (USB), or leave it
  unplugged long enough for the always-on domain to drain.

  Do this only with the device in reach. Slot A is untouched either way.

EOF
    if [ "${NQ_KOTA_YES:-}" != "1" ]; then
        printf "  type YES to boot the trial kernel: "
        read _ans
        [ "$_ans" = "YES" ] || die "aborted"
    fi
    log "arming the trial boot"
    sar write recovery
    log "reason is now '$(sar read)' — rebooting"
    sync
    systemctl reboot --reboot-argument=recovery
}

cmd_promote() {
    [ -f "$PENDING" ] || die "nothing pending — promote is for a kernel that just proved it boots"
    log "promoting trial slot -> boot slot"
    dd if="$TRIAL_SLOT" of="$BOOT_SLOT" bs=1M conv=fsync 2>/dev/null || die "promote failed"
    sync
    _a=$(dd if="$BOOT_SLOT" bs=1M count=8 2>/dev/null | md5sum | cut -d' ' -f1)
    _b=$(dd if="$TRIAL_SLOT" bs=1M count=8 2>/dev/null | md5sum | cut -d' ' -f1)
    [ "$_a" = "$_b" ] || die "post-promote mismatch ($_a != $_b)"
    sar write ""              # never leave a recovery request armed
    rm -f "$PENDING"
    log "promoted and disarmed. Slot A md5 $_a"
}

cmd_restore() {
    [ -f "$BACKUP" ] || die "no backup at $BACKUP"
    log "restoring slot A from $BACKUP"
    dd if="$BACKUP" of="$BOOT_SLOT" bs=1M conv=fsync 2>/dev/null || die "restore failed"
    sync
    sar write ""
    rm -f "$PENDING"
    log "restored and disarmed."
}

case "${1:-}" in
    stage)       shift; cmd_stage "$@" ;;
    stage-apk)   shift; cmd_stage_apk "$@" ;;
    bootimg)     shift; cmd_bootimg "$@" ;;
    verify-self) cmd_verify_self ;;
    try)     cmd_try ;;
    promote)     cmd_promote ;;
    autopromote) cmd_autopromote ;;
    status)  cmd_status ;;
    restore) cmd_restore ;;
    reason)  if [ $# -ge 2 ]; then sar write "$2"; log "reason set to '$(sar read)'"; else sar read; fi ;;
    *)       usage; exit 1 ;;
esac
