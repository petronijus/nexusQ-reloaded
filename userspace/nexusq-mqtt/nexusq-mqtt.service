# userspace/nexusq-mqtt/nexusq-mqtt.service
# MQTT health telemetry publisher: nq-healthd samples + live extras →
# <prefix>/health/state + Home Assistant MQTT discovery. See the daemon header.
[Unit]
Description=Nexus Q MQTT health telemetry publisher
# NOT configured == NOT running: broker credentials are per-home secrets,
# never baked into the (public) image. Provision /etc/nexusq/mqtt.json (0600)
# and `systemctl restart nexusq-mqtt` (Condition* is only checked at start).
ConditionPathExists=/etc/nexusq/mqtt.json
# No After=/Wants= on other nexusq services or network-online: nothing here
# needs them. The reconnect loop rides out a not-yet-up network or broker, and
# says nothing about it for the first minute (LinkReport in the daemon). And
# network-online.target means nothing here: NetworkManager-wait-online.service
# is installed but nothing pulls it in, so the target is reached at once.

[Service]
ExecStart=/usr/bin/nexusq-mqtt
# 19 since 2026-08-16: with `ignore_nice_load=1` on the conservative
# governor (nexusq-cpufreq-tune drop-in) nice time is credited as idle, so
# this background daemon no longer drives the CPU frequency; the audio path
# is never nice'd and still ramps instantly.
# docs/2026-08-16-idle-700mhz-deep-analysis.md
Nice=19
IOSchedulingClass=idle
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
