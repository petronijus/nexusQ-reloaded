[Unit]
Description=Nexus Q BT WiFi-provisioning (setup mode)
# BT + NM must exist; none is a hard dep (setupd degrades gracefully).
# Started after nexusqd by nexusqd's own Before=, never an After=nexusqd.service
# here: next to an older nexusqd (After=multi-user.target, an OTA interrupted
# halfway) that is a boot ordering cycle and systemd DELETES a start job in it
# (it killed this unit in v1.9.0-rc1); tests/test_unit_order.py.
After=bluetooth.service NetworkManager.service
Wants=bluetooth.service

[Service]
Type=simple
ExecCondition=/usr/bin/nexusq-setup-needed
ExecStart=/usr/bin/nexusq-setupd
# One shot per trigger: it exits after finishSetup / inactivity; a crash
# restarts it (setup must survive daemon bugs while the user is mid-flow).
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
