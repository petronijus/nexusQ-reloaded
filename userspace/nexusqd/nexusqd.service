# userspace/nexusqd/nexusqd.service
[Unit]
Description=Nexus Q LED ring daemon
# Early, like any service, and BEFORE the peers that talk to its socket
# (Type=notify: after READY=1, so /run/nexusqd.sock exists), or nexusq-control's
# boot-time theme/scene restore races for it and logs "nexusqd send failed".
# NOT After=multi-user.target: with it, any ordering between nexusqd and a
# WantedBy=multi-user.target peer was a boot cycle (peer -> nexusqd ->
# multi-user.target -> peer) and systemd deleted the peer's start job
# (nexusq-setupd in v1.9.0-rc1).
# The ordering is stated HERE, not as After=nexusqd.service in the peers, so it
# is safe with any mix of package revisions: an OTA interrupted halfway can
# leave new peer units next to an older nexusqd that is still After=
# multi-user.target, and an After= in the peer would be that very cycle, able
# to delete nexusq-control's start job, the path that re-runs the update.
# tests/test_unit_order.py checks the tree and that mix.
# The AVR and its keys need no ordering: steelhead-avr probes from udev
# coldplug, frame writes simply fail until it has, and the keys node is looked
# for until it appears (keys.h).
After=systemd-modules-load.service
Before=nexusq-control.service nexusq-setupd.service nexusq-btagent.service
Requires=systemd-modules-load.service

[Service]
# Type=notify: nexusqd sends READY=1 once the AVR + control socket are up, and
# then pings WATCHDOG=1 from its render loop. If those pings stop for WatchdogSec
# (a *hang* — wedged AVR i2c, stuck poll, runaway effect — which Restart= alone
# can't see because the process never exits), systemd SIGABRTs and restarts it.
Type=notify
ExecStart=/usr/bin/nexusqd
WatchdogSec=15s
Restart=on-failure
RestartSec=2
# The audio-reactive visualizer tap spawns `arecord -D pulse` to capture PA's
# default SOURCE (which the companion bridge keeps pointed at the active sink's
# .monitor). nexusqd runs as root, but PulseAudio lives in the uid-10000 `user`
# session — these let a root PA client reach it (verified). No start ordering vs
# PA is needed: if PA is late, arecord just fails and audio.c's respawn-on-EOF
# loop (AUDIO_RESPAWN_S) retries until PA is up.
Environment=PULSE_SERVER=unix:/run/user/10000/pulse/native
Environment=PULSE_COOKIE=/home/user/.config/pulse/cookie

[Install]
WantedBy=multi-user.target
